//**agent TASK-225 [27.09.2026 16:01:00]
// Цепочка сегментов резолвится по метаданным: промежуточные сегменты обязаны
// быть ссылками (составной тип разыменовывается по каждому типу), последний
// проверяется на режим пароля и имя-секрет. Этап Z: контексты - канонические
// пути, элемент - дескриптор сессионного кэша; префикс канона отсекает
// неявное разыменование резолвера, сохраняя семантику НайтиВКоллекцияхМетаданных.
//Функция ПутьВедётКСекретуВМетаданных(МетаданныеОбъекта, Сегменты)
Функция ПутьВедётКСекретуВМетаданных(КонтекстПуть, Сегменты)

	ТекущиеПути = Новый Массив;
	ТекущиеПути.Добавить(КонтекстПуть);
	ИндексПоследнего = Сегменты.Количество() - 1;

	Для ИндексСегмента = 0 По ИндексПоследнего Цикл
		ИмяСегмента = Сегменты[ИндексСегмента];
		ЭтоПоследний = ИндексСегмента = ИндексПоследнего;
		СледующиеПути = Новый Массив;
		СекретНайден = Ложь;
		Для Каждого ПутьКонтекста Из ТекущиеПути Цикл
			Описание = ОписаниеПутиКэш(
				ПутьКонтекста + "." + ИмяСегмента);
			// Элемент - прямой член коллекций контекста: канон обязан
			// начинаться с пути контекста, иначе это неявное разыменование
			// резолвера или возврат объекта на системном поле.
			Если Не Описание.Существует
				Или Описание.СистемныйХвост
				Или ВРег(Лев(Описание.Канон, СтрДлина(ПутьКонтекста) + 1))
					<> ВРег(ПутьКонтекста + ".") Тогда
				Продолжить;
			КонецЕсли;
			Если ЭтоПоследний Тогда
				Если Описание.Секрет Тогда
					СекретНайден = Истина;
				КонецЕсли;
			Иначе
				Для Каждого ПутьТипа Из Описание.ЦелиСсылок Цикл
					СледующиеПути.Добавить(ПутьТипа);
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
		Если ЭтоПоследний Тогда
			Возврат СекретНайден;
		КонецЕсли;
		Если СледующиеПути.Количество() = 0 Тогда
			// Путь по метаданным не разыменовывается - секрет недоказуем.
			Возврат Ложь;
		КонецЕсли;
		ТекущиеПути = СледующиеПути;
	КонецЦикла;

	Возврат Ложь;

КонецФункции
