//++agent TASK-221 [23.09.2026 11:05:00]
//**agent TASK-222 [24.09.2026 13:40:00]
//Функция ПодготовитьLineage(Результат, КонтекстВызова, ПричиныДеградации)
Функция ПодготовитьLineage(Результат, КонтекстВызова)
//**agent TASK-222

	Схема = Свойство(Результат, "schema", Неопределено);
	Если ТипЗнч(Схема) <> Тип("Структура") Тогда
//**agent TASK-222
//		ПричиныДеградации.Добавить("schema_missing");
//**agent TASK-222
		Возврат Новый Структура;
	КонецЕсли;

	ТекстЗапроса = ЗначениеКонтекста(КонтекстВызова, "query", "");
	Если ПустаяСтрока(ТекстЗапроса) Тогда
//**agent TASK-222
//		ПричиныДеградации.Добавить("query_missing");
//**agent TASK-222
		Возврат Схема;
	КонецЕсли;

	ИмяФайла = ПолучитьИмяВременногоФайла("so");
	Попытка
		Обработки.mcp_ИнструментыROCTUP.ПолучитьМакет("QueryLineageAnalyzer").Записать(ИмяФайла);
		Если Не ПодключитьВнешнююКомпоненту(ИмяФайла, "Lineage", ТипВнешнейКомпоненты.Native) Тогда
			ВызватьИсключение "LINEAGE_NATIVE_UNAVAILABLE";
		КонецЕсли;
		Компонента = Новый("AddIn.Lineage.QueryLineageAnalyzer");
		СхемаJSON = Компонента.AnalyzeSources(ТекстЗапроса, ЗаписатьJSONСтрокой(Схема));
		ОбогащённаяСхема = ПрочитатьJSONСтрокой(СхемаJSON);
		Если ТипЗнч(ОбогащённаяСхема) = Тип("Соответствие") Тогда
			ОбогащённаяСхема = JSONЗначениеВСтруктуру(ОбогащённаяСхема);
		КонецЕсли;
		Если ТипЗнч(ОбогащённаяСхема) <> Тип("Структура") Тогда
			ВызватьИсключение "LINEAGE_INVALID_SCHEMA";
		КонецЕсли;
		Результат.Вставить("schema", ОбогащённаяСхема);
		Схема = ОбогащённаяСхема;
	Исключение
//**agent TASK-222
//		ПричиныДеградации.Добавить("lineage_analyzer_unavailable");
//**agent TASK-222
	КонецПопытки;
	УдалитьФайлы(ИмяФайла);

	Если Не ВсеКолонкиИмеютИсточники(Схема) Тогда
//**agent TASK-222
//		ПричиныДеградации.Добавить("lineage_incomplete");
//**agent TASK-222
	КонецЕсли;
	Возврат Схема;

КонецФункции

Функция СформироватьLineageEvidence(Схема)
	Результат = Новый Массив;
	Колонки = Свойство(Схема, "columns", Новый Массив);
	Если ТипЗнч(Колонки) <> Тип("Массив") Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого Колонка Из Колонки Цикл
		ИмяКолонки = Свойство(Колонка, "name", "");
		Источники = Свойство(Колонка, "sources", Новый Массив);
		Если ТипЗнч(Источники) <> Тип("Массив") Тогда
			Источники = Новый Массив;
		КонецЕсли;
		Для Каждого ПутьИсточника Из Источники Цикл
			ЭлементМетаданных = НайтиЭлементМетаданныхПоПути(ПутьИсточника);
			ТипыИсточника = Новый Массив;
			СекретИсточника = Ложь;
			Если ЭлементМетаданных <> Неопределено Тогда
				ТипыИсточника = ТипыЭлементаМетаданных(ЭлементМетаданных);
				СекретИсточника = РежимПароляЭлементаМетаданных(ЭлементМетаданных)
					Или ЭтоИмяСекрета(ЭлементМетаданных.Имя);
			КонецЕсли;
			Результат.Добавить(Новый Структура(
				"column, source_path, source_types, secret_cut",
				ИмяКолонки, ПутьИсточника, ТипыИсточника, СекретИсточника));
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ВсеКолонкиИмеютИсточники(Схема)
	Колонки = Свойство(Схема, "columns", Новый Массив);
	Если ТипЗнч(Колонки) <> Тип("Массив") Или Колонки.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого Колонка Из Колонки Цикл
		Источники = Свойство(Колонка, "sources", Новый Массив);
		Если ТипЗнч(Источники) <> Тип("Массив") Или Источники.Количество() = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

// Достоверность нужна для каждого публичного поля: иначе alias скрывает
// исходное имя и рекурсивный detector не может доказать безопасность значения.
Функция ПроверитьLineageРезультатаЗапроса(Результат, Схема)
	// Успешный адаптер execute_query выдаёт ровно success/data/schema.
	// Любое другое поле может быть запасной копией значений вне data.
	Если ТипЗнч(Результат) <> Тип("Структура")
		Или Не Результат.Свойство("success")
		Или Не Результат.Свойство("data")
		Или Не Результат.Свойство("schema")
		Или Результат.Количество() <> 3 Тогда
		Возврат Ложь;
	КонецЕсли;

	Данные = Свойство(Результат, "data", Неопределено);
	Если ТипЗнч(Данные) <> Тип("Массив") Тогда
		Возврат Ложь;
	КонецЕсли;
	Колонки = Свойство(Схема, "columns", Неопределено);
	Если ТипЗнч(Колонки) <> Тип("Массив") Или Колонки.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Данные.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;

	ИменаКолонок = Новый Соответствие;
	Для Каждого Колонка Из Колонки Цикл
		ИмяКолонки = Свойство(Колонка, "name", "");
		Источники = Свойство(Колонка, "sources", Неопределено);
		Если ТипЗнч(ИмяКолонки) <> Тип("Строка") Или ПустаяСтрока(ИмяКолонки)
			Или ТипЗнч(Источники) <> Тип("Массив") Или Источники.Количество() = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
		Для Каждого ПутьИсточника Из Источники Цикл
			Если ТипЗнч(ПутьИсточника) <> Тип("Строка")
				Или ПустаяСтрока(ПутьИсточника)
				Или НайтиЭлементМетаданныхПоПути(ПутьИсточника) = Неопределено Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЦикла;
		ИменаКолонок.Вставить(ИмяКолонки, Истина);
	КонецЦикла;

	Для Каждого СтрокаДанных Из Данные Цикл
		Если ТипЗнч(СтрокаДанных) <> Тип("Структура")
			И ТипЗнч(СтрокаДанных) <> Тип("Соответствие") Тогда
			Возврат Ложь;
		КонецЕсли;
		Для Каждого Пара Из СтрокаДанных Цикл
			Если ИменаКолонок.Получить(Пара.Ключ) <> Истина Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Истина;
КонецФункции
//--agent TASK-221

