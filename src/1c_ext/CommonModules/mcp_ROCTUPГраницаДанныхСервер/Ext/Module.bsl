// Временные таблицы, созданные ПОМЕСТИТЬ в этом же пакете:
// ВРег имени таблицы -> запрос выбора, который её заполняет.
Функция LineageКартаВременныхТаблиц(СхемаЗапроса)

	Результат = Новый Соответствие;
	Для Каждого ЗапросПакета Из СхемаЗапроса.ПакетЗапросов Цикл
		Если ТипЗнч(ЗапросПакета) = Тип("ЗапросВыбораСхемыЗапроса")
			И Не ПустаяСтрока(ЗапросПакета.ТаблицаДляПомещения) Тогда
			Результат.Вставить(
				ВРег(ЗапросПакета.ТаблицаДляПомещения), ЗапросПакета);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

