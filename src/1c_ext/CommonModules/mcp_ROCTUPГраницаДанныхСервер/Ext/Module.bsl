// Feed доступен только internal descriptor и выдаёт не более 1000 элементов и
// 1 МиБ за страницу, чтобы manager не держал неограниченный ответ в памяти.
Функция ПолучитьМетаданныеДляВнутреннегоFeed(Селектор, Курсор = Неопределено) Экспорт

	Если ТипЗнч(Селектор) <> Тип("Структура")
		Или Свойство(Селектор, "mode", "") <> "all" Тогда
		Возврат ОшибкаFeed("METADATA_SELECTOR_INVALID");
	КонецЕсли;

	РазмерСтраницы = БезопасныйРазмерСтраницы(Свойство(Селектор, "page_size", 1000));
	Смещение = ПрочитатьЧисловойКурсор(Курсор, "m:");
	Если Смещение < 0 Тогда
		Возврат ОшибкаFeed("CURSOR_INVALID");
	КонецЕсли;

	ВсеПоля = Новый Массив;
	СостояниеСбора = Новый Структура("Полно", Истина);
	ДобавитьПоляКоллекцииМетаданных(ВсеПоля, Метаданные.Справочники, СостояниеСбора);
	ДобавитьПоляКоллекцииМетаданных(ВсеПоля, Метаданные.Документы, СостояниеСбора);
	ДобавитьПоляКоллекцииМетаданных(ВсеПоля, Метаданные.РегистрыСведений, СостояниеСбора);
	ДобавитьПоляКоллекцииМетаданных(ВсеПоля, Метаданные.РегистрыНакопления, СостояниеСбора);
	ДобавитьПоляКоллекцииМетаданных(ВсеПоля, Метаданные.РегистрыБухгалтерии, СостояниеСбора);
	ДобавитьПоляКоллекцииМетаданных(ВсеПоля, Метаданные.РегистрыРасчета, СостояниеСбора);
	ДобавитьПоляКоллекцииМетаданных(ВсеПоля, Метаданные.ПланыСчетов, СостояниеСбора);
	ДобавитьПоляКоллекцииМетаданных(ВсеПоля, Метаданные.ПланыВидовХарактеристик, СостояниеСбора);
	ДобавитьПоляКоллекцииМетаданных(ВсеПоля, Метаданные.ПланыВидовРасчета, СостояниеСбора);
	ДобавитьПоляКоллекцииМетаданных(ВсеПоля, Метаданные.БизнесПроцессы, СостояниеСбора);
	ДобавитьПоляКоллекцииМетаданных(ВсеПоля, Метаданные.Задачи, СостояниеСбора);
	// Wire DTO содержит bool, поэтому unknown запрещает всю страницу, а не
	// превращается в false или незаметно пропущенное поле metadata cache.
	Если Не СостояниеСбора.Полно Тогда
		Возврат ОшибкаFeed("FEED_EVIDENCE_INCOMPLETE");
	КонецЕсли;

	Страница = Новый Массив;
	СледующееСмещение = Смещение;
	РазмерJSON = 0;
	Пока СледующееСмещение < ВсеПоля.Количество()
		И Страница.Количество() < РазмерСтраницы Цикл
		ОписаниеПоля = ВсеПоля[СледующееСмещение];
		РазмерЭлемента = СтрДлина(ЗаписатьJSONСтрокой(ОписаниеПоля)) * 4;
		Если РазмерЭлемента > 900000 Тогда
			Возврат ОшибкаFeed("FEED_ITEM_TOO_LARGE");
		КонецЕсли;
		Если Страница.Количество() > 0 И РазмерJSON + РазмерЭлемента > 900000 Тогда
			Прервать;
		КонецЕсли;
		Страница.Добавить(ОписаниеПоля);
		РазмерJSON = РазмерJSON + РазмерЭлемента;
		СледующееСмещение = СледующееСмещение + 1;
	КонецЦикла;

	ЕстьСледующаяСтраница = СледующееСмещение < ВсеПоля.Количество();
	СледующийКурсор = ?(ЕстьСледующаяСтраница, "m:" + Формат(СледующееСмещение, "ЧГ=0"), Неопределено);
//**agent TASK-222 [24.09.2026 13:40:00]
// manifest_digest был привязкой lease-протокола v2; страница v1 идёт по
// контракту {success, metadata, next_cursor, final_chunk} без digest-поля.
//	Результат = РезультатFeed(Страница, Новый Массив, СледующийКурсор, Не ЕстьСледующаяСтраница);
//	Результат.Вставить("manifest_digest", МанифестDigest);
//	Возврат Результат;
	Возврат РезультатFeed(Страница, Новый Массив, СледующийКурсор, Не ЕстьСледующаяСтраница);
//**agent TASK-222

КонецФункции

// Источник запроса разрешается через metadata API, поэтому произвольный текст
// selector не может стать идентификатором языка запросов.
Функция ПолучитьЗначенияСловаряДляВнутреннегоFeed(Селектор, Курсор = Неопределено) Экспорт

	Если ТипЗнч(Селектор) <> Тип("Структура") Тогда
		Возврат ОшибкаFeed("DICTIONARY_SELECTOR_INVALID");
	КонецЕсли;

	ПутьИсточника = Свойство(Селектор, "source_path", "");
	Если ПутьИсточника = "*" Тогда
		Возврат ОшибкаFeed("DICTIONARY_WILDCARD_ALLOWLIST_REQUIRED");
	КонецЕсли;
	Если ТипЗнч(ПутьИсточника) <> Тип("Строка")
		Или ПустаяСтрока(ПутьИсточника)
		Или СтрДлина(ПутьИсточника) > 500 Тогда
		Возврат ОшибкаFeed("DICTIONARY_SOURCE_INVALID");
	КонецЕсли;

	ОписаниеИсточника = ОписаниеБезопасногоИсточника(ПутьИсточника);
	Если ОписаниеИсточника = Неопределено Тогда
		Возврат ОшибкаFeed("DICTIONARY_SOURCE_NOT_ALLOWED");
	КонецЕсли;
	СостояниеРежимаПароля = СостояниеРежимаПароляМетаданных(ОписаниеИсточника.ЭлементМетаданных);
	Если СостояниеРежимаПароля = "true"
		Или ЭтоИмяСекрета(ОписаниеИсточника.ИмяПоля) Тогда
		Возврат ОшибкаFeed("DICTIONARY_SECRET_SOURCE_DENIED");
	КонецЕсли;
	// Нейтральное имя не доказывает отсутствие password flag при ошибке metadata API.
	Если СостояниеРежимаПароля <> "false" Тогда
		Возврат ОшибкаFeed("FEED_EVIDENCE_INCOMPLETE");
	КонецЕсли;
	Если Не ПолеИмеетСтроковыйТип(ОписаниеИсточника.ЭлементМетаданных) Тогда
		Возврат ОшибкаFeed("DICTIONARY_SOURCE_TYPE_UNSUPPORTED");
	КонецЕсли;
	ФильтрAST = Свойство(Селектор, "filter_ast", Неопределено);
	ОтборСловаря = ПодготовитьОтборСловаря(ФильтрAST, ОписаниеИсточника);
	Если Не ОтборСловаря.Успех Тогда
		Возврат ОшибкаFeed(ОтборСловаря.КодОшибки);
	КонецЕсли;

	ПоследнееЗначение = ПрочитатьСтроковыйКурсор(Курсор, "d:");
	Если ПоследнееЗначение = Неопределено Тогда
		Возврат ОшибкаFeed("CURSOR_INVALID");
	КонецЕсли;
	РазмерСтраницы = БезопасныйРазмерСтраницы(Свойство(Селектор, "page_size", 1000));
	Значения = ВыполнитьБезопасныйЗапросСловаря(
		ОписаниеИсточника, ПоследнееЗначение, РазмерСтраницы + 1, ОтборСловаря);

	Страница = Новый Массив;
	РазмерJSON = 0;
	Для Каждого ЗначениеСловаря Из Значения Цикл
		Если Страница.Количество() >= РазмерСтраницы Тогда
			Прервать;
		КонецЕсли;
		ЭлементСтраницы = Новый Структура("source_path, category, value",
			ОписаниеИсточника.КаноническийПуть, Свойство(Селектор, "category", ""), ЗначениеСловаря);
		РазмерЭлемента = СтрДлина(ЗаписатьJSONСтрокой(ЭлементСтраницы)) * 4;
		Если РазмерЭлемента > 900000 Тогда
			Возврат ОшибкаFeed("FEED_ITEM_TOO_LARGE");
		КонецЕсли;
		Если Страница.Количество() > 0 И РазмерJSON + РазмерЭлемента > 900000 Тогда
			Прервать;
		КонецЕсли;
		Страница.Добавить(ЭлементСтраницы);
		РазмерJSON = РазмерJSON + РазмерЭлемента;
	КонецЦикла;

	ЕстьСледующаяСтраница = Значения.Количество() > Страница.Количество();
	Если ЕстьСледующаяСтраница Тогда
		СледующийКурсор = "d:" + Строка(Страница[Страница.Количество() - 1].value);
	Иначе
		СледующийКурсор = Неопределено;
	КонецЕсли;
	Возврат РезультатFeed(Новый Массив, Страница, СледующийКурсор, Не ЕстьСледующаяСтраница);

КонецФункции

