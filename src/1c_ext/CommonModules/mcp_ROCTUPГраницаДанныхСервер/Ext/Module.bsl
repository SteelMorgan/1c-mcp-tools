//++agent TASK-225 [27.09.2026 17:10:00]
// Токенизирует текст выражения: возвращает пути полей (идентификаторы,
// включая неквалифицированные) и разыменования параметров вида &П.Поле.
// Содержимое ЗНАЧЕНИЕ(...) - путь метаданных, а не поле, и не сканируется.
// Реализация на регулярном выражении (этап Z): один native-проход вместо
// посимвольного сканера; позиции совпадений сохраняют исходную семантику
// (литералы, ЗНАЧЕНИЕ, взгляд вперёд на скобку вызова функции).
Функция ИзвлечьУпоминанияПолей(Текст)

	Упоминания = Новый Структура(
		"Пути, Разыменования", Новый Массив, Новый Массив);

	// Порядок альтернатив задаёт приоритет: литерал, параметр, число, путь,
	// любой одиночный символ (разделитель) - тот же порядок ветвлений,
	// что и у посимвольного сканера. Первый символ пути - буква или
	// подчёркивание ([^\W\d]: словесный символ без цифр), включая буквы
	// без регистра: их хвост обрабатывается ниже, как у сканера.
	Токены = СтрНайтиВсеПоРегулярномуВыражению(Текст,
		"""(?:[^""]|"""")*""|&[\w.]+|\d[\d.]*|[^\W\d][\w.]*|[\s\S]");
	КоличествоТокенов = Токены.Количество();
	Индекс = 0;
	Пока Индекс < КоличествоТокенов Цикл
		Токен = Токены[Индекс];
		Индекс = Индекс + 1;
		ЗначениеТокена = Токен.Значение;
		Символ = Лев(ЗначениеТокена, 1);
		Если Символ = """" Тогда
			Если СтрДлина(ЗначениеТокена) = 1 Тогда
				// Незакрытый литерал: сканер обрывается, как и раньше.
				Прервать;
			КонецЕсли;
		ИначеЕсли Символ = "&" Тогда
			ИмяПараметра = Сред(ЗначениеТокена, 2);
			Если Найти(ИмяПараметра, ".") > 0 Тогда
				ЧастиПути = СтрРазделить(ИмяПараметра, ".", Ложь);
				ИмяПараметра = ЧастиПути[0];
				ЧастиПути.Удалить(0);
				Упоминания.Разыменования.Добавить(Новый Структура(
					"Имя, Сегменты", ИмяПараметра, ЧастиПути));
			КонецЕсли;
		ИначеЕсли ЭтоБукваИлиПодчерк(Символ) Тогда
			// Цифра первым символом не достаётся этой ветке: альтернатива
			// \d[\d.]* в шаблоне стоит раньше и забирает числовые токены.
			Идентификатор = ЗначениеТокена;
			Позиция = Токен.НачальнаяПозиция + Токен.Длина;
			Если Найти(Идентификатор, ".") = 0
				И СледующийНепробельный(Текст, Позиция) = "(" Тогда
				// Вызов функции: имя пропускается, аргументы сканируются дальше.
				Если ВРег(Идентификатор) = "ЗНАЧЕНИЕ" Тогда
					ПозицияСкобки = ПозицияНепробельного(Текст, Позиция);
					КонецСкобки = ПарнаяСкобка(Текст, ПозицияСкобки);
					Если КонецСкобки > 0 Тогда
						// Всё, что внутри ЗНАЧЕНИЕ(...), - путь метаданных,
						// токены группы пропускаются по позициям.
						Пока Индекс < КоличествоТокенов
							И Токены[Индекс].НачальнаяПозиция <= КонецСкобки Цикл
							Индекс = Индекс + 1;
						КонецЦикла;
					КонецЕсли;
				КонецЕсли;
			ИначеЕсли Найти(Идентификатор, ".") > 0
				Или Не ЭтоКлючевоеСловоУпоминаний(ВРег(Идентификатор)) Тогда
				Упоминания.Пути.Добавить(Идентификатор);
			КонецЕсли;
		ИначеЕсли СтрДлина(ЗначениеТокена) > 1
			И Не ЭтоЦифра(Символ) Тогда
			// Токен пути, начинающийся с букв без регистра (ВРег = НРег):
			// посимвольный сканер пропускал их и читал хвост как
			// идентификатор. Ведущие символы пропускаются итеративно
			// (ревью Z, MAJOR-R1: рекурсия по хвосту давала глубину ~длине
			// токена и O(N^2) - риск переполнения стека на длинных
			// идентификаторах из некейсовых букв); проверки хвоста те же,
			// что у ветки идентификатора выше. Хвост, не ставший
			// идентификатором, упоминаний не даёт - fail-closed.
			ПозВТокене = 2;
			ДлинаТокена = СтрДлина(ЗначениеТокена);
			Пока ПозВТокене <= ДлинаТокена
				И Не ЭтоБукваИлиПодчерк(Сред(ЗначениеТокена, ПозВТокене, 1)) Цикл
				ПозВТокене = ПозВТокене + 1;
			КонецЦикла;
			Если ПозВТокене <= ДлинаТокена Тогда
				Хвост = Сред(ЗначениеТокена, ПозВТокене);
				Позиция = Токен.НачальнаяПозиция + Токен.Длина;
				Если Найти(Хвост, ".") = 0
					И СледующийНепробельный(Текст, Позиция) = "(" Тогда
					// Вызов функции с некейсовым префиксом: имя
					// пропускается (ЗНАЧЕНИЕ здесь невозможно - оно
					// кейсовое), аргументы сканируются дальше.
				ИначеЕсли Найти(Хвост, ".") > 0
					Или Не ЭтоКлючевоеСловоУпоминаний(ВРег(Хвост)) Тогда
					Упоминания.Пути.Добавить(Хвост);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Возврат Упоминания;

