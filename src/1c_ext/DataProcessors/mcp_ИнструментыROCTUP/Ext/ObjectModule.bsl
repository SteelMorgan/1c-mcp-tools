		Стр.Категория      = Запись.Категория;
	КонецЦикла;
	ТаблицаВрем.Сортировать("Длина Убыв");
	Результат = Новый Массив;
	Для Каждого Стр Из ТаблицаВрем Цикл
		Запись = Новый Структура;
		Запись.Вставить("ЗначениеОриг",   Стр.ЗначениеОриг);
		Запись.Вставить("ЗначениеНижний", Стр.ЗначениеНижний);
		Запись.Вставить("Категория",      Стр.Категория);
		Запись.Вставить("Длина",          Стр.Длина);
		Результат.Добавить(Запись);
	КонецЦикла;

	Возврат Новый Структура("Данные, Лог", Результат, Лог);

КонецФункции

Процедура ЗаполнитьСловарьАнонимизации(ДанныеСловаря)

	АнонимизаторИнициализировать();

	// Данные уже отсортированы сервером по убыванию длины
	СловарьАнонимизации = Новый Массив;
	БакетИндексСловаря  = Новый Соответствие;

	Для Каждого Запись Из ДанныеСловаря Цикл
		СловарьАнонимизации.Добавить(Запись);

		Если Запись.Длина >= 3 Тогда
			Бакет = Лев(Запись.ЗначениеНижний, 3);
			МассивЗаписей = БакетИндексСловаря.Получить(Бакет);
			Если МассивЗаписей = Неопределено Тогда
				МассивЗаписей = Новый Массив;
				БакетИндексСловаря.Вставить(Бакет, МассивЗаписей);
			КонецЕсли;
			МассивЗаписей.Добавить(Запись);
		КонецЕсли;
	КонецЦикла;

	СловарьПостроен = Истина;

КонецПроцедуры

Функция ЭтоБуквоЦифра(Символ)

	КодСим = КодСимвола(Символ);
	Если КодСим >= 48  И КодСим <= 57  Тогда Возврат Истина; КонецЕсли; // 0-9
	Если КодСим >= 65  И КодСим <= 90  Тогда Возврат Истина; КонецЕсли; // A-Z
	Если КодСим >= 97  И КодСим <= 122 Тогда Возврат Истина; КонецЕсли; // a-z
	Если КодСим >= 1040 И КодСим <= 1103 Тогда Возврат Истина; КонецЕсли; // А-я
	Если КодСим = 1025 Или КодСим = 1105 Тогда Возврат Истина; КонецЕсли; // Ё, ё
	Возврат Ложь;

КонецФункции

Функция ПрименитьСловарьКСтроке(Текст)

	АнонимизаторИнициализировать();

	Если НЕ СловарьПостроен Или СловарьАнонимизации.Количество() = 0 Тогда
		Возврат Текст;
	КонецЕсли;

	Длина = СтрДлина(Текст);
	Если Длина = 0 Тогда
		Возврат Текст;
	КонецЕсли;

	// Собираем диапазоны уже существующих токенов для защиты
	ДиапазоныТокенов = Новый Массив;
	ПоискПоз = 1;
	Пока ПоискПоз <= Длина Цикл
		ПозОткр = Найти(Сред(Текст, ПоискПоз), "[");
		Если ПозОткр = 0 Тогда Прервать; КонецЕсли;
		ПозОткр = ПоискПоз + ПозОткр - 1;
		ПозЗакр = Найти(Сред(Текст, ПозОткр), "]");
		Если ПозЗакр = 0 Тогда Прервать; КонецЕсли;
		ПозЗакр = ПозОткр + ПозЗакр - 1;
		Кандидат = Сред(Текст, ПозОткр, ПозЗакр - ПозОткр + 1);
		Если ЭтоВалидныйТокенФормат(Кандидат) Тогда
			ДиапазоныТокенов.Добавить(Новый Структура("Начало, Конец", ПозОткр, ПозЗакр));
		КонецЕсли;
		ПоискПоз = ПозЗакр + 1;
	КонецЦикла;

	ТекстНижний = НРег(Текст);

	// Формируем список замен
	Замены       = Новый Массив;
	Позиция      = 1;
	ИндексТокена = 0;

	Пока Позиция <= Длина Цикл

		// Проверка: внутри существующего токена?
		ВнутриТокена = Ложь;
		КонецТокена  = 0;
		Для Инд = ИндексТокена По ДиапазоныТокенов.ВГраница() Цикл
			Диапазон = ДиапазоныТокенов[Инд];
			Если Позиция >= Диапазон.Начало И Позиция <= Диапазон.Конец Тогда
				ВнутриТокена = Истина;
				КонецТокена  = Диапазон.Конец;
				ИндексТокена = Инд;
				Прервать;
			КонецЕсли;
			Если Позиция < Диапазон.Начало Тогда Прервать; КонецЕсли;
		КонецЦикла;

		Если ВнутриТокена Тогда
			Позиция = КонецТокена + 1;
			Продолжить;
		КонецЕсли;

		Если Позиция + 2 > Длина Тогда
			Прервать;
		КонецЕсли;

		Бакет    = Сред(ТекстНижний, Позиция, 3);
		Кандидаты = БакетИндексСловаря.Получить(Бакет);
		Если Кандидаты = Неопределено Тогда
			Позиция = Позиция + 1;
			Продолжить;
		КонецЕсли;

		НашлиЗамену = Ложь;
		Для Каждого Кандидат Из Кандидаты Цикл
			ДлинаКандидата = Кандидат.Длина;
			Если ДлинаКандидата < 3 Тогда Продолжить; КонецЕсли;
			Если Позиция + ДлинаКандидата - 1 > Длина Тогда Продолжить; КонецЕсли;
			Если Сред(ТекстНижний, Позиция, ДлинаКандидата) <> Кандидат.ЗначениеНижний Тогда
				Продолжить;
			КонецЕсли;

			ГраницаОК = Истина;
			Если Позиция > 1 Тогда
				Если ЭтоБуквоЦифра(Сред(Текст, Позиция - 1, 1)) Тогда
					ГраницаОК = Ложь;
				КонецЕсли;
			КонецЕсли;
			Если ГраницаОК И Позиция + ДлинаКандидата <= Длина Тогда
				Если ЭтоБуквоЦифра(Сред(Текст, Позиция + ДлинаКандидата, 1)) Тогда
					ГраницаОК = Ложь;
				КонецЕсли;
			КонецЕсли;
			Если НЕ ГраницаОК Тогда Продолжить; КонецЕсли;

			Токен   = АнонимизаторТокенизировать(Кандидат.ЗначениеОриг, Кандидат.Категория);
			Замены.Добавить(Новый Структура("Начало, Длина, Токен", Позиция, ДлинаКандидата, Токен));
			Позиция = Позиция + ДлинаКандидата;
			НашлиЗамену = Истина;
			Прервать;
		КонецЦикла;

		Если НЕ НашлиЗамену Тогда
			Позиция = Позиция + 1;
		КонецЕсли;

	КонецЦикла;

	Если Замены.Количество() = 0 Тогда
		Возврат Текст;
	КонецЕсли;

	РезультатТекст  = "";
	ТекущаяПозиция  = 1;
	Для Каждого Замена Из Замены Цикл
		Если Замена.Начало > ТекущаяПозиция Тогда
			РезультатТекст = РезультатТекст + Сред(Текст, ТекущаяПозиция, Замена.Начало - ТекущаяПозиция);
		КонецЕсли;
		РезультатТекст = РезультатТекст + Замена.Токен;
		ТекущаяПозиция = Замена.Начало + Замена.Длина;
	КонецЦикла;
	Если ТекущаяПозиция <= Длина Тогда
		РезультатТекст = РезультатТекст + Сред(Текст, ТекущаяПозиция);
	КонецЕсли;

	Возврат РезультатТекст;

КонецФункции

Функция АнонимизироватьЗначениеВстроенный(Значение, МассивSources, ПравилаАнонимизации)

	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат Значение;
	КонецЕсли;

	// Ищем явную категорию в правилах
	Категория = "";
	Для Каждого SourcePath Из МассивSources Цикл
		Правило = ПравилаАнонимизации.Получить(SourcePath);
		Если Правило = Неопределено Тогда Продолжить; КонецЕсли;
		КатегорияПравила = "";
		Попытка
			Правило.Свойство("token_category", КатегорияПравила);
		Исключение КонецПопытки;
		Если НЕ ПустаяСтрока(КатегорияПравила) Тогда
			Категория = КатегорияПравила;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	// Авто-определение если явная категория не задана
	Если ПустаяСтрока(Категория) Тогда
		НеSTR = "";
		Для Каждого SourcePath Из МассивSources Цикл
			АвтоКат = ОпределитьКатегориюТокена(SourcePath);
			Если АвтоКат <> "STR" Тогда
				НеSTR = АвтоКат;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Категория = ?(НЕ ПустаяСтрока(НеSTR), НеSTR, "STR");
	КонецЕсли;

	Возврат АнонимизаторТокенизировать(Значение, Категория);

КонецФункции

Процедура АнонимизироватьРезультатВстроенный(Результат, РегексКонтекст = Неопределено)

	Если Результат = Неопределено Тогда Возврат; КонецЕсли;

	РезультатУспех = Ложь;
	Если ТипЗнч(Результат) = Тип("Структура") Тогда
		Результат.Свойство("success", РезультатУспех);
	КонецЕсли;
	Если НЕ РезультатУспех Тогда Возврат; КонецЕсли;

	ПравилаАнонимизации = ПолучитьПравилаТочнойАнонимизацииИзХранилища();

	// Строим карту политик колонок из уже проставленных полей schema
	СоответствиеPolicy = Новый Соответствие;
	Схема = Неопределено;
	Если НЕ Результат.Свойство("schema", Схема)
		Или ТипЗнч(Схема) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	Колонки = Неопределено;
	Если НЕ Схема.Свойство("columns", Колонки)
		Или ТипЗнч(Колонки) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Колонка Из Колонки Цикл
		Если ТипЗнч(Колонка) <> Тип("Структура") Тогда Продолжить; КонецЕсли;
		ИмяКолонки = "";
		Если НЕ Колонка.Свойство("name", ИмяКолонки) Тогда Продолжить; КонецЕсли;
		Режим = "default";
		Колонка.Свойство("anonymization_mode", Режим);
		РежимСсылки = "default";
		Колонка.Свойство("reference_presentation_mode", РежимСсылки);
		Sources = ПолучитьМассивСтрокИзСвойства(Колонка, "sources");
		СоответствиеPolicy.Вставить(ИмяКолонки,
			Новый Структура("mode, ref_mode, sources", Режим, РежимСсылки, Sources));
	КонецЦикла;

	// Обходим строки данных
	Данные = Неопределено;
	Если НЕ Результат.Свойство("data", Данные)
		Или ТипЗнч(Данные) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Строка Из Данные Цикл
		Если ТипЗнч(Строка) <> Тип("Соответствие")
			И ТипЗнч(Строка) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого PolicyЭлт Из СоответствиеPolicy Цикл
			ИмяКолонки = PolicyЭлт.Ключ;
			Policy      = PolicyЭлт.Значение;

			ЗначениеКолонки = Неопределено;
			Если ТипЗнч(Строка) = Тип("Структура") Тогда
				Если НЕ Строка.Свойство(ИмяКолонки, ЗначениеКолонки) Тогда Продолжить; КонецЕсли;
			Иначе
				ЗначениеКолонки = Строка[ИмяКолонки];
			КонецЕсли;
			Если ЗначениеКолонки = Неопределено Тогда Продолжить; КонецЕсли;

			Если ТипЗнч(ЗначениеКолонки) = Тип("Структура")
				И ЗначениеКолонки.Свойство("Представление") Тогда
				// Объектное значение — анонимизируем только Представление
				// Перечисления не анонимизируются никогда (в т.ч. при смешанном типе колонки)
				// Планы счетов по умолчанию не анонимизируются, если нет явного force_anonymize
				ТипОбъектаЗначения = "";
				ЗначениеКолонки.Свойство("ТипОбъекта", ТипОбъектаЗначения);
				Если Найти(ТипОбъектаЗначения, "ПеречислениеСсылка.") = 1 Тогда
					Продолжить;
				КонецЕсли;
				Если Найти(ТипОбъектаЗначения, "ПланСчетовСсылка.") = 1
					И Policy.mode <> "force_anonymize"
					И Policy.ref_mode <> "force_anonymize" Тогда
					Продолжить;
				КонецЕсли;
				Если Policy.mode = "force_keep" Тогда
					Продолжить;
				ИначеЕсли Policy.mode = "force_anonymize" Или Policy.ref_mode = "force_anonymize" Тогда
					ЗначениеКолонки.Вставить("Представление",
						АнонимизироватьЗначениеВстроенный(ЗначениеКолонки.Представление, Policy.sources, ПравилаАнонимизации));
				ИначеЕсли Policy.ref_mode = "force_keep" Тогда
					Продолжить;
				Иначе
					ЗначениеКолонки.Вставить("Представление",
						ПрименитьСловарьКСтроке(ЗначениеКолонки.Представление));
				КонецЕсли;

			ИначеЕсли ТипЗнч(ЗначениеКолонки) = Тип("Строка") Тогда
				// Строковое значение
				НовоеЗначение = Неопределено;
				Если Policy.mode = "force_anonymize" Тогда
					НовоеЗначение = АнонимизироватьЗначениеВстроенный(ЗначениеКолонки, Policy.sources, ПравилаАнонимизации);
				ИначеЕсли Policy.mode = "default" Тогда
					НовоеЗначение = ПрименитьСловарьКСтроке(ЗначениеКолонки);
				КонецЕсли;
				Если НовоеЗначение <> Неопределено Тогда
					Если ТипЗнч(Строка) = Тип("Структура") Тогда
						Строка.Вставить(ИмяКолонки, НовоеЗначение);
					Иначе
						Строка[ИмяКолонки] = НовоеЗначение;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;

		КонецЦикла;
	КонецЦикла;

	// Фаза regex: собрать тексты после словарной анонимизации
	Если РегексКонтекст <> Неопределено Тогда
		СобратьТекстыДляRegex(Результат, РегексКонтекст);
	КонецЕсли;

КонецПроцедуры

Процедура АнонимизироватьРезультатFindReferencesВстроенный(Результат, РегексКонтекст = Неопределено)

	Если Результат = Неопределено Тогда Возврат; КонецЕсли;

	РезультатУспех = Ложь;
	Если ТипЗнч(Результат) = Тип("Структура") Тогда
		Результат.Свойство("success", РезультатУспех);
	КонецЕсли;
	Если НЕ РезультатУспех Тогда Возврат; КонецЕсли;

	Данные = Неопределено;
	Если НЕ Результат.Свойство("data", Данные)
		Или ТипЗнч(Данные) <> Тип("Структура") Тогда Возврат; КонецЕсли;

	Хиты = Неопределено;
	Если НЕ Данные.Свойство("hits", Хиты)
		Или ТипЗнч(Хиты) <> Тип("Массив") Тогда Возврат; КонецЕсли;

	НастройкиАнонимизации = ПолучитьНастройкиТочнойАнонимизацииИзХранилища();
	ПравилаАнонимизации = НастройкиАнонимизации.Правила;
	АгрессивныйРежим = НастройкиАнонимизации.АгрессивныйРежим;

	Для Каждого Хит Из Хиты Цикл
		Если ТипЗнч(Хит) <> Тип("Структура") Тогда Продолжить; КонецЕсли;

		РежимFound = "default";
		SourcesFoundInObject = Новый Массив;

		// 1. found_in_object.Представление (документы/справочники)
		НайденВОбъекте = Неопределено;
		Если Хит.Свойство("found_in_object", НайденВОбъекте)
			И ТипЗнч(НайденВОбъекте) = Тип("Структура") Тогда
			РезОбъекта = АнонимизироватьПредставлениеObjectRef(НайденВОбъекте, ПравилаАнонимизации, АгрессивныйРежим);
			РежимFound = РезОбъекта.Режим;
			SourcesFoundInObject = РезОбъекта.Sources;
		КонецЕсли;

		// 2. record_key.*.Представление (objectRef-измерения регистров)
		ВсеИзмеренияЗащищены = Истина;
		ЕстьСсылочноеИзмерение = Ложь;
		ЕстьИзмерениеForceAnonymize = Ложь;
		КлючЗаписи = Неопределено;
		Если Хит.Свойство("record_key", КлючЗаписи)
			И ТипЗнч(КлючЗаписи) = Тип("Структура") Тогда
			Для Каждого КВП Из КлючЗаписи Цикл
				Если ТипЗнч(КВП.Значение) = Тип("Структура") Тогда
					РезКлюча = АнонимизироватьПредставлениеObjectRef(КВП.Значение, ПравилаАнонимизации, АгрессивныйРежим);
					ЕстьСсылочноеИзмерение = Истина;
					Если РезКлюча.Режим = "force_anonymize" Тогда
						ЕстьИзмерениеForceAnonymize = Истина;
					КонецЕсли;
					Если РезКлюча.Режим <> "force_keep" Тогда
						ВсеИзмеренияЗащищены = Ложь;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		ВсеИзмеренияЗащищены = ВсеИзмеренияЗащищены И ЕстьСсылочноеИзмерение;

		// 3. note
		Примечание = Неопределено;
		Если Хит.Свойство("note", Примечание)
			И ТипЗнч(Примечание) = Тип("Строка")
			И НЕ ПустаяСтрока(Примечание) Тогда
			Если НайденВОбъекте <> Неопределено Тогда
				// Документ/справочник: note следует режиму found_in_object
				Если РежимFound = "force_anonymize" Тогда
					Хит.Вставить("note", АнонимизироватьЗначениеВстроенный(Примечание, SourcesFoundInObject, ПравилаАнонимизации));
				ИначеЕсли РежимFound <> "force_keep" Тогда
					Хит.Вставить("note", ПрименитьСловарьКСтроке(Примечание));
				Иначе
				КонецЕсли;
			ИначеЕсли НЕ ВсеИзмеренияЗащищены Тогда
				// Регистр: обрабатываем если хотя бы одно измерение не force_keep
				Если АгрессивныйРежим Или ЕстьИзмерениеForceAnonymize Тогда
					Хит.Вставить("note", АнонимизаторТокенизировать(Примечание, "STR"));
				Иначе
					Хит.Вставить("note", ПрименитьСловарьКСтроке(Примечание));
				КонецЕсли;
			Иначе
			КонецЕсли;
		КонецЕсли;

	КонецЦикла;

	// Phase 3: сбор текстов для regex-токенизации
	Если РегексКонтекст <> Неопределено Тогда
		СобратьТекстыДляRegexFindReferences(Результат, РегексКонтекст, ПравилаАнонимизации, АгрессивныйРежим);
	КонецЕсли;

КонецПроцедуры

Функция АнонимизироватьПредставлениеObjectRef(ОписаниеОбъекта, ПравилаАнонимизации, АгрессивныйРежим)

	ПустойРезультат = Новый Структура("Режим, Sources", "default", Новый Массив);
	ЗащищённыйРезультат = Новый Структура("Режим, Sources", "force_keep", Новый Массив);

	ТипОбъекта = "";
	ОписаниеОбъекта.Свойство("ТипОбъекта", ТипОбъекта);
	Если Найти(ТипОбъекта, "ПеречислениеСсылка.") = 1 Тогда Возврат ЗащищённыйРезультат; КонецЕсли;

	Представление = Неопределено;
	Если НЕ ОписаниеОбъекта.Свойство("Представление", Представление) Тогда Возврат ПустойРезультат; КонецЕсли;
	Если ТипЗнч(Представление) <> Тип("Строка") Или ПустаяСтрока(Представление) Тогда Возврат ПустойРезультат; КонецЕсли;

	Режим = ВычислитьРежимObjectRef(ТипОбъекта, ПравилаАнонимизации, АгрессивныйРежим);

	Если Режим = "force_keep" Тогда
		Возврат Новый Структура("Режим, Sources", Режим, Новый Массив);
	ИначеЕсли Режим = "force_anonymize" Тогда
		ПутьНаименования = ПолучитьПутьНаименованияПоТипуОбъекта(ТипОбъекта);
		МассивSources = Новый Массив;
		МассивSources.Добавить(?(НЕ ПустаяСтрока(ПутьНаименования), ПутьНаименования, ТипОбъекта));
		ОписаниеОбъекта.Вставить("Представление",
			АнонимизироватьЗначениеВстроенный(Представление, МассивSources, ПравилаАнонимизации));
		Возврат Новый Структура("Режим, Sources", Режим, МассивSources);
	КонецЕсли;

	// Phase 2: нет правила, не агрессивный — словарная замена
	ОписаниеОбъекта.Вставить("Представление", ПрименитьСловарьКСтроке(Представление));
	Возврат Новый Структура("Режим, Sources", "default", Новый Массив);

КонецФункции

Процедура СобратьТекстыДляRegexFindReferences(Результат, РегексКонтекст, ПравилаАнонимизации, АгрессивныйРежим)

	// Получить включённые regex-правила
	ВсеПравила = ПолучитьRegexПравилаИзХранилища();
	ВключённыеПравила = Новый Массив;
	Для Каждого Правило Из ВсеПравила Цикл
		Если ТипЗнч(Правило) = Тип("Структура") Тогда
			Включено = Истина;
			Попытка Правило.Свойство("enabled", Включено); Исключение КонецПопытки;
			Если Включено Тогда
				ВключённыеПравила.Добавить(Новый Структура("pattern, category", Правило.pattern, Правило.category));
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Если ВключённыеПравила.Количество() = 0 Тогда Возврат; КонецЕсли;

	Данные = Неопределено;
	Если НЕ Результат.Свойство("data", Данные)
		Или ТипЗнч(Данные) <> Тип("Структура") Тогда Возврат; КонецЕсли;

	Хиты = Неопределено;
	Если НЕ Данные.Свойство("hits", Хиты)
		Или ТипЗнч(Хиты) <> Тип("Массив") Тогда Возврат; КонецЕсли;

	ТекстыМассив = Новый Массив;
	МаппингИндексов = Новый Массив;

	Для ХитИндекс = 0 По Хиты.Количество() - 1 Цикл
		Хит = Хиты[ХитИндекс];
		Если ТипЗнч(Хит) <> Тип("Структура") Тогда Продолжить; КонецЕсли;

		// found_in_object.Представление
		НайденВОбъектеN = Неопределено;
		РежимFoundN = "default";
		Если Хит.Свойство("found_in_object", НайденВОбъектеN)
			И ТипЗнч(НайденВОбъектеN) = Тип("Структура") Тогда
			ТипОбъекта = "";
			НайденВОбъектеN.Свойство("ТипОбъекта", ТипОбъекта);
			РежимFoundN = ВычислитьРежимObjectRef(ТипОбъекта, ПравилаАнонимизации, АгрессивныйРежим);
			Если РежимFoundN <> "force_keep" Тогда
				Представление = Неопределено;
				Если НайденВОбъектеN.Свойство("Представление", Представление)
					И ТипЗнч(Представление) = Тип("Строка")
					И НЕ ПустаяСтрока(Представление) Тогда
					ТекстыМассив.Добавить(Представление);
					МаппингИндексов.Добавить(Новый Структура("ХитИндекс, Вид", ХитИндекс, "found_in_object"));
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;

		// record_key.*.Представление
		ВсеИзмеренияЗащищеныN = Истина;
		ЕстьСсылочноеИзмерениеN = Ложь;
		ЕстьИзмерениеForceAnonymizeN = Ложь;
		КлючЗаписи = Неопределено;
		Если Хит.Свойство("record_key", КлючЗаписи)
			И ТипЗнч(КлючЗаписи) = Тип("Структура") Тогда
			Для Каждого КВП Из КлючЗаписи Цикл
				Если ТипЗнч(КВП.Значение) <> Тип("Структура") Тогда Продолжить; КонецЕсли;
				ТипОбъектаПоля = "";
				КВП.Значение.Свойство("ТипОбъекта", ТипОбъектаПоля);
				РежимПоля = ВычислитьРежимObjectRef(ТипОбъектаПоля, ПравилаАнонимизации, АгрессивныйРежим);
				ЕстьСсылочноеИзмерениеN = Истина;
				Если РежимПоля = "force_anonymize" Тогда
					ЕстьИзмерениеForceAnonymizeN = Истина;
				КонецЕсли;
				Если РежимПоля = "force_keep" Тогда Продолжить; КонецЕсли;
				ВсеИзмеренияЗащищеныN = Ложь;
				ПредставлениеПоля = Неопределено;
				Если КВП.Значение.Свойство("Представление", ПредставлениеПоля)
					И ТипЗнч(ПредставлениеПоля) = Тип("Строка")
					И НЕ ПустаяСтрока(ПредставлениеПоля) Тогда
					ТекстыМассив.Добавить(ПредставлениеПоля);
					МаппингИндексов.Добавить(Новый Структура("ХитИндекс, Вид, ИмяПоля",
						ХитИндекс, "record_key", КВП.Ключ));
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		ВсеИзмеренияЗащищеныN = ВсеИзмеренияЗащищеныN И ЕстьСсылочноеИзмерениеN;

		// note
		Примечание = Неопределено;
		ДобавитьNote = Ложь;
		Если Хит.Свойство("note", Примечание)
			И ТипЗнч(Примечание) = Тип("Строка")
			И НЕ ПустаяСтрока(Примечание) Тогда
			Если НайденВОбъектеN <> Неопределено Тогда
				ДобавитьNote = (РежимFoundN <> "force_keep");
			Иначе
				ДобавитьNote = НЕ ВсеИзмеренияЗащищеныN И НЕ ЕстьИзмерениеForceAnonymizeN;
			КонецЕсли;
		КонецЕсли;
		Если ДобавитьNote Тогда
			ТекстыМассив.Добавить(Примечание);
			МаппингИндексов.Добавить(Новый Структура("ХитИндекс, Вид", ХитИндекс, "note"));
		КонецЕсли;

	КонецЦикла;

	Если ТекстыМассив.Количество() = 0 Тогда Возврат; КонецЕсли;

	РегексКонтекст.Вставить("ВключённыеПравилаJSON", ЗаписатьJSON2(ВключённыеПравила));
	РегексКонтекст.Вставить("ТекстыJSON",            ЗаписатьJSON2(ТекстыМассив));
	РегексКонтекст.Вставить("МаппингИндексов",       МаппингИндексов);
	РегексКонтекст.Вставить("ЕстьТекстыДляRegex",    Истина);

КонецПроцедуры

Процедура ПрименитьRegexТокеныFindReferences(РегексКонтекст, СовпаденияJSON)

	Если ПустаяСтрока(СовпаденияJSON) Тогда Возврат; КонецЕсли;

	МаппингИндексов = Неопределено;
	Если НЕ РегексКонтекст.Свойство("МаппингИндексов", МаппингИндексов)
		Или МаппингИндексов = Неопределено Тогда Возврат; КонецЕсли;

	Результат = Неопределено;
	Если НЕ РегексКонтекст.Свойство("Результат", Результат)
		Или ТипЗнч(Результат) <> Тип("Структура") Тогда Возврат; КонецЕсли;

	Данные = Неопределено;
	Если НЕ Результат.Свойство("data", Данные)
		Или ТипЗнч(Данные) <> Тип("Структура") Тогда Возврат; КонецЕсли;

	Хиты = Неопределено;
	Если НЕ Данные.Свойство("hits", Хиты)
		Или ТипЗнч(Хиты) <> Тип("Массив") Тогда Возврат; КонецЕсли;

	Попытка
		Совпадения = ПрочитатьJSON2(СовпаденияJSON);
	Исключение
		Возврат;
	КонецПопытки;

	Если ТипЗнч(Совпадения) <> Тип("Массив") Тогда Возврат; КонецЕсли;

	// РезСовпадений — массив по тем же индексам, что и МаппингИндексов / ТекстыМассив.
	// Каждый элемент — массив совпадений {category, match, start, length}, отсортированных по start DESC.
	РезСовпадений = Совпадения;
	Для ТекстИндекс = 0 По МаппингИндексов.Количество() - 1 Цикл

		Если ТекстИндекс >= РезСовпадений.Количество() Тогда Прервать; КонецЕсли;

		ЭлСовпадений = РезСовпадений[ТекстИндекс];
		Если ТипЗнч(ЭлСовпадений) <> Тип("Массив") Или ЭлСовпадений.Количество() = 0 Тогда Продолжить; КонецЕсли;

		МаппингЭлт = МаппингИндексов[ТекстИндекс];
		Если ТипЗнч(МаппингЭлт) <> Тип("Структура") Тогда Продолжить; КонецЕсли;

		ХитИндекс = 0;
		МаппингЭлт.Свойство("ХитИндекс", ХитИндекс);
		Вид = "";
		МаппингЭлт.Свойство("Вид", Вид);

		Если ХитИндекс >= Хиты.Количество() Тогда Продолжить; КонецЕсли;
		Хит = Хиты[ХитИндекс];
		Если ТипЗнч(Хит) <> Тип("Структура") Тогда Продолжить; КонецЕсли;

		// Прочитать текущий текст из хита, сохранить ссылку для обратной записи
		ТекущийТекст    = "";
		СтруктураЗаписи = Неопределено; // структура, в которую пишем "Представление"
		ПрямаяЗапись    = Ложь;         // для "note" — пишем прямо в Хит

		Если Вид = "found_in_object" Тогда
			НайденВОбъекте = Неопределено;
			Если Хит.Свойство("found_in_object", НайденВОбъекте)
				И ТипЗнч(НайденВОбъекте) = Тип("Структура") Тогда
				НайденВОбъекте.Свойство("Представление", ТекущийТекст);
				СтруктураЗаписи = НайденВОбъекте;
			КонецЕсли;

		ИначеЕсли Вид = "record_key" Тогда
			ИмяПоля = "";
			МаппингЭлт.Свойство("ИмяПоля", ИмяПоля);
			КлючЗаписи = Неопределено;
			Если Хит.Свойство("record_key", КлючЗаписи)
				И ТипЗнч(КлючЗаписи) = Тип("Структура") Тогда
				ЗначениеПоля = Неопределено;
				Если КлючЗаписи.Свойство(ИмяПоля, ЗначениеПоля)
					И ТипЗнч(ЗначениеПоля) = Тип("Структура") Тогда
					ЗначениеПоля.Свойство("Представление", ТекущийТекст);
					СтруктураЗаписи = ЗначениеПоля;
				КонецЕсли;
			КонецЕсли;

		ИначеЕсли Вид = "note" Тогда
			Хит.Свойство("note", ТекущийТекст);
			ПрямаяЗапись = Истина;

		КонецЕсли;

		Если ТипЗнч(ТекущийТекст) <> Тип("Строка") Или ПустаяСтрока(ТекущийТекст) Тогда Продолжить; КонецЕсли;

		// Применить совпадения справа налево (отсортированы DESC по start)
		НовыйТекст = ТекущийТекст;
		Для Каждого С Из ЭлСовпадений Цикл
			Категория = "";
			МатчТекст = "";
			Начало    = 0;
			Длина     = 0;
			Если ТипЗнч(С) = Тип("Структура") Тогда
				С.Свойство("category", Категория);
				С.Свойство("match",    МатчТекст);
				С.Свойство("start",    Начало);
				С.Свойство("length",   Длина);
			ИначеЕсли ТипЗнч(С) = Тип("Соответствие") Тогда
				Категория = С["category"];
				МатчТекст = С["match"];
				Начало    = С["start"];
				Длина     = С["length"];
			КонецЕсли;
			Если МатчТекст = Неопределено Тогда МатчТекст = ""; КонецЕсли;
			Если Начало    = Неопределено Тогда Начало    = 0;  КонецЕсли;
			Если Длина     = Неопределено Тогда Длина     = 0;  КонецЕсли;
			Если Категория = Неопределено Тогда Категория = ""; КонецЕсли;
			Если ПустаяСтрока(МатчТекст) Или Длина <= 0 Тогда Продолжить; КонецЕсли;
			Токен = АнонимизаторТокенизировать(МатчТекст, Категория);
			Если Начало >= 0 И (Начало + Длина) <= СтрДлина(НовыйТекст) Тогда
				НовыйТекст = Лев(НовыйТекст, Начало) + Токен + Сред(НовыйТекст, Начало + Длина + 1);
			КонецЕсли;
		КонецЦикла;

		// Записать результат обратно
		Если ПрямаяЗапись Тогда
			Хит.Вставить("note", НовыйТекст);
		ИначеЕсли СтруктураЗаписи <> Неопределено Тогда
			СтруктураЗаписи.Вставить("Представление", НовыйТекст);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

Процедура АнонимизироватьРезультатGetAccessRights(Результат)

	Если Результат = Неопределено Тогда Возврат; КонецЕсли;
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда Возврат; КонецЕсли;
	Если НЕ Результат.Свойство("success") Или НЕ Результат.success Тогда Возврат; КонецЕсли;

	Данные = Неопределено;
	Если НЕ Результат.Свойство("data", Данные) Тогда Возврат; КонецЕсли;
	Если ТипЗнч(Данные) <> Тип("Структура") Тогда Возврат; КонецЕсли;

	ДанныеПользователя = Неопределено;
	Если НЕ Данные.Свойство("user", ДанныеПользователя) Тогда Возврат; КонецЕсли;
	Если ТипЗнч(ДанныеПользователя) <> Тип("Структура") Тогда Возврат; КонецЕсли;

	// name → PER-токен
	ИмяПольз = "";
	Если ДанныеПользователя.Свойство("name", ИмяПольз)
		И ТипЗнч(ИмяПольз) = Тип("Строка")
		И НЕ ПустаяСтрока(ИмяПольз) Тогда
		ДанныеПользователя.Вставить("name", АнонимизаторТокенизировать(ИмяПольз, "PER"));
	КонецЕсли;

	// full_name → PER-токен (поле опциональное)
	ПолноеИмя = "";
	Если ДанныеПользователя.Свойство("full_name", ПолноеИмя)
		И ТипЗнч(ПолноеИмя) = Тип("Строка")
		И НЕ ПустаяСтрока(ПолноеИмя) Тогда
		ДанныеПользователя.Вставить("full_name", АнонимизаторТокенизировать(ПолноеИмя, "PER"));
	КонецЕсли;

КонецПроцедуры

Процедура АнонимизироватьОбъектВстроенный(Результат, РегексКонтекст = Неопределено)

	Если Результат = Неопределено Тогда Возврат; КонецЕсли;
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда Возврат; КонецЕсли;

	РезультатУспех = Ложь;
	Результат.Свойство("success", РезультатУспех);
	Если НЕ РезультатУспех Тогда Возврат; КонецЕсли;

	Данные = Неопределено;
	Если НЕ Результат.Свойство("data", Данные) Или ТипЗнч(Данные) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;

	// — BLIND MODE —
	ЕстьСхема = Результат.Свойство("schema") И НЕ Результат.Свойство("_blind_anonymization");
	Если НЕ ЕстьСхема Тогда
		// Технические ключи, которые нельзя трогать
		СлужебныеКлючи = Новый Соответствие;
		СлужебныеКлючи.Вставить("_type",               Истина);
		СлужебныеКлючи.Вставить("_objectRef",          Истина);
		СлужебныеКлючи.Вставить("ТипОбъекта",          Истина);
		СлужебныеКлючи.Вставить("УникальныйИдентификатор", Истина);

		Для Каждого КВП Из Данные Цикл
			Если СлужебныеКлючи[КВП.Ключ] = Истина Тогда Продолжить; КонецЕсли;
			Значение = КВП.Значение;
			Если ТипЗнч(Значение) = Тип("Строка") И Значение <> "" Тогда
				Данные.Вставить(КВП.Ключ, АнонимизаторТокенизировать(Значение, "STR"));
			ИначеЕсли ТипЗнч(Значение) = Тип("Структура") Тогда
				// _objectRef или другая структура — токенизируем Представление
				ПредставлениеОбъекта = "";
				Если Значение.Свойство("Представление", ПредставлениеОбъекта)
					И ТипЗнч(ПредставлениеОбъекта) = Тип("Строка")
					И ПредставлениеОбъекта <> "" Тогда
					Значение.Вставить("Представление", АнонимизаторТокенизировать(ПредставлениеОбъекта, "STR"));
				КонецЕсли;
			ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Тогда
				// ТЧ или массив строк (ФиксированныйМассив → Массив после ПреобразоватьЗначениеДляJSON)
				Для ЭлтИнд = 0 По Значение.Количество() - 1 Цикл
					ЭлтМасс = Значение[ЭлтИнд];
					Если ТипЗнч(ЭлтМасс) = Тип("Строка") И ЭлтМасс <> "" Тогда
						Значение[ЭлтИнд] = АнонимизаторТокенизировать(ЭлтМасс, "STR");
					ИначеЕсли ТипЗнч(ЭлтМасс) = Тип("Структура") Тогда
						Для Каждого КВПСтр Из ЭлтМасс Цикл
							Если СлужебныеКлючи[КВПСтр.Ключ] = Истина Тогда Продолжить; КонецЕсли;
							ЗнчСтр = КВПСтр.Значение;
							Если ТипЗнч(ЗнчСтр) = Тип("Строка") И ЗнчСтр <> "" Тогда
								ЭлтМасс.Вставить(КВПСтр.Ключ, АнонимизаторТокенизировать(ЗнчСтр, "STR"));
							ИначеЕсли ТипЗнч(ЗнчСтр) = Тип("Структура") Тогда
								ПредстСтр = "";
								Если ЗнчСтр.Свойство("Представление", ПредстСтр)
									И ТипЗнч(ПредстСтр) = Тип("Строка") И ПредстСтр <> "" Тогда
									ЗнчСтр.Вставить("Представление", АнонимизаторТокенизировать(ПредстСтр, "STR"));
								КонецЕсли;
							КонецЕсли;
						КонецЦикла;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
		// Regex в blind mode не запускаем — все строки уже целиком токенизированы
		// РегексКонтекст.ЕстьТекстыДляRegex остаётся Ложь
		Возврат;
	КонецЕсли;

	// — SCHEMA MODE —
	ПравилаАнонимизации = ПолучитьПравилаТочнойАнонимизацииИзХранилища();

	Схема = Результат.schema;
	Колонки = Неопределено;
	Если НЕ Схема.Свойство("columns", Колонки) Или ТипЗнч(Колонки) <> Тип("Массив") Тогда Возврат; КонецЕсли;

	// Карта политик основных колонок
	СоответствиеPolicy = Новый Соответствие;
	Для Каждого Колонка Из Колонки Цикл
		Если ТипЗнч(Колонка) <> Тип("Структура") Тогда Продолжить; КонецЕсли;
		ИмяКолонки = "";
		Если НЕ Колонка.Свойство("name", ИмяКолонки) Тогда Продолжить; КонецЕсли;
		Режим = "default";      Колонка.Свойство("anonymization_mode", Режим);
		РежимСсылки = "default"; Колонка.Свойство("reference_presentation_mode", РежимСсылки);
		Sources = ПолучитьМассивСтрокИзСвойства(Колонка, "sources");
		СоответствиеPolicy.Вставить(ИмяКолонки,
			Новый Структура("mode, ref_mode, sources", Режим, РежимСсылки, Sources));
	КонецЦикла;

	// Карты политик табличных частей
	СоответствиеPolicyТЧ = Новый Соответствие; // ИмяТЧ -> Соответствие (имя колонки -> policy)
	ТабличныеЧасти = Неопределено;
	Если Схема.Свойство("tabular_sections", ТабличныеЧасти) Тогда
		Для Каждого КВПтч Из ТабличныеЧасти Цикл
			ИмяТЧ    = КВПтч.Ключ;
			СхемаТЧ  = КВПтч.Значение;
			PolicyТЧ = Новый Соответствие;
			КолонкиТЧ = Неопределено;
			Если СхемаТЧ.Свойство("columns", КолонкиТЧ) Тогда
				Для Каждого КолТЧ Из КолонкиТЧ Цикл
					Если ТипЗнч(КолТЧ) <> Тип("Структура") Тогда Продолжить; КонецЕсли;
					ИмяКол = ""; Если НЕ КолТЧ.Свойство("name", ИмяКол) Тогда Продолжить; КонецЕсли;
					Реж = "default";      КолТЧ.Свойство("anonymization_mode", Реж);
					РежСсылки = "default"; КолТЧ.Свойство("reference_presentation_mode", РежСсылки);
					Src = ПолучитьМассивСтрокИзСвойства(КолТЧ, "sources");
					PolicyТЧ.Вставить(ИмяКол,
						Новый Структура("mode, ref_mode, sources", Реж, РежСсылки, Src));
				КонецЦикла;
			КонецЕсли;
			СоответствиеPolicyТЧ.Вставить(ИмяТЧ, PolicyТЧ);
		КонецЦикла;
	КонецЕсли;

	// Обходим поля data (Структура)
	Для Каждого КВП Из Данные Цикл
		ИмяПоля = КВП.Ключ;
		Значение = КВП.Значение;

		// Табличная часть?
		Если СоответствиеPolicyТЧ[ИмяПоля] <> Неопределено
			И ТипЗнч(Значение) = Тип("Массив") Тогда
			PolicyМапТЧ = СоответствиеPolicyТЧ[ИмяПоля];
			Для Каждого СтрокаТЧ Из Значение Цикл
				Если ТипЗнч(СтрокаТЧ) <> Тип("Структура") Тогда Продолжить; КонецЕсли;
				Для Каждого PolicyЭлт Из PolicyМапТЧ Цикл
					ИмяКолонки = PolicyЭлт.Ключ;
					Policy      = PolicyЭлт.Значение;
					ЗначениеКолонки = Неопределено;
					Если НЕ СтрокаТЧ.Свойство(ИмяКолонки, ЗначениеКолонки) Тогда Продолжить; КонецЕсли;
					Если ЗначениеКолонки = Неопределено Тогда Продолжить; КонецЕсли;
					ОбработатьЗначениеОбъектаВстроенный(СтрокаТЧ, ИмяКолонки, ЗначениеКолонки, Policy, ПравилаАнонимизации);
				КонецЦикла;
			КонецЦикла;
			Продолжить;
		КонецЕсли;

		// Обычное поле
		Policy = СоответствиеPolicy[ИмяПоля];
		Если Policy = Неопределено Тогда Продолжить; КонецЕсли;
		ОбработатьЗначениеОбъектаВстроенный(Данные, ИмяПоля, Значение, Policy, ПравилаАнонимизации);
	КонецЦикла;

	// Фаза regex
	Если РегексКонтекст <> Неопределено Тогда
		СобратьТекстыДляRegexОбъект(Результат, РегексКонтекст);
	КонецЕсли;

КонецПроцедуры

Процедура ОбработатьЗначениеОбъектаВстроенный(Контейнер, ИмяПоля, Значение, Policy, ПравилаАнонимизации)

	Если ТипЗнч(Значение) = Тип("Структура")
		И Значение.Свойство("Представление") Тогда
		// objectRef — анонимизируем Представление по ref_mode
		ТипОбъектаЗначения = "";
		Значение.Свойство("ТипОбъекта", ТипОбъектаЗначения);
		Если Найти(ТипОбъектаЗначения, "ПеречислениеСсылка.") = 1 Тогда Возврат; КонецЕсли;
		Если Найти(ТипОбъектаЗначения, "ПланСчетовСсылка.") = 1
			И Policy.mode <> "force_anonymize" И Policy.ref_mode <> "force_anonymize" Тогда
			Возврат;
		КонецЕсли;
		Если Policy.mode = "force_keep" Тогда Возврат;
		ИначеЕсли Policy.mode = "force_anonymize" Или Policy.ref_mode = "force_anonymize" Тогда
			Значение.Вставить("Представление",
				АнонимизироватьЗначениеВстроенный(Значение.Представление, Policy.sources, ПравилаАнонимизации));
		ИначеЕсли Policy.ref_mode = "force_keep" Тогда Возврат;
		Иначе
			Значение.Вставить("Представление", ПрименитьСловарьКСтроке(Значение.Представление));
		КонецЕсли;

	ИначеЕсли ТипЗнч(Значение) = Тип("Строка") Тогда
		НовоеЗначение = Неопределено;
		Если Policy.mode = "force_anonymize" Тогда
			НовоеЗначение = АнонимизироватьЗначениеВстроенный(Значение, Policy.sources, ПравилаАнонимизации);
		ИначеЕсли Policy.mode = "default" Тогда
			НовоеЗначение = ПрименитьСловарьКСтроке(Значение);
		КонецЕсли;
		Если НовоеЗначение <> Неопределено Тогда
			Контейнер.Вставить(ИмяПоля, НовоеЗначение);
		КонецЕсли;
	ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Тогда
		// Реквизит типа ФиксированныйМассив (строки или ссылки) после ПреобразоватьЗначениеДляJSON
		Если Policy.mode = "force_keep" Тогда Возврат; КонецЕсли;
		Для ЭлтИнд = 0 По Значение.Количество() - 1 Цикл
			Элт = Значение[ЭлтИнд];
			Если ТипЗнч(Элт) = Тип("Структура") И Элт.Свойство("Представление") Тогда
				ТипОбъектаЭлт = "";
				Элт.Свойство("ТипОбъекта", ТипОбъектаЭлт);
				Если Найти(ТипОбъектаЭлт, "ПеречислениеСсылка.") = 1 Тогда Продолжить; КонецЕсли;
				Если Найти(ТипОбъектаЭлт, "ПланСчетовСсылка.") = 1
					И Policy.mode <> "force_anonymize" И Policy.ref_mode <> "force_anonymize" Тогда
					Продолжить;
				КонецЕсли;
				Если Policy.ref_mode = "force_keep" Тогда Продолжить; КонецЕсли;
				Если Policy.mode = "force_anonymize" Или Policy.ref_mode = "force_anonymize" Тогда
					Элт.Вставить("Представление",
						АнонимизироватьЗначениеВстроенный(Элт.Представление, Policy.sources, ПравилаАнонимизации));
				Иначе
					Элт.Вставить("Представление", ПрименитьСловарьКСтроке(Элт.Представление));
				КонецЕсли;
			ИначеЕсли ТипЗнч(Элт) = Тип("Строка") Тогда
				НовЭлт = Неопределено;
				Если Policy.mode = "force_anonymize" Тогда
					НовЭлт = АнонимизироватьЗначениеВстроенный(Элт, Policy.sources, ПравилаАнонимизации);
				ИначеЕсли Policy.mode = "default" Тогда
					НовЭлт = ПрименитьСловарьКСтроке(Элт);
				КонецЕсли;
				Если НовЭлт <> Неопределено Тогда
					Значение[ЭлтИнд] = НовЭлт;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

Функция ПрочитатьJSON2(Значение, Стандарт = Истина, ПредставленияСсылок = Ложь)
	
	Возврат jsonПрочитатьИнициализация(Значение, Стандарт, ПредставленияСсылок);
	
КонецФункции

Функция ЗаписатьJSON2(Значение, Стандарт = Истина, ПредставленияСсылок = Ложь)

	Возврат jsonЗаписатьИнициализация(Значение, Стандарт, ПредставленияСсылок);

КонецФункции

Функция НастройкаАвтоматическоеПриведениеОбъектаКСтруктуре()
	Возврат Истина;
КонецФункции

Функция НастройкаПолноеМаскированиеСимволов()
	Возврат Истина;
КонецФункции

Функция НастройкаМаскированиеКириллицы()
	Возврат Ложь;
КонецФункции

Функция jsonПрочитатьИнициализация(Значение, Знач Стандарт, Знач ПредставленияСсылок)
	
	Альтернативный = (Стандарт = Неопределено) Или (Не Стандарт);
	Стандарт = (Стандарт = Неопределено) Или Стандарт;
	ПредставленияСсылок = (ПредставленияСсылок = Неопределено) Или ПредставленияСсылок;
	
	// Схема подстановок шестнадцатиричной системы
	СхемаПодстановок = Новый Соответствие;
	ШестнадцатиричнаяСистема = "0123456789abcdef";
	ДесятичноеЧисло = 0;
	Для ВторойРазряд = 1 По 16 Цикл
		Для ПервыйРазряд = 1 По 16 Цикл
			СхемаПодстановок.Вставить(Сред(ШестнадцатиричнаяСистема, ВторойРазряд, 1) + Сред(ШестнадцатиричнаяСистема, ПервыйРазряд, 1), ДесятичноеЧисло);
			ДесятичноеЧисло = ДесятичноеЧисло + 1;
		КонецЦикла;
	КонецЦикла;
	
	ВспомогательныеДанные = Новый Структура("ТипСтроки,СхемаПодстановок,АвтоматическиПриводитьКСтруктуре",
		Тип("Строка"),
		СхемаПодстановок,
		(НастройкаАвтоматическоеПриведениеОбъектаКСтруктуре() = Истина));
	
	Индекс = 1;
	Длина = СтрДлина(Значение);
	СимволыФорматирования = " " + Символы.ВК + Символы.ПС + Символы.Таб;
	
	Если Стандарт Тогда
		jsonПрочитатьПропуститьФорматирование(Значение, Стандарт, Индекс, Длина, СимволыФорматирования);
	КонецЕсли;
	
	Если (Индекс > Длина) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат jsonПрочитать(Значение, Стандарт, Альтернативный, ПредставленияСсылок, Индекс, Длина, ВспомогательныеДанные, СимволыФорматирования, Истина);
	
КонецФункции

Процедура jsonПрочитатьПропуститьФорматирование(Значение, Стандарт, Индекс, Длина, СимволыФорматирования)
	Пока (Индекс <= Длина) И Найти(СимволыФорматирования, Сред(Значение, Индекс, 1)) Цикл
		Индекс = Индекс + 1;
	КонецЦикла;
КонецПроцедуры

Функция jsonПрочитать(Значение, Стандарт, Альтернативный, ПредставленияСсылок, Индекс, Длина, ВспомогательныеДанные, СимволыФорматирования, ПервыйУровень)
	
	Символ = Сред(Значение, Индекс, 1);
	
	Если (Символ = """") Или (Символ = "'") Тогда
		// Строка
		Начало = Индекс;
		Пока Истина Цикл
			Подстрока = Сред(Значение, Индекс + 1, 384);
			Позиция = Найти(Подстрока, Символ);
			
			Если (Позиция > 0) Тогда
				Индекс = Индекс + Позиция;
				Откат = Индекс - 1;
				Маскировка = Ложь;
				Пока (Сред(Значение, Откат, 1) = "\") И Откат Цикл
					Маскировка = Не Маскировка;
					Откат = Откат - 1;
				КонецЦикла;
				Если НЕ Маскировка Тогда
					Прервать;
				КонецЕсли;
			Иначе
				Индекс = Индекс + 384;
				Если Индекс >= Длина Тогда
					Возврат Неопределено;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		Результат = jsonПрочитатьСтроку(Сред(Значение, Начало + 1, Индекс - Начало - 1), Стандарт, Начало, ВспомогательныеДанные.СхемаПодстановок, (Символ = "'"));
		Индекс = Индекс + 1;
		
	ИначеЕсли (Символ = "[") Тогда
		// Массив
		Результат = Новый Массив;
		Индекс = Индекс + 1;
		Если Стандарт Тогда
			jsonПрочитатьПропуститьФорматирование(Значение, Стандарт, Индекс, Длина, СимволыФорматирования);
		КонецЕсли;
		
		Символ = Сред(Значение, Индекс, 1);
		Если (Символ = "]") Тогда
			Индекс = Индекс + 1;
		Иначе
			Пока (Индекс <= Длина) Цикл
				Результат.Добавить(jsonПрочитать(Значение, Стандарт, Альтернативный, ПредставленияСсылок, Индекс, Длина, ВспомогательныеДанные, СимволыФорматирования, Ложь));
				
				Символ = Сред(Значение, Индекс, 1);
				Если (Символ = "]") Тогда
					Индекс = Индекс + 1;
					Прервать;
				ИначеЕсли (Символ = ",") Тогда
					Индекс = Индекс + 1;
					Если Стандарт Тогда
						jsonПрочитатьПропуститьФорматирование(Значение, Стандарт, Индекс, Длина, СимволыФорматирования);
					КонецЕсли;
				Иначе
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
	ИначеЕсли (Символ = "{") Тогда
		// Объект
		Индекс = Индекс + 1;
		Если Стандарт Тогда
			jsonПрочитатьПропуститьФорматирование(Значение, Стандарт, Индекс, Длина, СимволыФорматирования);
		КонецЕсли;
		
		Символ = Сред(Значение, Индекс, 1);
		Если (Символ = "}") Тогда
			Индекс = Индекс + 1;
			Если ВспомогательныеДанные.АвтоматическиПриводитьКСтруктуре Тогда
				Результат = Новый Структура;
			Иначе
				Результат = Новый Соответствие;
			КонецЕсли;
		Иначе
			Результат = Новый Соответствие;
			ТипСтроки = ВспомогательныеДанные.ТипСтроки;
			
			Пока (Индекс <= Длина) Цикл
				КлючЭлемента = jsonПрочитать(Значение, Стандарт, Альтернативный, ПредставленияСсылок, Индекс, Длина, ВспомогательныеДанные, СимволыФорматирования, Ложь);
				
				Символ = Сред(Значение, Индекс, 1);
				Если (Символ = ":") Тогда
					Индекс = Индекс + 1;
					Если Стандарт Тогда
						jsonПрочитатьПропуститьФорматирование(Значение, Стандарт, Индекс, Длина, СимволыФорматирования);
					КонецЕсли;
				Иначе
					Прервать;
				КонецЕсли;
				
				ЗначениеЭлемента = jsonПрочитать(Значение, Стандарт, Альтернативный, ПредставленияСсылок, Индекс, Длина, ВспомогательныеДанные, СимволыФорматирования, Ложь);
				Результат.Вставить(КлючЭлемента, ЗначениеЭлемента);
				
				Символ = Сред(Значение, Индекс, 1);
				Если (Символ = "}") Тогда
					Индекс = Индекс + 1;
					Прервать;
				ИначеЕсли (Символ = ",") Тогда
					Индекс = Индекс + 1;
					Если Стандарт Тогда
						jsonПрочитатьПропуститьФорматирование(Значение, Стандарт, Индекс, Длина, СимволыФорматирования);
					КонецЕсли;
				Иначе
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			// Преобразование в структуру
			Если ВспомогательныеДанные.АвтоматическиПриводитьКСтруктуре Тогда
				РезультатСтруктура = Новый Структура;
				Для Каждого Элемент Из Результат Цикл
					Попытка
						РезультатСтруктура.Вставить(Элемент.Ключ, Элемент.Значение);
					Исключение
						РезультатСтруктура = Результат;
						Прервать;
					КонецПопытки;
				КонецЦикла;
				Результат = РезультатСтруктура;
			КонецЕсли;
		КонецЕсли;
		
	Иначе
		// Примитивные типы
		Если (Символ = "n") Тогда
			Если (Сред(Значение, Индекс, 4) = "null") Тогда
				Индекс = Индекс + 4;
				Результат = Null;
			Иначе
				Результат = Неопределено;
			КонецЕсли;
		ИначеЕсли (Символ = "t") Тогда
			Если (Сред(Значение, Индекс, 4) = "true") Тогда
				Индекс = Индекс + 4;
				Результат = Истина;
			Иначе
				Результат = Неопределено;
			КонецЕсли;
		ИначеЕсли (Символ = "f") Тогда
			Если (Сред(Значение, Индекс, 5) = "false") Тогда
				Индекс = Индекс + 5;
				Результат = Ложь;
			Иначе
				Результат = Неопределено;
			КонецЕсли;
		Иначе
			// Число
			Начало = Индекс;
			Пока Найти("-+0123456789.eE", Символ) И (Индекс <= Длина) Цикл
				Индекс = Индекс + 1;
				Символ = Сред(Значение, Индекс, 1);
			КонецЦикла;
			
			Попытка
				Результат = Число(Сред(Значение, Начало, Индекс - Начало));
			Исключение
				Результат = 0;
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	
	Если Стандарт Тогда
		jsonПрочитатьПропуститьФорматирование(Значение, Стандарт, Индекс, Длина, СимволыФорматирования);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция jsonПрочитатьСтроку(Значение, Стандарт, Индекс, СхемаПодстановок, ОдинарнаяКавычка)
	
	ПоследоавтельностьПеремаскировки = "\" + Символ(65535);
	
	Результат = СтрЗаменить(СтрЗаменить(СтрЗаменить(СтрЗаменить(СтрЗаменить(СтрЗаменить(СтрЗаменить(СтрЗаменить(Значение,
		"\\", ПоследоавтельностьПеремаскировки),
		"\/", "/"),
		"\b", Символ(008)),
		"\t", Символы.Таб),
		"\n", Символы.ПС),
		"\f", Символы.ПФ),
		"\r", Символы.ВК),
		"\""", """");
	
	// Демаскирование Юникод символов
	Позиция = Найти(Результат, "\u");
	Пока Позиция Цикл
		СтаршийБайт = СхемаПодстановок[НРег(Сред(Результат, Позиция + 2, 2))];
		МладшийБайт = СхемаПодстановок[НРег(Сред(Результат, Позиция + 4, 2))];
		Если (СтаршийБайт = Неопределено) Или (МладшийБайт = Неопределено) Тогда
			Прервать;
		КонецЕсли;
		Результат = СтрЗаменить(Результат, Сред(Результат, Позиция, 6), Символ(256 * СтаршийБайт + МладшийБайт));
		Позиция = Найти(Результат, "\u");
	КонецЦикла;
	
	Если ОдинарнаяКавычка Тогда
		Результат = СтрЗаменить(Результат, "\'", "'");
	КонецЕсли;
	
	Возврат СтрЗаменить(Результат, ПоследоавтельностьПеремаскировки, "\");
	
КонецФункции

Функция jsonЗаписатьИнициализация(Значение, Знач Стандарт, Знач ПредставленияСсылок)
	
	ВспомогательныеДанные = Новый Структура("ПримитивныеТипы,Массивы,Структуры,Соответсвия,ТипДопустимыхКлючей",
		Новый ОписаниеТипов("Null,Булево,Число,Дата,УникальныйИдентификатор"),
		Новый ОписаниеТипов("Массив,ФиксированныйМассив"),
		Новый ОписаниеТипов("Структура,ФиксированнаяСтруктура"),
		Новый ОписаниеТипов("Структура,ФиксированнаяСтруктура,Соответствие,ФиксированноеСоответствие"),
		Новый ОписаниеТипов("Строка"));
	
	Если Стандарт Тогда
		Смещение = "";
		Отступ = " ";
		Табуляция = "    ";
		ПереносСтроки = Символы.ПС;
	Иначе
		Смещение = "";
		Отступ = "";
		Табуляция = "";
		ПереносСтроки = "";
	КонецЕсли;
	
	Возврат jsonЗаписать(Значение, Стандарт, ПредставленияСсылок, ВспомогательныеДанные, Неопределено, Смещение, Отступ, Табуляция, ПереносСтроки, (НастройкаПолноеМаскированиеСимволов() = Истина), (НастройкаМаскированиеКириллицы() = Истина));
	
КонецФункции

Функция jsonЗаписать(Значение, Стандарт, ПредставленияСсылок, ВспомогательныеДанные, Колонки, Смещение, Отступ, Табуляция, ПереносСтроки, ПолноеМаскированиеСимволов, МаскированиеКириллицы)
	
	Тип = ТипЗнч(Значение);
	
	// Строка
	Если (Тип = Тип("Строка")) Тогда
		Возврат jsonЗаписатьСтроку(Значение, ПолноеМаскированиеСимволов, МаскированиеКириллицы);
	КонецЕсли;
	
	// Неопределено и примитивные типы
	Если ВспомогательныеДанные.ПримитивныеТипы.СодержитТип(Тип) Тогда
		Если (Значение = Null) Или (Значение = Неопределено) Тогда
			Возврат "null";
		ИначеЕсли (Тип = Тип("Дата")) Тогда
			Возврат """" + Формат(Значение, "ДФ=yyyy-MM-ddTHH:mm:ss; ДП=") + "Z""";
		ИначеЕсли (Тип = Тип("УникальныйИдентификатор")) Тогда
			Возврат """" + Значение + """";
		Иначе
			Возврат Формат(Значение, "ЧРД=.; ЧН=; ЧГ=; БЛ=false; БИ=true");
		КонецЕсли;
	КонецЕсли;
	
	// Структуры
	Если ВспомогательныеДанные.Структуры.СодержитТип(Тип) Тогда
		Если Значение.Количество() Тогда
			СледующееСмещение = Смещение + Табуляция;
			Первый = Истина;
			Для Каждого Элемент Из Значение Цикл
				Если Первый Тогда
					Результат = ПереносСтроки + СледующееСмещение + """" + Элемент.Ключ + """:" + Отступ + jsonЗаписать(Элемент.Значение, Стандарт, ПредставленияСсылок, ВспомогательныеДанные, Неопределено, СледующееСмещение, Отступ, Табуляция, ПереносСтроки, ПолноеМаскированиеСимволов, МаскированиеКириллицы);
					Первый = Ложь;
				Иначе
					Результат = Результат + "," + ПереносСтроки + СледующееСмещение + """" + Элемент.Ключ + """:" + Отступ + jsonЗаписать(Элемент.Значение, Стандарт, ПредставленияСсылок, ВспомогательныеДанные, Неопределено, СледующееСмещение, Отступ, Табуляция, ПереносСтроки, ПолноеМаскированиеСимволов, МаскированиеКириллицы);
				КонецЕсли;
			КонецЦикла;
			Возврат "{" + Результат + ПереносСтроки + Смещение + "}";
		Иначе
			Возврат "{}";
		КонецЕсли;
	КонецЕсли;
	
	// Соответствия
	Если ВспомогательныеДанные.Соответсвия.СодержитТип(Тип) Тогда
		Если Значение.Количество() Тогда
			СледующееСмещение = Смещение + Табуляция;
			ТипДопустимыхКлючей = ВспомогательныеДанные.ТипДопустимыхКлючей;
			Первый = Истина;
			Для Каждого Элемент Из Значение Цикл
				Ключ = Элемент.Ключ;
				Если ТипДопустимыхКлючей.СодержитТип(ТипЗнч(Ключ)) Тогда
					Ключ = jsonЗаписатьСтроку(Строка(Ключ), ПолноеМаскированиеСимволов, МаскированиеКириллицы);
				Иначе
					Ключ = """" + Ключ + """";
				КонецЕсли;
				Если Первый Тогда
					Результат = ПереносСтроки + СледующееСмещение + Ключ + ":" + Отступ + jsonЗаписать(Элемент.Значение, Стандарт, ПредставленияСсылок, ВспомогательныеДанные, Неопределено, СледующееСмещение, Отступ, Табуляция, ПереносСтроки, ПолноеМаскированиеСимволов, МаскированиеКириллицы);
					Первый = Ложь;
				Иначе
					Результат = Результат + "," + ПереносСтроки + СледующееСмещение + Ключ + ":" + Отступ + jsonЗаписать(Элемент.Значение, Стандарт, ПредставленияСсылок, ВспомогательныеДанные, Неопределено, СледующееСмещение, Отступ, Табуляция, ПереносСтроки, ПолноеМаскированиеСимволов, МаскированиеКириллицы);
				КонецЕсли;
			КонецЦикла;
			Возврат "{" + Результат + ПереносСтроки + Смещение + "}";
		Иначе
			Возврат "{}";
		КонецЕсли;
	КонецЕсли;
	
	// Массивы
	Если ВспомогательныеДанные.Массивы.СодержитТип(Тип) Тогда
		Если Значение.Количество() Тогда
			СледующееСмещение = Смещение + Табуляция;
			Первый = Истина;
			Для Каждого Элемент Из Значение Цикл
				Если Первый Тогда
					Результат = ПереносСтроки + СледующееСмещение + jsonЗаписать(Элемент, Стандарт, ПредставленияСсылок, ВспомогательныеДанные, Неопределено, СледующееСмещение, Отступ, Табуляция, ПереносСтроки, ПолноеМаскированиеСимволов, МаскированиеКириллицы);
					Первый = Ложь;
				Иначе
					Результат = Результат + "," + ПереносСтроки + СледующееСмещение + jsonЗаписать(Элемент, Стандарт, ПредставленияСсылок, ВспомогательныеДанные, Неопределено, СледующееСмещение, Отступ, Табуляция, ПереносСтроки, ПолноеМаскированиеСимволов, МаскированиеКириллицы);
				КонецЕсли;
			КонецЦикла;
			Возврат "[" + Результат + ПереносСтроки + Смещение + "]";
		Иначе
			Возврат "[]";
		КонецЕсли;
	КонецЕсли;
	
	// Неподдерживаемые типы - преобразование в строку
	Возврат jsonЗаписатьСтроку(Строка(Значение), ПолноеМаскированиеСимволов, МаскированиеКириллицы);
	
КонецФункции

Функция jsonЗаписатьСтроку(Значение, ПолноеМаскированиеСимволов, МаскированиеКириллицы)
	
	// Маскирование служебных символов
	Результат = СтрЗаменить(СтрЗаменить(СтрЗаменить(СтрЗаменить(СтрЗаменить(СтрЗаменить(СтрЗаменить(Значение,
		"\", "\\"),
		Символ(008), "\b"),
		Символы.Таб, "\t"),
		Символы.ПС, "\n"),
		Символы.ПФ, "\f"),
		Символы.ВК, "\r"),
		"""", "\""");
	
	// Маскирование специальных символов
	Результат = СтрЗаменить(СтрЗаменить(СтрЗаменить(СтрЗаменить(СтрЗаменить(СтрЗаменить(СтрЗаменить(СтрЗаменить(СтрЗаменить(СтрЗаменить(СтрЗаменить(СтрЗаменить(СтрЗаменить(СтрЗаменить(СтрЗаменить(СтрЗаменить(СтрЗаменить(СтрЗаменить(СтрЗаменить(СтрЗаменить(СтрЗаменить(СтрЗаменить(СтрЗаменить(СтрЗаменить(СтрЗаменить(СтрЗаменить(СтрЗаменить(Результат,
		Символ(00), "\u0000"),
		Символ(01), "\u0001"),
		Символ(02), "\u0002"),
		Символ(03), "\u0003"),
		Символ(04), "\u0004"),
		Символ(05), "\u0005"),
		Символ(06), "\u0006"),
		Символ(07), "\u0007"),
		Символ(11), "\u000b"),
		Символ(14), "\u000e"),
		Символ(15), "\u000f"),
		Символ(16), "\u0010"),
		Символ(17), "\u0011"),
		Символ(18), "\u0012"),
		Символ(19), "\u0013"),
		Символ(20), "\u0014"),
		Символ(21), "\u0015"),
		Символ(22), "\u0016"),
		Символ(23), "\u0017"),
		Символ(24), "\u0018"),
		Символ(25), "\u0019"),
		Символ(26), "\u001a"),
		Символ(27), "\u001b"),
		Символ(28), "\u001c"),
		Символ(29), "\u001d"),
		Символ(30), "\u001e"),
		Символ(31), "\u001f");
	
	Возврат """" + Результат + """";
	
КонецФункции

Функция ПолучитьRegexПравилаИзХранилища()
	Если КэшRegexПравил <> Неопределено Тогда
		Возврат КэшRegexПравил;
	КонецЕсли;

	СохранённыеПравила = ПолучитьRegexПравилаИзХранилищаНаСервере();
	Если СохранённыеПравила <> Неопределено И ТипЗнч(СохранённыеПравила) = Тип("Массив") Тогда
		КэшRegexПравил = СохранённыеПравила;
	Иначе
		КэшRegexПравил = ПолучитьRegexПравилаПоУмолчанию();
	КонецЕсли;
	Возврат КэшRegexПравил;
КонецФункции

Функция ПолучитьRegexПравилаИзХранилищаНаСервере()
	Попытка
		ЗначениеJSON = ХранилищеОбщихНастроек.Загрузить("ExecuteQueryRegexRules.v1", "rules");
		Если ЗначениеJSON <> Неопределено И НЕ ПустаяСтрока(ЗначениеJSON) Тогда
			Данные = ПрочитатьJSON2(ЗначениеJSON);
			МассивПравил = Неопределено;
			Если ТипЗнч(Данные) = Тип("Структура") Тогда
				Данные.Свойство("rules", МассивПравил);
			ИначеЕсли ТипЗнч(Данные) = Тип("Соответствие") Тогда
				МассивПравил = Данные["rules"];
			КонецЕсли;
			Если ТипЗнч(МассивПравил) = Тип("Массив") Тогда
				Возврат МассивПравил;
			КонецЕсли;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат Неопределено;
КонецФункции

Функция ПолучитьRegexПравилаПоУмолчанию()
	ДанныеПравил = ПолучитьRegexПравилаПоУмолчаниюНаСервере();
	Если ДанныеПравил = Неопределено Тогда
		Возврат Новый Массив;
	КонецЕсли;
	Возврат ДанныеПравил;
КонецФункции

Функция ПолучитьRegexПравилаПоУмолчаниюНаСервере()
	Попытка
		ДвоичныеДанные = ПолучитьМакет("НастройкиRegexПоУмолчанию");
		ИмяФайла = ПолучитьИмяВременногоФайла("json");
		ДвоичныеДанные.Записать(ИмяФайла);
		ТекстовыйДокумент = Новый ТекстовыйДокумент;
		ТекстовыйДокумент.Прочитать(ИмяФайла);
		Данные = ПрочитатьJSON2(ТекстовыйДокумент.ПолучитьТекст());
		ИсхМассив = Неопределено;
		Если ТипЗнч(Данные) = Тип("Структура") Тогда
			Данные.Свойство("rules", ИсхМассив);
		ИначеЕсли ТипЗнч(Данные) = Тип("Соответствие") Тогда
			ИсхМассив = Данные["rules"];
		КонецЕсли;
		Если ТипЗнч(ИсхМассив) = Тип("Массив") Тогда
			МассивПравил = Новый Массив;
			Для Каждого Правило Из ИсхМассив Цикл
				Стр = Новый Структура("enabled, pattern, category, description", Ложь, "", "", "");
				Если ТипЗнч(Правило) = Тип("Структура") Или ТипЗнч(Правило) = Тип("Соответствие") Тогда
					ВклЗнч = Неопределено;
					ПатЗнч = Неопределено;
					КатЗнч = Неопределено;
					ОпиЗнч = Неопределено;
					Если ТипЗнч(Правило) = Тип("Структура") Тогда
						Правило.Свойство("enabled",     ВклЗнч);
						Правило.Свойство("pattern",     ПатЗнч);
						Правило.Свойство("category",    КатЗнч);
						Правило.Свойство("description", ОпиЗнч);
					Иначе
						ВклЗнч = Правило["enabled"];
						ПатЗнч = Правило["pattern"];
						КатЗнч = Правило["category"];
						ОпиЗнч = Правило["description"];
					КонецЕсли;
					Если ВклЗнч <> Неопределено Тогда Стр.enabled     = ВклЗнч; КонецЕсли;
					Если ПатЗнч <> Неопределено Тогда Стр.pattern     = ПатЗнч; КонецЕсли;
					Если КатЗнч <> Неопределено Тогда Стр.category    = КатЗнч; КонецЕсли;
					Если ОпиЗнч <> Неопределено Тогда Стр.description = ОпиЗнч; КонецЕсли;
				КонецЕсли;
				МассивПравил.Добавить(Стр);
			КонецЦикла;
			Возврат МассивПравил;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат Неопределено;
КонецФункции

Процедура СобратьТекстыДляRegex(Результат, РегексКонтекст)
	// Получить включённые правила
	ВсеПравила = ПолучитьRegexПравилаИзХранилища();
	ВключённыеПравила = Новый Массив;
	Для Каждого Правило Из ВсеПравила Цикл
		Если ТипЗнч(Правило) = Тип("Структура") И Правило.enabled = Истина Тогда
			ВключённыеПравила.Добавить(Новый Структура("pattern, category", Правило.pattern, Правило.category));
		КонецЕсли;
	КонецЦикла;

	Если ВключённыеПравила.Количество() = 0 Тогда
		РегексКонтекст.ЕстьТекстыДляRegex = Ложь;
		Возврат;
	КонецЕсли;

	// Сериализовать включённые правила в JSON
	МассивПравилJSON = Новый Массив;
	Для Каждого П Из ВключённыеПравила Цикл
		МассивПравилJSON.Добавить(Новый Структура("pattern, category", П.pattern, П.category));
	КонецЦикла;
	РегексКонтекст.ВключённыеПравилаJSON = ЗаписатьJSON2(МассивПравилJSON);

	// Собрать тексты из данных результата
	ТекстыМассив  = Новый Массив;
	МаппингИндексов = Новый Массив; // каждый элемент: Структура("СтрокаИндекс, ИмяКолонки, ТипЗначения")

	Данные = Неопределено;
	Если НЕ (ТипЗнч(Результат) = Тип("Структура")
		И Результат.Свойство("data", Данные)
		И ТипЗнч(Данные) = Тип("Массив")) Тогда
		РегексКонтекст.ЕстьТекстыДляRegex = Ложь;
		Возврат;
	КонецЕсли;

	Схема = Неопределено;
	СоответствиеPolicy = Новый Соответствие;
	Если Результат.Свойство("schema", Схема)
		И ТипЗнч(Схема) = Тип("Структура") Тогда
		Колонки = Неопределено;
		Если Схема.Свойство("columns", Колонки) И ТипЗнч(Колонки) = Тип("Массив") Тогда
			Для Каждого Колонка Из Колонки Цикл
				Если ТипЗнч(Колонка) <> Тип("Структура") Тогда Продолжить; КонецЕсли;
				ИмяКолонки = "";
				Если НЕ Колонка.Свойство("name", ИмяКолонки) Тогда Продолжить; КонецЕсли;
				Режим       = "default";
				РежимСсылки = "default";
				Колонка.Свойство("anonymization_mode",          Режим);
				Колонка.Свойство("reference_presentation_mode", РежимСсылки);
				СоответствиеPolicy.Вставить(ИмяКолонки,
					Новый Структура("mode, ref_mode", Режим, РежимСсылки));
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;

	Для СтрИндекс = 0 По Данные.Количество() - 1 Цикл
		Строка = Данные[СтрИндекс];
		Если ТипЗнч(Строка) <> Тип("Соответствие")
			И ТипЗнч(Строка) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;
		Если ТипЗнч(Строка) = Тип("Структура") Тогда
			МассивКлючей = Новый Массив;
			Для Каждого КвП Из Строка Цикл
				МассивКлючей.Добавить(КвП.Ключ);
			КонецЦикла;
		Иначе
			МассивКлючей = Новый Массив;
			Для Каждого КвП Из Строка Цикл
				МассивКлючей.Добавить(КвП.Ключ);
			КонецЦикла;
		КонецЕсли;
		Для Каждого ИмяКол Из МассивКлючей Цикл
			PolicyКол = СоответствиеPolicy.Получить(ИмяКол);
			МодКол    = "default";
			РефКол    = "default";
			Если ТипЗнч(PolicyКол) = Тип("Структура") Тогда
				PolicyКол.Свойство("mode",     МодКол);
				PolicyКол.Свойство("ref_mode", РефКол);
			КонецЕсли;
			Если МодКол = "force_keep" Тогда Продолжить; КонецЕсли;
			ЗначениеКолонки = Неопределено;
			Если ТипЗнч(Строка) = Тип("Структура") Тогда
				Если НЕ Строка.Свойство(ИмяКол, ЗначениеКолонки) Тогда Продолжить; КонецЕсли;
			Иначе
				ЗначениеКолонки = Строка[ИмяКол];
			КонецЕсли;
			Если ТипЗнч(ЗначениеКолонки) = Тип("Строка") Тогда
				ТекстыМассив.Добавить(ЗначениеКолонки);
				МаппингИндексов.Добавить(Новый Структура("СтрокаИндекс, ИмяКолонки, ТипЗначения",
					СтрИндекс, ИмяКол, "Строка"));
			ИначеЕсли (ТипЗнч(ЗначениеКолонки) = Тип("Структура")
					И ЗначениеКолонки.Свойство("Представление"))
				ИЛИ (ТипЗнч(ЗначениеКолонки) = Тип("Соответствие")
					И ЗначениеКолонки["Представление"] <> Неопределено) Тогда
				// Определить ТипОбъекта для enum-проверки
				ТипОбъектаЗнч = "";
				Если ТипЗнч(ЗначениеКолонки) = Тип("Структура") Тогда
					ЗначениеКолонки.Свойство("ТипОбъекта", ТипОбъектаЗнч);
				Иначе
					ТипОбъектаЗнч = ?(ЗначениеКолонки["ТипОбъекта"] <> Неопределено,
						ЗначениеКолонки["ТипОбъекта"], "");
				КонецЕсли;
				// Enum-ссылки и ref_mode = force_keep не трогаем
				// Планы счетов по умолчанию не анонимизируются, если нет явного force_anonymize
				РазрешеноМенять = НЕ (Найти(ТипОбъектаЗнч, "ПеречислениеСсылка.") = 1)
					И НЕ (Найти(ТипОбъектаЗнч, "ПланСчетовСсылка.") = 1
						И РефКол <> "force_anonymize" И МодКол <> "force_anonymize")
					И НЕ (РефКол = "force_keep");
				ПредставлениеЗнч = ?(ТипЗнч(ЗначениеКолонки) = Тип("Структура"),
					ЗначениеКолонки.Представление,
					ЗначениеКолонки["Представление"]);
				Если РазрешеноМенять И ТипЗнч(ПредставлениеЗнч) = Тип("Строка") Тогда
					ТекстыМассив.Добавить(ПредставлениеЗнч);
					МаппингИндексов.Добавить(Новый Структура("СтрокаИндекс, ИмяКолонки, ТипЗначения",
						СтрИндекс, ИмяКол, "Представление"));
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Если ТекстыМассив.Количество() = 0 Тогда
		РегексКонтекст.ЕстьТекстыДляRegex = Ложь;
		Возврат;
	КонецЕсли;

	РегексКонтекст.ТекстыJSON      = ЗаписатьJSON2(ТекстыМассив);
	РегексКонтекст.МаппингИндексов = МаппингИндексов;
	РегексКонтекст.ЕстьТекстыДляRegex = Истина;
КонецПроцедуры

Процедура ПрименитьRegexТокены(РегексКонтекст, СовпаденияJSON)
	Если НЕ ЗначениеЗаполнено(СовпаденияJSON) Тогда Возврат; КонецЕсли;

	РезСовпадений = Неопределено;
	Попытка
		РезСовпадений = ПрочитатьJSON2(СовпаденияJSON);
	Исключение
		Возврат;
	КонецПопытки;
	Если ТипЗнч(РезСовпадений) <> Тип("Массив") Тогда Возврат; КонецЕсли;

	МаппингИндексов = РегексКонтекст.МаппингИндексов;
	Данные = РегексКонтекст.Результат.data;

	Для ТекстИнд = 0 По РезСовпадений.Количество() - 1 Цикл
		Если ТекстИнд >= МаппингИндексов.Количество() Тогда Прервать; КонецЕсли;
		ЭлСовпадений = РезСовпадений[ТекстИнд];
		Если ТипЗнч(ЭлСовпадений) <> Тип("Массив") Или ЭлСовпадений.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		МаппингЭлт = МаппингИндексов[ТекстИнд];
		СтрИндекс  = МаппингЭлт.СтрокаИндекс;
		ИмяКолонки = МаппингЭлт.ИмяКолонки;
		ТипЗнчения = МаппингЭлт.ТипЗначения;

		Строка = Данные[СтрИндекс];

		ТекущийТекст = Неопределено;
		Если ТипЗнч(Строка) = Тип("Структура") Тогда
			Если НЕ Строка.Свойство(ИмяКолонки, ТекущийТекст) Тогда Продолжить; КонецЕсли;
		ИначеЕсли ТипЗнч(Строка) = Тип("Соответствие") Тогда
			ТекущийТекст = Строка[ИмяКолонки];
		Иначе
			Продолжить;
		КонецЕсли;

		Если ТипЗнчения = "Представление" Тогда
			Если ТипЗнч(ТекущийТекст) = Тип("Структура") И ТекущийТекст.Свойство("Представление") Тогда
				ТекущийТекст = ТекущийТекст.Представление;
			ИначеЕсли ТипЗнч(ТекущийТекст) = Тип("Соответствие") Тогда
				ТекущийТекст = ТекущийТекст["Представление"];
			Иначе
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		Если ТипЗнч(ТекущийТекст) <> Тип("Строка") Тогда Продолжить; КонецЕсли;

		// Совпадения отсортированы по start DESC — применяем справа налево
		НовыйТекст = ТекущийТекст;
		Для Каждого С Из ЭлСовпадений Цикл
			Категория = "";
			МатчТекст = "";
			Начало    = 0;
			Длина     = 0;
			Если ТипЗнч(С) = Тип("Структура") Тогда
				С.Свойство("category", Категория);
				С.Свойство("match",    МатчТекст);
				С.Свойство("start",    Начало);
				С.Свойство("length",   Длина);
			ИначеЕсли ТипЗнч(С) = Тип("Соответствие") Тогда
				Категория = С["category"];
				МатчТекст = С["match"];
				Начало    = С["start"];
				Длина     = С["length"];
			КонецЕсли;
			Если МатчТекст = Неопределено Тогда МатчТекст = ""; КонецЕсли;
			Если Начало    = Неопределено Тогда Начало    = 0;  КонецЕсли;
			Если Длина     = Неопределено Тогда Длина     = 0;  КонецЕсли;
			Если Категория = Неопределено Тогда Категория = ""; КонецЕсли;
			Если ПустаяСтрока(МатчТекст) Или Длина <= 0 Тогда Продолжить; КонецЕсли;
			Токен = АнонимизаторТокенизировать(МатчТекст, Категория);
			// Замена по позиции (0-based start, 1-based 1С Лев/Сред)
			Если Начало >= 0 И (Начало + Длина) <= СтрДлина(НовыйТекст) Тогда
				НовыйТекст = Лев(НовыйТекст, Начало) + Токен + Сред(НовыйТекст, Начало + Длина + 1);
			КонецЕсли;
		КонецЦикла;

		// Записать обратно
		Если ТипЗнчения = "Представление" Тогда
			// ЗначениеКолонки — Структура/Соответствие с полем "Представление"
			ЗначениеКолонки2 = Неопределено;
			Если ТипЗнч(Строка) = Тип("Структура") Тогда
				Строка.Свойство(ИмяКолонки, ЗначениеКолонки2);
				Если ТипЗнч(ЗначениеКолонки2) = Тип("Структура") Тогда
					ЗначениеКолонки2.Вставить("Представление", НовыйТекст);
				КонецЕсли;
			Иначе
				ЗначениеКолонки2 = Строка[ИмяКолонки];
				Если ТипЗнч(ЗначениеКолонки2) = Тип("Структура") Тогда
					ЗначениеКолонки2.Вставить("Представление", НовыйТекст);
				ИначеЕсли ТипЗнч(ЗначениеКолонки2) = Тип("Соответствие") Тогда
					ЗначениеКолонки2["Представление"] = НовыйТекст;
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли ТипЗнч(Строка) = Тип("Структура") Тогда
			Строка.Вставить(ИмяКолонки, НовыйТекст);
		Иначе
			Строка[ИмяКолонки] = НовыйТекст;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура СобратьТекстыДляRegexОбъект(Результат, РегексКонтекст)
	// Получить включённые правила
	ВсеПравила = ПолучитьRegexПравилаИзХранилища();
	ВключённыеПравила = Новый Массив;
	Для Каждого Правило Из ВсеПравила Цикл
		Если ТипЗнч(Правило) = Тип("Структура") И Правило.enabled = Истина Тогда
			ВключённыеПравила.Добавить(Новый Структура("pattern, category", Правило.pattern, Правило.category));
		КонецЕсли;
	КонецЦикла;
	Если ВключённыеПравила.Количество() = 0 Тогда
		РегексКонтекст.ЕстьТекстыДляRegex = Ложь;
		Возврат;
	КонецЕсли;
	МассивПравилJSON = Новый Массив;
	Для Каждого П Из ВключённыеПравила Цикл
		МассивПравилJSON.Добавить(Новый Структура("pattern, category", П.pattern, П.category));
	КонецЦикла;
	РегексКонтекст.ВключённыеПравилаJSON = ЗаписатьJSON2(МассивПравилJSON);

	Данные = Неопределено;
	Если НЕ (ТипЗнч(Результат) = Тип("Структура")
		И Результат.Свойство("data", Данные)
		И ТипЗнч(Данные) = Тип("Структура")) Тогда
		РегексКонтекст.ЕстьТекстыДляRegex = Ложь;
		Возврат;
	КонецЕсли;

	Схема = Неопределено;
	Если НЕ (Результат.Свойство("schema", Схема) И ТипЗнч(Схема) = Тип("Структура")) Тогда
		РегексКонтекст.ЕстьТекстыДляRegex = Ложь;
		Возврат;
	КонецЕсли;

	// Строим СоответствиеPolicy для основных полей
	СоответствиеPolicy = Новый Соответствие;
	Колонки = Неопределено;
	Если Схема.Свойство("columns", Колонки) И ТипЗнч(Колонки) = Тип("Массив") Тогда
		Для Каждого Колонка Из Колонки Цикл
			Если ТипЗнч(Колонка) <> Тип("Структура") Тогда Продолжить; КонецЕсли;
			ИмяКолРег = "";
			Если НЕ Колонка.Свойство("name", ИмяКолРег) Тогда Продолжить; КонецЕсли;
			МодРег = "default"; РефРег = "default";
			Колонка.Свойство("anonymization_mode",          МодРег);
			Колонка.Свойство("reference_presentation_mode", РефРег);
			СоответствиеPolicy.Вставить(ИмяКолРег, Новый Структура("mode, ref_mode", МодРег, РефРег));
		КонецЦикла;
	КонецЕсли;

	// Строим СоответствиеPolicyТЧ: имя ТЧ → СоответствиеPolicy колонок ТЧ
	СоответствиеPolicyТЧ = Новый Соответствие;
	ТабЧасти = Неопределено;
	Если Схема.Свойство("tabular_sections", ТабЧасти) И ТипЗнч(ТабЧасти) = Тип("Соответствие") Тогда
		Для Каждого КВПТЧ Из ТабЧасти Цикл
			СхемаТЧ = КВПТЧ.Значение;
			PolicyТЧМп = Новый Соответствие;
			Если ТипЗнч(СхемаТЧ) = Тип("Структура") Тогда
				КолонкиТЧ = Неопределено;
				Если СхемаТЧ.Свойство("columns", КолонкиТЧ) И ТипЗнч(КолонкиТЧ) = Тип("Массив") Тогда
					Для Каждого КолТЧ Из КолонкиТЧ Цикл
						Если ТипЗнч(КолТЧ) <> Тип("Структура") Тогда Продолжить; КонецЕсли;
						ИмяКолТЧРег = "";
						Если НЕ КолТЧ.Свойство("name", ИмяКолТЧРег) Тогда Продолжить; КонецЕсли;
						МодТЧРег = "default"; РефТЧРег = "default";
						КолТЧ.Свойство("anonymization_mode",          МодТЧРег);
						КолТЧ.Свойство("reference_presentation_mode", РефТЧРег);
						PolicyТЧМп.Вставить(ИмяКолТЧРег, Новый Структура("mode, ref_mode", МодТЧРег, РефТЧРег));
					КонецЦикла;
				КонецЕсли;
			КонецЕсли;
			СоответствиеPolicyТЧ.Вставить(КВПТЧ.Ключ, PolicyТЧМп);
		КонецЦикла;
	КонецЕсли;

	ТекстыМассив    = Новый Массив;
	МаппингИндексов = Новый Массив;

	// Обходим поля data (Структура)
	Для Каждого КВП Из Данные Цикл
		ИмяПоля = КВП.Ключ;
		Значение = КВП.Значение;

		// Проверяем: это ТЧ?
		PolicyТЧ = СоответствиеPolicyТЧ.Получить(ИмяПоля);
		Если PolicyТЧ <> Неопределено И ТипЗнч(Значение) = Тип("Массив") Тогда
			// Обход строк ТЧ
			Для ИндексСтроки = 0 По Значение.Количество() - 1 Цикл
				СтрТЧ = Значение[ИндексСтроки];
				Если ТипЗнч(СтрТЧ) <> Тип("Структура") И ТипЗнч(СтрТЧ) <> Тип("Соответствие") Тогда
					Продолжить;
				КонецЕсли;
				Для Каждого КВПСтр Из СтрТЧ Цикл
					ИмяКолТЧ   = КВПСтр.Ключ;
					ЗначениеТЧ = КВПСтр.Значение;
					PolicyКолТЧ = PolicyТЧ.Получить(ИмяКолТЧ);
					МодТЧ = "default"; РефТЧ = "default";
					Если ТипЗнч(PolicyКолТЧ) = Тип("Структура") Тогда
						PolicyКолТЧ.Свойство("mode",     МодТЧ);
						PolicyКолТЧ.Свойство("ref_mode", РефТЧ);
					КонецЕсли;
					Если МодТЧ = "force_keep" Тогда Продолжить; КонецЕсли;
					Если ТипЗнч(ЗначениеТЧ) = Тип("Строка") Тогда
						ТекстыМассив.Добавить(ЗначениеТЧ);
						МаппингИндексов.Добавить(Новый Структура("Уровень, ИмяТЧ, ИндексСтроки, ИмяКолонки, ТипЗначения",
							"тч", ИмяПоля, ИндексСтроки, ИмяКолТЧ, "Строка"));
					ИначеЕсли (ТипЗнч(ЗначениеТЧ) = Тип("Структура") И ЗначениеТЧ.Свойство("Представление"))
						ИЛИ (ТипЗнч(ЗначениеТЧ) = Тип("Соответствие") И ЗначениеТЧ["Представление"] <> Неопределено) Тогда
						ТипОбъектаТЧ = "";
						Если ТипЗнч(ЗначениеТЧ) = Тип("Структура") Тогда
							ЗначениеТЧ.Свойство("ТипОбъекта", ТипОбъектаТЧ);
						Иначе
							ТипОбъектаТЧ = ?(ЗначениеТЧ["ТипОбъекта"] <> Неопределено, ЗначениеТЧ["ТипОбъекта"], "");
						КонецЕсли;
						РазрешеноТЧ = НЕ (Найти(ТипОбъектаТЧ, "ПеречислениеСсылка.") = 1)
							И НЕ (Найти(ТипОбъектаТЧ, "ПланСчетовСсылка.") = 1
								И РефТЧ <> "force_anonymize" И МодТЧ <> "force_anonymize")
							И НЕ (РефТЧ = "force_keep");
						ПредставлениеТЧ = ?(ТипЗнч(ЗначениеТЧ) = Тип("Структура"),
							ЗначениеТЧ.Представление, ЗначениеТЧ["Представление"]);
						Если РазрешеноТЧ И ТипЗнч(ПредставлениеТЧ) = Тип("Строка") Тогда
							ТекстыМассив.Добавить(ПредставлениеТЧ);
							МаппингИндексов.Добавить(Новый Структура("Уровень, ИмяТЧ, ИндексСтроки, ИмяКолонки, ТипЗначения",
								"тч", ИмяПоля, ИндексСтроки, ИмяКолТЧ, "Представление"));
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
			Продолжить;
		КонецЕсли;

		// Обычное поле (не ТЧ)
		PolicyПоля = СоответствиеPolicy.Получить(ИмяПоля);
		МодПоля = "default"; РефПоля = "default";
		Если ТипЗнч(PolicyПоля) = Тип("Структура") Тогда
			PolicyПоля.Свойство("mode",     МодПоля);
			PolicyПоля.Свойство("ref_mode", РефПоля);
		КонецЕсли;
		Если МодПоля = "force_keep" Тогда Продолжить; КонецЕсли;

		Если ТипЗнч(Значение) = Тип("Строка") Тогда
			ТекстыМассив.Добавить(Значение);
			МаппингИндексов.Добавить(Новый Структура("Уровень, ИмяПоля, ТипЗначения",
				"поле", ИмяПоля, "Строка"));
		ИначеЕсли (ТипЗнч(Значение) = Тип("Структура") И Значение.Свойство("Представление"))
			ИЛИ (ТипЗнч(Значение) = Тип("Соответствие") И Значение["Представление"] <> Неопределено) Тогда
			ТипОбъектаПоля = "";
			Если ТипЗнч(Значение) = Тип("Структура") Тогда
				Значение.Свойство("ТипОбъекта", ТипОбъектаПоля);
			Иначе
				ТипОбъектаПоля = ?(Значение["ТипОбъекта"] <> Неопределено, Значение["ТипОбъекта"], "");
			КонецЕсли;
			РазрешеноПоле = НЕ (Найти(ТипОбъектаПоля, "ПеречислениеСсылка.") = 1)
				И НЕ (Найти(ТипОбъектаПоля, "ПланСчетовСсылка.") = 1
					И РефПоля <> "force_anonymize" И МодПоля <> "force_anonymize")
				И НЕ (РефПоля = "force_keep");
			ПредставлениеПоля = ?(ТипЗнч(Значение) = Тип("Структура"),
				Значение.Представление, Значение["Представление"]);
			Если РазрешеноПоле И ТипЗнч(ПредставлениеПоля) = Тип("Строка") Тогда
				ТекстыМассив.Добавить(ПредставлениеПоля);
				МаппингИндексов.Добавить(Новый Структура("Уровень, ИмяПоля, ТипЗначения",
					"поле", ИмяПоля, "Представление"));
			КонецЕсли;
		ИначеЕсли ТипЗнч(Значение) = Тип("Массив") И МодПоля <> "force_keep" Тогда
			// Реквизит типа ФиксированныйМассив (строки или ссылки)
			Для ЭлтИнд = 0 По Значение.Количество() - 1 Цикл
				Элт = Значение[ЭлтИнд];
				Если ТипЗнч(Элт) = Тип("Строка") Тогда
					ТекстыМассив.Добавить(Элт);
					МаппингИндексов.Добавить(Новый Структура("Уровень, ИмяПоля, ИндексЭлемента, ТипЗначения",
						"поле_массив", ИмяПоля, ЭлтИнд, "Строка"));
				ИначеЕсли ТипЗнч(Элт) = Тип("Структура") И Элт.Свойство("Представление") Тогда
					ТипОбъектаЭлт = "";
					Элт.Свойство("ТипОбъекта", ТипОбъектаЭлт);
					РазрешеноЭлт = НЕ (Найти(ТипОбъектаЭлт, "ПеречислениеСсылка.") = 1)
						И НЕ (Найти(ТипОбъектаЭлт, "ПланСчетовСсылка.") = 1
							И РефПоля <> "force_anonymize" И МодПоля <> "force_anonymize")
						И НЕ (РефПоля = "force_keep");
					Если РазрешеноЭлт И ТипЗнч(Элт.Представление) = Тип("Строка") Тогда
						ТекстыМассив.Добавить(Элт.Представление);
						МаппингИндексов.Добавить(Новый Структура("Уровень, ИмяПоля, ИндексЭлемента, ТипЗначения",
							"поле_массив", ИмяПоля, ЭлтИнд, "Представление"));
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;

	Если ТекстыМассив.Количество() = 0 Тогда
		РегексКонтекст.ЕстьТекстыДляRegex = Ложь;
		Возврат;
	КонецЕсли;

	РегексКонтекст.ТекстыJSON         = ЗаписатьJSON2(ТекстыМассив);
	РегексКонтекст.МаппингИндексов    = МаппингИндексов;
	РегексКонтекст.ЕстьТекстыДляRegex = Истина;
КонецПроцедуры

Процедура ПрименитьRegexТокеныОбъект(РегексКонтекст, СовпаденияJSON)
	Если НЕ ЗначениеЗаполнено(СовпаденияJSON) Тогда Возврат; КонецЕсли;

	РезСовпадений = Неопределено;
	Попытка
		РезСовпадений = ПрочитатьJSON2(СовпаденияJSON);
	Исключение
		Возврат;
	КонецПопытки;
	Если ТипЗнч(РезСовпадений) <> Тип("Массив") Тогда Возврат; КонецЕсли;

	МаппингИндексов = РегексКонтекст.МаппингИндексов;
	Данные = РегексКонтекст.Результат.data;
	Если ТипЗнч(Данные) <> Тип("Структура") Тогда Возврат; КонецЕсли;

	Для ТекстИнд = 0 По РезСовпадений.Количество() - 1 Цикл
		Если ТекстИнд >= МаппингИндексов.Количество() Тогда Прервать; КонецЕсли;
		ЭлСовпадений = РезСовпадений[ТекстИнд];
		Если ТипЗнч(ЭлСовпадений) <> Тип("Массив") Или ЭлСовпадений.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		МаппингЭлт = МаппингИндексов[ТекстИнд];
		Уровень    = "";
		МаппингЭлт.Свойство("Уровень", Уровень);
		ТипЗнчения = МаппингЭлт.ТипЗначения;

		// Получить текущее текстовое значение
		ТекущийТекст = Неопределено;
		Если Уровень = "поле" Тогда
			ЗначениеПоля = Неопределено;
			Если НЕ Данные.Свойство(МаппингЭлт.ИмяПоля, ЗначениеПоля) Тогда Продолжить; КонецЕсли;
			Если ТипЗнчения = "Представление" Тогда
				Если ТипЗнч(ЗначениеПоля) = Тип("Структура") И ЗначениеПоля.Свойство("Представление") Тогда
					ТекущийТекст = ЗначениеПоля.Представление;
				ИначеЕсли ТипЗнч(ЗначениеПоля) = Тип("Соответствие") Тогда
					ТекущийТекст = ЗначениеПоля["Представление"];
				КонецЕсли;
			Иначе
				Если ТипЗнч(ЗначениеПоля) = Тип("Строка") Тогда
					ТекущийТекст = ЗначениеПоля;
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли Уровень = "тч" Тогда
			МассивТЧ = Неопределено;
			Если НЕ Данные.Свойство(МаппингЭлт.ИмяТЧ, МассивТЧ) Тогда Продолжить; КонецЕсли;
			Если ТипЗнч(МассивТЧ) <> Тип("Массив") Тогда Продолжить; КонецЕсли;
			Если МаппингЭлт.ИндексСтроки >= МассивТЧ.Количество() Тогда Продолжить; КонецЕсли;
			СтрокаТЧ = МассивТЧ[МаппингЭлт.ИндексСтроки];
			Если ТипЗнч(СтрокаТЧ) = Тип("Структура") Тогда
				ЗначениеТЧ = Неопределено;
				Если НЕ СтрокаТЧ.Свойство(МаппингЭлт.ИмяКолонки, ЗначениеТЧ) Тогда Продолжить; КонецЕсли;
			ИначеЕсли ТипЗнч(СтрокаТЧ) = Тип("Соответствие") Тогда
				ЗначениеТЧ = СтрокаТЧ[МаппингЭлт.ИмяКолонки];
			Иначе
				Продолжить;
			КонецЕсли;
			Если ТипЗнчения = "Представление" Тогда
				Если ТипЗнч(ЗначениеТЧ) = Тип("Структура") И ЗначениеТЧ.Свойство("Представление") Тогда
					ТекущийТекст = ЗначениеТЧ.Представление;
				ИначеЕсли ТипЗнч(ЗначениеТЧ) = Тип("Соответствие") Тогда
					ТекущийТекст = ЗначениеТЧ["Представление"];
				КонецЕсли;
			Иначе
				Если ТипЗнч(ЗначениеТЧ) = Тип("Строка") Тогда
					ТекущийТекст = ЗначениеТЧ;
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли Уровень = "поле_массив" Тогда
			МассивПоля = Неопределено;
			Если НЕ Данные.Свойство(МаппингЭлт.ИмяПоля, МассивПоля) Тогда Продолжить; КонецЕсли;
			Если ТипЗнч(МассивПоля) <> Тип("Массив") Тогда Продолжить; КонецЕсли;
			Если МаппингЭлт.ИндексЭлемента >= МассивПоля.Количество() Тогда Продолжить; КонецЕсли;
			Элт = МассивПоля[МаппингЭлт.ИндексЭлемента];
			Если ТипЗнчения = "Представление" Тогда
				Если ТипЗнч(Элт) = Тип("Структура") И Элт.Свойство("Представление") Тогда
					ТекущийТекст = Элт.Представление;
				КонецЕсли;
			Иначе
				Если ТипЗнч(Элт) = Тип("Строка") Тогда ТекущийТекст = Элт; КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Если ТипЗнч(ТекущийТекст) <> Тип("Строка") Тогда Продолжить; КонецЕсли;

		// Применяем совпадения справа налево
		НовыйТекст = ТекущийТекст;
		Для Каждого С Из ЭлСовпадений Цикл
			Категория = ""; МатчТекст = ""; Начало = 0; Длина = 0;
			Если ТипЗнч(С) = Тип("Структура") Тогда
				С.Свойство("category", Категория);
				С.Свойство("match",    МатчТекст);
				С.Свойство("start",    Начало);
				С.Свойство("length",   Длина);
			ИначеЕсли ТипЗнч(С) = Тип("Соответствие") Тогда
				Категория = С["category"];
				МатчТекст = С["match"];
				Начало    = С["start"];
				Длина     = С["length"];
			КонецЕсли;
			Если МатчТекст = Неопределено Тогда МатчТекст = ""; КонецЕсли;
			Если Начало    = Неопределено Тогда Начало    = 0;  КонецЕсли;
			Если Длина     = Неопределено Тогда Длина     = 0;  КонецЕсли;
			Если Категория = Неопределено Тогда Категория = ""; КонецЕсли;
			Если ПустаяСтрока(МатчТекст) Или Длина <= 0 Тогда Продолжить; КонецЕсли;
			Токен = АнонимизаторТокенизировать(МатчТекст, Категория);
			Если Начало >= 0 И (Начало + Длина) <= СтрДлина(НовыйТекст) Тогда
				НовыйТекст = Лев(НовыйТекст, Начало) + Токен + Сред(НовыйТекст, Начало + Длина + 1);
			КонецЕсли;
		КонецЦикла;

		// Записать обратно в объект
		Если Уровень = "поле" Тогда
			Если ТипЗнчения = "Представление" Тогда
				ЗначениеПоля2 = Неопределено;
				Данные.Свойство(МаппингЭлт.ИмяПоля, ЗначениеПоля2);
				Если ТипЗнч(ЗначениеПоля2) = Тип("Структура") Тогда
					ЗначениеПоля2.Вставить("Представление", НовыйТекст);
				ИначеЕсли ТипЗнч(ЗначениеПоля2) = Тип("Соответствие") Тогда
					ЗначениеПоля2["Представление"] = НовыйТекст;
				КонецЕсли;
			Иначе
				Данные.Вставить(МаппингЭлт.ИмяПоля, НовыйТекст);
			КонецЕсли;
		ИначеЕсли Уровень = "тч" Тогда
			МассивТЧОбр = Неопределено;
			Данные.Свойство(МаппингЭлт.ИмяТЧ, МассивТЧОбр);
			Если ТипЗнч(МассивТЧОбр) <> Тип("Массив") Тогда Продолжить; КонецЕсли;
			Если МаппингЭлт.ИндексСтроки >= МассивТЧОбр.Количество() Тогда Продолжить; КонецЕсли;
			СтрокаТЧОбр = МассивТЧОбр[МаппингЭлт.ИндексСтроки];
			Если ТипЗнчения = "Представление" Тогда
				ЗначениеТЧОбр = Неопределено;
				Если ТипЗнч(СтрокаТЧОбр) = Тип("Структура") Тогда
					СтрокаТЧОбр.Свойство(МаппингЭлт.ИмяКолонки, ЗначениеТЧОбр);
					Если ТипЗнч(ЗначениеТЧОбр) = Тип("Структура") Тогда
						ЗначениеТЧОбр.Вставить("Представление", НовыйТекст);
					КонецЕсли;
				ИначеЕсли ТипЗнч(СтрокаТЧОбр) = Тип("Соответствие") Тогда
					ЗначениеТЧОбр = СтрокаТЧОбр[МаппингЭлт.ИмяКолонки];
					Если ТипЗнч(ЗначениеТЧОбр) = Тип("Структура") Тогда
						ЗначениеТЧОбр.Вставить("Представление", НовыйТекст);
					ИначеЕсли ТипЗнч(ЗначениеТЧОбр) = Тип("Соответствие") Тогда
						ЗначениеТЧОбр["Представление"] = НовыйТекст;
					КонецЕсли;
				КонецЕсли;
			Иначе
				Если ТипЗнч(СтрокаТЧОбр) = Тип("Структура") Тогда
					СтрокаТЧОбр.Вставить(МаппингЭлт.ИмяКолонки, НовыйТекст);
				ИначеЕсли ТипЗнч(СтрокаТЧОбр) = Тип("Соответствие") Тогда
					СтрокаТЧОбр[МаппингЭлт.ИмяКолонки] = НовыйТекст;
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли Уровень = "поле_массив" Тогда
			МассивПоляОбр = Неопределено;
			Данные.Свойство(МаппингЭлт.ИмяПоля, МассивПоляОбр);
			Если ТипЗнч(МассивПоляОбр) <> Тип("Массив") Тогда Продолжить; КонецЕсли;
			Если МаппингЭлт.ИндексЭлемента >= МассивПоляОбр.Количество() Тогда Продолжить; КонецЕсли;
			ЭлтОбр = МассивПоляОбр[МаппингЭлт.ИндексЭлемента];
			Если ТипЗнчения = "Представление" Тогда
				Если ТипЗнч(ЭлтОбр) = Тип("Структура") И ЭлтОбр.Свойство("Представление") Тогда
					ЭлтОбр.Вставить("Представление", НовыйТекст);
				КонецЕсли;
			Иначе
				МассивПоляОбр[МаппингЭлт.ИндексЭлемента] = НовыйТекст;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ПолучитьСтроковоеПредставлениеТипаДляСхемы(Тип)
	
	// Используем существующую функцию ЭтоСсылка для проверки ссылочного типа
	// и существующую СтроковоеПредставлениеТипа для получения полного имени
	
	Если ЭтоСсылка(Тип) Тогда
		// Для ссылочных типов используем СтроковоеПредставлениеТипа
		// Возвращает полное имя: "СправочникСсылка.Контрагенты"
		Возврат СтроковоеПредставлениеТипа(Тип);
	Иначе
		// Для примитивных типов используем Строка(Тип)
		// Возвращает: "Строка", "Число", "Дата", "Булево"
		Возврат Строка(Тип);
	КонецЕсли;
	
КонецФункции

Функция РазделитьСтрокуПоРазделителю(Строка, Разделитель)
	
	Результат = Новый Массив;
	ОстатокСтроки = Строка;
	
	ПозицияРазделителя = Найти(ОстатокСтроки, Разделитель);
	
	Пока ПозицияРазделителя > 0 Цикл
		Часть = Лев(ОстатокСтроки, ПозицияРазделителя - 1);
		Результат.Добавить(Часть);
		ОстатокСтроки = Сред(ОстатокСтроки, ПозицияРазделителя + СтрДлина(Разделитель));
		ПозицияРазделителя = Найти(ОстатокСтроки, Разделитель);
	КонецЦикла;
	
	// Добавляем последнюю часть (или всю строку, если разделитель не найден)
	Результат.Добавить(ОстатокСтроки);
	
	Возврат Результат;
	
КонецФункции

Функция ЭтоСсылка(ПроверяемыйТип)
	
	Если ПроверяемыйТип = Тип("Неопределено") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Справочники.ТипВсеСсылки().СодержитТип(ПроверяемыйТип)
		Или Документы.ТипВсеСсылки().СодержитТип(ПроверяемыйТип)
		Или Перечисления.ТипВсеСсылки().СодержитТип(ПроверяемыйТип)
		Или ПланыВидовХарактеристик.ТипВсеСсылки().СодержитТип(ПроверяемыйТип)
		Или ПланыСчетов.ТипВсеСсылки().СодержитТип(ПроверяемыйТип)
		Или ПланыВидовРасчета.ТипВсеСсылки().СодержитТип(ПроверяемыйТип)
		Или БизнесПроцессы.ТипВсеСсылки().СодержитТип(ПроверяемыйТип)
		Или Задачи.ТипВсеСсылки().СодержитТип(ПроверяемыйТип)
		Или ПланыОбмена.ТипВсеСсылки().СодержитТип(ПроверяемыйТип);
	
КонецФункции

Функция СтроковоеПредставлениеТипа(Тип)
	
	Если Не ЭтоСсылка(Тип) Тогда
		Возврат Строка(Тип);
	КонецЕсли;
	
	ПолноеИмя = Метаданные.НайтиПоТипу(Тип).ПолноеИмя();
	ЧастиИмени = РазделитьСтрокуПоРазделителю(ПолноеИмя, ".");
	
	Если ЧастиИмени.Количество() < 2 Тогда
		Возврат Строка(Тип);
	КонецЕсли;
	
	ИмяОбъекта = ЧастиИмени[1];
	
	Если Справочники.ТипВсеСсылки().СодержитТип(Тип) Тогда
		Возврат "СправочникСсылка." + ИмяОбъекта;
	ИначеЕсли Документы.ТипВсеСсылки().СодержитТип(Тип) Тогда
		Возврат "ДокументСсылка." + ИмяОбъекта;
	ИначеЕсли Перечисления.ТипВсеСсылки().СодержитТип(Тип) Тогда
		Возврат "ПеречислениеСсылка." + ИмяОбъекта;
	ИначеЕсли ПланыВидовХарактеристик.ТипВсеСсылки().СодержитТип(Тип) Тогда
		Возврат "ПланВидовХарактеристикСсылка." + ИмяОбъекта;
