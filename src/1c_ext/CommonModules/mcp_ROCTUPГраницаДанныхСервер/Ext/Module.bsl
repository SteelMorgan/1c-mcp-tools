//++agent TASK-221 [23.09.2026 11:05:00]
Процедура ПрименитьСекретностьИсточникаКРезультатуЗапроса(Результат, Схема)

	Данные = Свойство(Результат, "data", Неопределено);
	Колонки = Свойство(Схема, "columns", Неопределено);
	Если ТипЗнч(Данные) <> Тип("Массив") Или ТипЗнч(Колонки) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Колонка Из Колонки Цикл
		Если Не КолонкаСодержитСекрет(Колонка) Тогда
			Продолжить;
		КонецЕсли;
		ИмяКолонки = Свойство(Колонка, "name", "");
		Если ПустаяСтрока(ИмяКолонки) Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого СтрокаДанных Из Данные Цикл
			Если ТипЗнч(СтрокаДанных) = Тип("Структура")
				Или ТипЗнч(СтрокаДанных) = Тип("Соответствие") Тогда
				ИсходноеЗначение = Неопределено;
				Если СтрокаДанных.Свойство(ИмяКолонки, ИсходноеЗначение) Тогда
					СтрокаДанных.Вставить(ИмяКолонки, "[SECRET_REMOVED]");
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Процедура ПрименитьРежимПароляКОбъекту(Результат)

	Данные = Свойство(Результат, "data", Неопределено);
	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;

	ПолноеИмяОбъекта = Свойство(Данные, "_type", "");
	Если ПустаяСтрока(ПолноеИмяОбъекта) Тогда
		Возврат;
	КонецЕсли;

	ОбъектМетаданных = Неопределено;
	Попытка
		ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ПолноеИмяОбъекта);
	Исключение
		Возврат;
	КонецПопытки;
	Если ОбъектМетаданных = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Реквизит Из ОбъектМетаданных.Реквизиты Цикл
		Если РежимПароляЭлементаМетаданных(Реквизит) Тогда
			Если Данные.Свойство(Реквизит.Имя) Тогда
				Данные.Вставить(Реквизит.Имя, "[SECRET_REMOVED]");
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Для Каждого ТабличнаяЧасть Из ОбъектМетаданных.ТабличныеЧасти Цикл
		СтрокиТабличнойЧасти = Свойство(Данные, ТабличнаяЧасть.Имя, Неопределено);
		Если ТипЗнч(СтрокиТабличнойЧасти) <> Тип("Массив") Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Реквизит Из ТабличнаяЧасть.Реквизиты Цикл
			Если Не РежимПароляЭлементаМетаданных(Реквизит) Тогда
				Продолжить;
			КонецЕсли;
			Для Каждого СтрокаТабличнойЧасти Из СтрокиТабличнойЧасти Цикл
				Если ТипЗнч(СтрокаТабличнойЧасти) = Тип("Структура")
					И СтрокаТабличнойЧасти.Свойство(Реквизит.Имя) Тогда
					СтрокаТабличнойЧасти.Вставить(Реквизит.Имя, "[SECRET_REMOVED]");
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Процедура РедактироватьСекретыРекурсивно(Значение, ИмяПоля, Глубина)

	Если Глубина > 20 Тогда
		ВызватьИсключение "SECRET_SCAN_DEPTH_LIMIT";
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Структура")
		Или ТипЗнч(Значение) = Тип("Соответствие") Тогда
		Для Каждого Пара Из Значение Цикл
			Если ЭтоИмяСекрета(Пара.Ключ) Тогда
				Значение.Вставить(Пара.Ключ, "[SECRET_REMOVED]");
			ИначеЕсли ТипЗнч(Пара.Значение) = Тип("Строка") И СодержитСекретВТексте(Пара.Значение) Тогда
				Значение.Вставить(Пара.Ключ, "[SECRET_REMOVED]");
			Иначе
				РедактироватьСекретыРекурсивно(Пара.Значение, Пара.Ключ, Глубина + 1);
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Тогда
		Для Индекс = 0 По Значение.Количество() - 1 Цикл
			Элемент = Значение[Индекс];
			Если ТипЗнч(Элемент) = Тип("Строка") И СодержитСекретВТексте(Элемент) Тогда
				Значение[Индекс] = "[SECRET_REMOVED]";
			Иначе
				РедактироватьСекретыРекурсивно(Элемент, ИмяПоля, Глубина + 1);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

Функция ЭтоИмяСекрета(ИмяПоля)
	НормализованноеИмя = НРег(СтрЗаменить(СтрЗаменить(Строка(ИмяПоля), "_", ""), "-", ""));
	Для Каждого Маркер Из СтрРазделить(
		"пароль,password,passwd,passphrase,секретнаяфраза,token,токен,authorization,авторизац,apikey,ключapi,ключапи,secret,секрет,privatekey,accesskey,refreshkey", ",") Цикл
		Если Найти(НормализованноеИмя, Маркер) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция СодержитСекретВТексте(Текст)
	НормализованныйТекст = НРег(Строка(Текст));
	Для Каждого Маркер Из СтрРазделить(
		"authorization:,bearer ,пароль=,password=,passwd=,passphrase=,access_token,refresh_token,api_key,private_key,-----begin private key-----,-----begin rsa private key-----", ",") Цикл
		Если Найти(НормализованныйТекст, Маркер) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции
