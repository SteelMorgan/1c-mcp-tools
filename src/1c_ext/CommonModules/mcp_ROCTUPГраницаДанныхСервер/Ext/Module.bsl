//++agent TASK-225 [25.09.2026 13:30:00]
// Разбор запроса только по объектам платформы: СхемаЗапроса даёт синтаксис,
// Запрос.Параметры - фактические значения параметров. Возвращает допустимость
// источников пакета и допуски колонок, безопасных без источников.
Функция АнализЗапросаГраницы(ТекстЗапроса, КолонкиРезультата, ПараметрыВызова)

	Результат = Новый Структура(
		"ИсточникиДопустимы, ДопускиКолонок, ЕстьУпоминаниеСекрета,"
		+ " ВосстановленныеИсточники",
		Ложь, Новый Соответствие, Ложь, Новый Соответствие);

	Если ПустаяСтрока(ТекстЗапроса) Тогда
		Возврат Результат;
	КонецЕсли;

	Попытка
		СхемаЗапроса = Новый СхемаЗапроса;
		СхемаЗапроса.УстановитьТекстЗапроса(ТекстЗапроса);
	Исключение
		// Исполненный платформой запрос обязан разбираться СхемаЗапроса;
		// неразобранный текст - аномалия, происхождение не доказано.
		Возврат Результат;
	КонецПопытки;

	// Фактические значения параметров нужны и скану секретов (разыменование
	// ссылок-параметров), и допускам безисточниковых колонок.
	ПараметрыЗапроса = ПараметрыГраницыДляПроверки(ПараметрыВызова);

	// Реквизит-секрет в любом месте пакета (ГДЕ, соединения, порядок,
	// группировка, итоги, индексы, вложенные запросы) - немедленный отказ,
	// вне зависимости от того, что возвращает выборка.
	Для Каждого ЗапросПакета Из СхемаЗапроса.ПакетЗапросов Цикл
		Если ТипЗнч(ЗапросПакета) <> Тип("ЗапросВыбораСхемыЗапроса") Тогда
			Продолжить;
		КонецЕсли;
		Если ЗапросСодержитСекретныйРеквизит(ЗапросПакета, ПараметрыЗапроса) Тогда
			Результат.ЕстьУпоминаниеСекрета = Истина;
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;

	// Имена временных таблиц, созданных ПОМЕСТИТЬ внутри этого же пакета.
	ИменаВременныхТаблиц = Новый Соответствие;
	Для Каждого ЗапросПакета Из СхемаЗапроса.ПакетЗапросов Цикл
		Если ТипЗнч(ЗапросПакета) = Тип("ЗапросВыбораСхемыЗапроса")
			И Не ПустаяСтрока(ЗапросПакета.ТаблицаДляПомещения) Тогда
			ИменаВременныхТаблиц.Вставить(
				ВРег(ЗапросПакета.ТаблицаДляПомещения), Истина);
		КонецЕсли;
	КонецЦикла;

	Для Каждого ЗапросПакета Из СхемаЗапроса.ПакетЗапросов Цикл
		Если ТипЗнч(ЗапросПакета) <> Тип("ЗапросВыбораСхемыЗапроса") Тогда
			Продолжить;
		КонецЕсли;
		Если Не ИсточникиЗапросаДопустимы(ЗапросПакета, ИменаВременныхТаблиц, 0) Тогда
			// Временная таблица-источник не создана в этом пакете (на любом
			// уровне вложенности): питается только внешним МенеджерВременныхТаблиц.
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;
	Результат.ИсточникиДопустимы = Истина;

	// Запрос, производящий результат - последний элемент пакета. Допуск
	// безисточниковых колонок вычисляется только для одиночного запроса
	// выбора: в пакете происхождение прячется за границей временных таблиц.
	// Резолв голых полей по метаданным источников допустим и в пакете -
	// он только доказывает происхождение, ничего не ослабляя.
	ЗапросРезультата = СхемаЗапроса.ПакетЗапросов[
		СхемаЗапроса.ПакетЗапросов.Количество() - 1];
	Если ТипЗнч(ЗапросРезультата) <> Тип("ЗапросВыбораСхемыЗапроса")
		Или Не ПустаяСтрока(ЗапросРезультата.ТаблицаДляПомещения)
		Или Не ПустаяСтрока(ЗапросРезультата.ТаблицаДляДобавления)
		Или ЗапросРезультата.Колонки.Количество()
			<> КолонкиРезультата.Количество() Тогда
		Возврат Результат;
	КонецЕсли;

	ЕдинственныйЗапрос = СхемаЗапроса.ПакетЗапросов.Количество() = 1;
	Для ИндексКолонки = 0 По ЗапросРезультата.Колонки.Количество() - 1 Цикл
		Если ЕдинственныйЗапрос Тогда
			Допуск = ДопускКолонкиБезИсточников(
				ЗапросРезультата.Колонки[ИндексКолонки], ПараметрыЗапроса);
			Если Допуск <> Неопределено Тогда
				Результат.ДопускиКолонок.Вставить(ИндексКолонки, Допуск);
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		ПутиИсточников = ВосстановитьИсточникиГолыхПолей(
			ЗапросРезультата, ИндексКолонки);
		Если ПутиИсточников <> Неопределено Тогда
			Результат.ВосстановленныеИсточники.Вставить(
				ИндексКолонки, ПутиИсточников);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Источник запроса допустим, если это таблица метаданных (реальная или
// виртуальная), вложенный запрос, таблица-параметр или временная таблица,
// созданная ПОМЕСТИТЬ в этом же пакете.
Функция ИсточникЗапросаДопустим(Источник, ИменаВременныхТаблиц)

	Попытка
		ТаблицаИсточника = Источник.Источник;
	Исключение
		Возврат Ложь;
	КонецПопытки;

	ТипИсточника = ТипЗнч(ТаблицаИсточника);
	Если ТипИсточника = Тип("ВложенныйЗапросСхемыЗапроса") Тогда
		// Вложенный запрос развёрнут внутри пакета, внешнему менеджеру нечего дать.
		Возврат Истина;
	ИначеЕсли ТипИсточника = Тип("ОписаниеВременнойТаблицыСхемыЗапроса") Тогда
		// Описание временной таблицы - это ИЗ ВремТаб или ИЗ &ТЗ. Таблица-
		// параметр - жёсткий отказ: её колонки не имеют проверяемого
		// происхождения. Временная таблица обязана быть создана ПОМЕСТИТЬ
		// в этом же пакете.
		ИмяОписания = ТаблицаИсточника.ИмяТаблицы;
		Если Лев(ИмяОписания, 1) = "&" Тогда
			Возврат Ложь;
		КонецЕсли;
		Возврат ИменаВременныхТаблиц[ВРег(ИмяОписания)] = Истина;
	ИначеЕсли ТипИсточника <> Тип("ТаблицаСхемыЗапроса") Тогда
		// Неизвестный тип источника - происхождение не доказано.
		Возврат Ложь;
	КонецЕсли;

	ИмяТаблицы = ТаблицаИсточника.ИмяТаблицы;
	Если Лев(ИмяТаблицы, 1) = "&" Тогда
		// Таблица-параметр (&ТЗ): жёсткий отказ в любом режиме.
		Возврат Ложь;
	КонецЕсли;

	ЧастиИмени = СтрРазделить(ИмяТаблицы, ".", Ложь);
	Если ЧастиИмени.Количество() >= 2
		И Метаданные.НайтиПоПолномуИмени(ЧастиИмени[0] + "." + ЧастиИмени[1]) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	// Одиночное имя без метаданных - имя временной таблицы. Она обязана быть
	// создана ПОМЕСТИТЬ в этом же пакете: внешнего менеджера у вызова нет.
	Возврат ИменаВременныхТаблиц[ВРег(ИмяТаблицы)] = Истина;

КонецФункции

// Источники операторов запроса выбора: проверяются сами, соединённые к ним
// источники и источники вложенных запросов на любой глубине.
Функция ИсточникиЗапросаДопустимы(ЗапросВыбора, ИменаВременныхТаблиц, Глубина)

	Если Глубина > 8 Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого Оператор Из ЗапросВыбора.Операторы Цикл
		Если Не ИсточникиОператораДопустимы(
			Оператор.Источники, ИменаВременныхТаблиц, Глубина) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

Функция ИсточникиОператораДопустимы(Источники, ИменаВременныхТаблиц, Глубина)

	Если Глубина > 8 Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого Источник Из Источники Цикл
		Если Не ИсточникЗапросаДопустим(Источник, ИменаВременныхТаблиц) Тогда
			Возврат Ложь;
		КонецЕсли;
		ТаблицаИсточника = Неопределено;
		Попытка
			ТаблицаИсточника = Источник.Источник;
		Исключение
			Возврат Ложь;
		КонецПопытки;
		Попытка
			Для Каждого Соединение Из Источник.Соединения Цикл
				СвязанныеИсточники = Новый Массив;
				СвязанныеИсточники.Добавить(Соединение.Источник);
				Если Не ИсточникиОператораДопустимы(
					СвязанныеИсточники, ИменаВременныхТаблиц, Глубина + 1) Тогда
					Возврат Ложь;
				КонецЕсли;
			КонецЦикла;
		Исключение
			Возврат Ложь;
		КонецПопытки;
		Если ТипЗнч(ТаблицаИсточника) = Тип("ВложенныйЗапросСхемыЗапроса") Тогда
			Если Не ИсточникиЗапросаДопустимы(
				ТаблицаИсточника.Запрос, ИменаВременныхТаблиц, Глубина + 1) Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

// Фактические типы параметров - только из восстановленных значений вызова:
// objectRef из JSON уже превращён исполнителем в ссылку, поэтому примитивность
// доказывается по ТипЗнч значения, а не по форме параметра в JSON.
Функция ПараметрыГраницыДляПроверки(ПараметрыВызова)

	Результат = Новый Соответствие;
	Если ТипЗнч(ПараметрыВызова) = Тип("Соответствие")
		Или ТипЗнч(ПараметрыВызова) = Тип("Структура") Тогда
		Для Каждого Параметр Из ПараметрыВызова Цикл
			Результат.Вставить(Строка(Параметр.Ключ), Параметр.Значение);
		КонецЦикла;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Имя типа примитивного значения параметра; непримитивное (ссылка, массив,
// таблица значений, структура) - Неопределено, то есть небезопасно.
Функция ТипПараметраЗапроса(ПараметрыЗапроса, ИмяПараметра)

	Для Каждого ПараметрЗапроса Из ПараметрыЗапроса Цикл
		Если ВРег(ПараметрЗапроса.Ключ) <> ВРег(ИмяПараметра) Тогда
			Продолжить;
		КонецЕсли;
		ТипЗначения = ТипЗнч(ПараметрЗапроса.Значение);
		Если ТипЗначения = Тип("Строка") Тогда
			Возврат "Строка";
		ИначеЕсли ТипЗначения = Тип("Число") Тогда
			Возврат "Число";
		ИначеЕсли ТипЗначения = Тип("Дата") Тогда
			Возврат "Дата";
		ИначеЕсли ТипЗначения = Тип("Булево") Тогда
			Возврат "Булево";
		ИначеЕсли ТипЗначения = Тип("Неопределено") Тогда
			Возврат "Неопределено";
		ИначеЕсли ТипЗначения = Тип("Null") Тогда
			Возврат "Null";
		КонецЕсли;
		Возврат Неопределено;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Допуск колонки без источников: все её выражения во всех операторах
// объединения обязаны быть безполевыми, а каждый параметр - примитивным.
Функция ДопускКолонкиБезИсточников(КолонкаЗапроса, ПараметрыЗапроса)

	Если КолонкаЗапроса.Поля.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	ДопустимыеТипы = Новый Соответствие;
	ВидыАтомов = Новый Массив;
	Композитно = Ложь;
	Для Каждого ПолеКолонки Из КолонкаЗапроса.Поля Цикл
		Если ПолеКолонки = Неопределено Тогда
			// Часть объединения не поставляет значение - там NULL, безопасно.
			Продолжить;
		КонецЕсли;
		Если ТипЗнч(ПолеКолонки) <> Тип("ВыражениеСхемыЗапроса") Тогда
			// Вложенная таблица, звёздочка и прочее - выражение не доказано.
			Возврат Неопределено;
		КонецЕсли;
		Разбор = РазобратьБезполевоеВыражение(Строка(ПолеКолонки));
		Если Не Разбор.Безопасно Тогда
			Возврат Неопределено;
		КонецЕсли;
		Для Каждого ИмяПараметра Из Разбор.ИменаПараметров Цикл
			ТипПараметра = ТипПараметраЗапроса(ПараметрыЗапроса, ИмяПараметра);
			Если ТипПараметра = Неопределено Тогда
				Возврат Неопределено;
			КонецЕсли;
			ДопустимыеТипы.Вставить(ТипПараметра, Истина);
		КонецЦикла;
		Для Каждого ТипВыражения Из Разбор.ДопустимыеТипы Цикл
			ДопустимыеТипы.Вставить(ТипВыражения.Ключ, Истина);
		КонецЦикла;
		Для Каждого ВидАтома Из Разбор.ВидыАтомов Цикл
			ВидыАтомов.Добавить(ВидАтома);
		КонецЦикла;
		Композитно = Композитно Или Разбор.Композитно;
	КонецЦикла;

	// NULL допустим в любой доказанной колонке: пустое значение не несёт
	// содержимого полей базы.
	ДопустимыеТипы.Вставить("Null", Истина);

	// Вид допуска для контракта schema.columns[i].sourceless: атомы во всех
	// ветках объединения одного вида - этот вид; композиция атомов,
	// операторов или разных видов - composite.
	ВидДопуска = "composite";
	Если Не Композитно И ВидыАтомов.Количество() > 0 Тогда
		ОдинВид = Истина;
		Для Каждого ВидАтома Из ВидыАтомов Цикл
			Если ВидАтома <> ВидыАтомов[0] Тогда
				ОдинВид = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если ОдинВид Тогда
			ВидДопуска = ВидыАтомов[0];
		КонецЕсли;
	КонецЕсли;

	Возврат Новый Структура("ДопустимыеТипы, Вид", ДопустимыеТипы, ВидДопуска);

КонецФункции

// Разбор выражения колонки: безопасно, если встречаются только литералы,
// КОЛИЧЕСТВО, ЗНАЧЕНИЕ, ДАТАВРЕМЯ, простые параметры без разыменования и
// служебные слова выражения. Любое поле базы делает выражение недоказанным.
Функция РазобратьБезполевоеВыражение(ТекстВыражения)

	Разбор = Новый Структура(
		"Безопасно, ДопустимыеТипы, ИменаПараметров, ВидыАтомов, Композитно",
		Истина, Новый Соответствие, Новый Массив, Новый Массив, Ложь);

	Длина = СтрДлина(ТекстВыражения);
	Позиция = 1;
	Пока Позиция <= Длина Цикл
		Символ = Сред(ТекстВыражения, Позиция, 1);
		Если ЭтоПробельныйСимвол(Символ) Тогда
			Позиция = Позиция + 1;
		ИначеЕсли Символ = """" Тогда
			Позиция = ПропуститьСтроковыйЛитерал(ТекстВыражения, Позиция);
			Если Позиция = 0 Тогда
				Разбор.Безопасно = Ложь;
				Прервать;
			КонецЕсли;
			Разбор.ДопустимыеТипы.Вставить("Строка", Истина);
			Разбор.ВидыАтомов.Добавить("literal");
		ИначеЕсли ЭтоЦифра(Символ) Тогда
			ЕстьТочка = Ложь;
			Пока Позиция <= Длина Цикл
				ТекущийСимвол = Сред(ТекстВыражения, Позиция, 1);
				Если ЭтоЦифра(ТекущийСимвол) Тогда
					Позиция = Позиция + 1;
				ИначеЕсли ТекущийСимвол = "." И Не ЕстьТочка Тогда
					ЕстьТочка = Истина;
					Позиция = Позиция + 1;
				Иначе
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Разбор.ДопустимыеТипы.Вставить("Число", Истина);
			Разбор.ВидыАтомов.Добавить("literal");
		ИначеЕсли Символ = "&" Тогда
			ИмяПараметра = "";
			Позиция = ПрочитатьИдентификаторПосле(ТекстВыражения, Позиция + 1, ИмяПараметра);
			Если ПустаяСтрока(ИмяПараметра) Или Найти(ИмяПараметра, ".") > 0 Тогда
				// &П.Поле - разыменование параметра, читает реквизит из базы.
				Разбор.Безопасно = Ложь;
				Прервать;
			КонецЕсли;
			Разбор.ИменаПараметров.Добавить(ИмяПараметра);
			Разбор.ВидыАтомов.Добавить("parameter");
		ИначеЕсли ЭтоБукваИлиПодчерк(Символ) Тогда
			Идентификатор = "";
			Позиция = ПрочитатьИдентификаторПосле(ТекстВыражения, Позиция, Идентификатор);
			Если Найти(Идентификатор, ".") > 0 Тогда
				// Путь Таб.Поле - ссылка на поле источника.
				Разбор.Безопасно = Ложь;
				Прервать;
			КонецЕсли;
			ИмяВрег = ВРег(Идентификатор);
			Если СледующийНепробельный(ТекстВыражения, Позиция) = "(" Тогда
				ПозицияСкобки = ПозицияНепробельного(ТекстВыражения, Позиция);
				КонецСкобки = ПарнаяСкобка(ТекстВыражения, ПозицияСкобки);
				Если КонецСкобки = 0 Тогда
					Разбор.Безопасно = Ложь;
					Прервать;
				КонецЕсли;
				Содержимое = Сред(ТекстВыражения,
					ПозицияСкобки + 1, КонецСкобки - ПозицияСкобки - 1);
				Позиция = КонецСкобки + 1;
				Если ИмяВрег = "КОЛИЧЕСТВО" Тогда
					Если Не АргументСчётчикаДопустим(Содержимое) Тогда
						Разбор.Безопасно = Ложь;
						Прервать;
					КонецЕсли;
					Разбор.ДопустимыеТипы.Вставить("Число", Истина);
					Разбор.ВидыАтомов.Добавить("count");
				ИначеЕсли ИмяВрег = "ЗНАЧЕНИЕ" Тогда
					ТипЗначения = СсылочныйТипЗначенияИзАргумента(Содержимое);
					Если ТипЗначения = Неопределено Тогда
						Разбор.Безопасно = Ложь;
						Прервать;
					КонецЕсли;
					Разбор.ДопустимыеТипы.Вставить(ТипЗначения, Истина);
					Разбор.ВидыАтомов.Добавить("value");
				ИначеЕсли ИмяВрег = "ДАТАВРЕМЯ" Тогда
					Если Не АргументДатаВремяДопустим(Содержимое) Тогда
						Разбор.Безопасно = Ложь;
						Прервать;
					КонецЕсли;
					Разбор.ДопустимыеТипы.Вставить("Дата", Истина);
					Разбор.ВидыАтомов.Добавить("literal");
				Иначе
					// Любая другая функция не доказана безопасной: СУММА,
					// ВЫРАЗИТЬ, ПРЕДСТАВЛЕНИЕ и прочие могут читать базу.
					Разбор.Безопасно = Ложь;
					Прервать;
				КонецЕсли;
			ИначеЕсли ИмяВрег = "ИСТИНА" Или ИмяВрег = "ЛОЖЬ" Тогда
				Разбор.ДопустимыеТипы.Вставить("Булево", Истина);
				Разбор.ВидыАтомов.Добавить("literal");
			ИначеЕсли ИмяВрег = "NULL" Тогда
				Разбор.ДопустимыеТипы.Вставить("Null", Истина);
				Разбор.ВидыАтомов.Добавить("literal");
			ИначеЕсли ИмяВрег = "НЕОПРЕДЕЛЕНО" Тогда
				Разбор.ДопустимыеТипы.Вставить("Неопределено", Истина);
				Разбор.ВидыАтомов.Добавить("literal");
			ИначеЕсли ИмяВрег = "И" Или ИмяВрег = "ИЛИ" Или ИмяВрег = "НЕ"
				Или ИмяВрег = "В" Или ИмяВрег = "МЕЖДУ" Или ИмяВрег = "ПОДОБНО"
				Или ИмяВрег = "ЕСТЬ" Тогда
				// Логический контекст: выражение может давать булево.
				Разбор.ДопустимыеТипы.Вставить("Булево", Истина);
				Разбор.Композитно = Истина;
			ИначеЕсли ИмяВрег = "ВЫБОР" Или ИмяВрег = "КОГДА" Или ИмяВрег = "ТОГДА"
				Или ИмяВрег = "ИНАЧЕ" Или ИмяВрег = "КОНЕЦ" Тогда
				// Служебные слова выражения выбора - составная конструкция.
				Разбор.Композитно = Истина;
			ИначеЕсли ИмяВрег = "РАЗЛИЧНЫЕ" Тогда
				// Модификатор выборки, не меняет вид допуска.
			Иначе
				// Неизвестный идентификатор без скобок - поле источника.
				Разбор.Безопасно = Ложь;
				Прервать;
			КонецЕсли;
		ИначеЕсли Символ = "=" Или Символ = "<" Или Символ = ">" Тогда
			// Сравнение может давать булево.
			Разбор.ДопустимыеТипы.Вставить("Булево", Истина);
			Разбор.Композитно = Истина;
			Позиция = Позиция + 1;
		ИначеЕсли Найти("+-*/", Символ) > 0 Тогда
			Разбор.Композитно = Истина;
			Позиция = Позиция + 1;
		ИначеЕсли Найти("(),", Символ) > 0 Тогда
			Позиция = Позиция + 1;
		Иначе
			Разбор.Безопасно = Ложь;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Возврат Разбор;

КонецФункции

// Аргумент счётчика: * или путь поля, допускается РАЗЛИЧНЫЕ перед путём.
Функция АргументСчётчикаДопустим(Содержимое)

	Текст = СокрЛП(Содержимое);
	Если Текст = "*" Тогда
		Возврат Истина;
	КонецЕсли;
	Если СтрДлина(Текст) > 9
		И ВРег(Лев(Текст, 9)) = "РАЗЛИЧНЫЕ"
		И ЭтоПробельныйСимвол(Сред(Текст, 10, 1)) Тогда
		Текст = СокрЛП(Сред(Текст, 10));
	КонецЕсли;
	Возврат ЭтоПутьПоля(Текст);

КонецФункции

// Аргумент ЗНАЧЕНИЕ(Вид.Объект.Имя): возвращает имя ссылочного типа значения
// или Неопределено, если форма не доказана.
Функция СсылочныйТипЗначенияИзАргумента(Содержимое)

	Части = СтрРазделить(СокрЛП(Содержимое), ".");
	Если Части.Количество() <> 3 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Для Каждого Сегмент Из Части Цикл
		Если Не ЭтоИдентификатор(Сегмент) Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЦикла;

	ПрефиксыВидов = Новый Соответствие;
	ПрефиксыВидов.Вставить("СПРАВОЧНИК", "СправочникСсылка");
	ПрефиксыВидов.Вставить("ДОКУМЕНТ", "ДокументСсылка");
	ПрефиксыВидов.Вставить("ПЕРЕЧИСЛЕНИЕ", "ПеречислениеСсылка");
	ПрефиксыВидов.Вставить("ПЛАНВИДОВХАРАКТЕРИСТИК", "ПланВидовХарактеристикСсылка");
	ПрефиксыВидов.Вставить("ПЛАНСЧЕТОВ", "ПланСчетовСсылка");
	ПрефиксыВидов.Вставить("ПЛАНВИДОВРАСЧЕТА", "ПланВидовРасчетаСсылка");
	ПрефиксыВидов.Вставить("ПЛАНОБМЕНА", "ПланОбменаСсылка");
	ПрефиксыВидов.Вставить("БИЗНЕСПРОЦЕСС", "БизнесПроцессСсылка");
	ПрефиксыВидов.Вставить("ЗАДАЧА", "ЗадачаСсылка");

	Префикс = ПрефиксыВидов.Получить(ВРег(Части[0]));
	Если Префикс = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	// Вид и объект обязаны существовать в метаданных, иначе тип выдуман.
	Если Метаданные.НайтиПоПолномуИмени(Части[0] + "." + Части[1]) = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Префикс + "." + Части[1];

КонецФункции

// Аргумент ДАТАВРЕМЯ: только цифры, запятые и пробельные символы.
Функция АргументДатаВремяДопустим(Содержимое)

	Если ПустаяСтрока(Содержимое) Тогда
		Возврат Ложь;
	КонецЕсли;
	ЕстьЦифра = Ложь;
	Для Индекс = 1 По СтрДлина(Содержимое) Цикл
		Символ = Сред(Содержимое, Индекс, 1);
		Если ЭтоЦифра(Символ) Тогда
			ЕстьЦифра = Истина;
		ИначеЕсли Символ <> "," И Не ЭтоПробельныйСимвол(Символ) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат ЕстьЦифра;

КонецФункции

// Путь поля: один и более идентификаторов через точку.
Функция ЭтоПутьПоля(Текст)

	Если ПустаяСтрока(Текст) Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого Сегмент Из СтрРазделить(Текст, ".") Цикл
		Если Не ЭтоИдентификатор(Сегмент) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

Функция ЭтоИдентификатор(Текст)

	Если ПустаяСтрока(Текст) Или Не ЭтоБукваИлиПодчерк(Лев(Текст, 1)) Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Индекс = 2 По СтрДлина(Текст) Цикл
		Если Не ЭтоБукваЦифраПодчерк(Сред(Текст, Индекс, 1)) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

Функция ЭтоБукваИлиПодчерк(Символ)
	Возврат Символ = "_" Или ВРег(Символ) <> НРег(Символ);
КонецФункции

Функция ЭтоБукваЦифраПодчерк(Символ)
	Возврат ЭтоБукваИлиПодчерк(Символ) Или ЭтоЦифра(Символ);
КонецФункции

Функция ЭтоЦифра(Символ)
	Возврат Найти("0123456789", Символ) > 0;
КонецФункции

Функция ЭтоПробельныйСимвол(Символ)
	Возврат Символ = " " Или Символ = Символы.Таб Или Символ = Символы.ПС
		Или Символ = Символы.ВК Или Символ = Символы.НПП Или Символ = Символы.ВТаб
		Или Символ = Символы.ПФ;
КонецФункции

// Позиция после закрывающей кавычки строкового литерала; 0 - незакрытый.
Функция ПропуститьСтроковыйЛитерал(Текст, Позиция)

	Позиция = Позиция + 1;
	Длина = СтрДлина(Текст);
	Пока Позиция <= Длина Цикл
		Если Сред(Текст, Позиция, 1) = """" Тогда
			Если Сред(Текст, Позиция + 1, 1) = """" Тогда
				Позиция = Позиция + 2;
			Иначе
				Возврат Позиция + 1;
			КонецЕсли;
		Иначе
			Позиция = Позиция + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат 0;

КонецФункции

// Символ следующего непробельного знака; пустая строка - конец текста.
Функция СледующийНепробельный(Текст, Позиция)

	Длина = СтрДлина(Текст);
	Пока Позиция <= Длина Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если Не ЭтоПробельныйСимвол(Символ) Тогда
			Возврат Символ;
		КонецЕсли;
		Позиция = Позиция + 1;
	КонецЦикла;
	Возврат "";

КонецФункции

// Индекс следующего непробельного знака; 0 - конец текста.
Функция ПозицияНепробельного(Текст, Позиция)

	Длина = СтрДлина(Текст);
	Пока Позиция <= Длина Цикл
		Если Не ЭтоПробельныйСимвол(Сред(Текст, Позиция, 1)) Тогда
			Возврат Позиция;
		КонецЕсли;
		Позиция = Позиция + 1;
	КонецЦикла;
	Возврат 0;

КонецФункции

// Индекс скобки, парной открывающей на указанной позиции; 0 - не найдена.
Функция ПарнаяСкобка(Текст, ПозицияОткрывающей)

	Глубина = 0;
	Позиция = ПозицияОткрывающей;
	Длина = СтрДлина(Текст);
	Пока Позиция <= Длина Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если Символ = """" Тогда
			Позиция = ПропуститьСтроковыйЛитерал(Текст, Позиция);
			Если Позиция = 0 Тогда
				Возврат 0;
			КонецЕсли;
			Продолжить;
		ИначеЕсли Символ = "(" Тогда
			Глубина = Глубина + 1;
		ИначеЕсли Символ = ")" Тогда
			Глубина = Глубина - 1;
			Если Глубина = 0 Тогда
				Возврат Позиция;
			КонецЕсли;
		КонецЕсли;
		Позиция = Позиция + 1;
	КонецЦикла;
	Возврат 0;

КонецФункции

// Идентификатор с точками (путь или имя параметра) начиная с позиции.
Функция ПрочитатьИдентификаторПосле(Текст, Позиция, Имя)

	Имя = "";
	Длина = СтрДлина(Текст);
	Пока Позиция <= Длина Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если ЭтоБукваЦифраПодчерк(Символ) Или Символ = "." Тогда
			Имя = Имя + Символ;
			Позиция = Позиция + 1;
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат Позиция;

КонецФункции

// Заявленные типы колонки результата обязаны входить в доказанный набор.
Функция ТипыКолонкиСогласованы(ТипыКолонки, ДопустимыеТипы)

	Если ТипЗнч(ТипыКолонки) <> Тип("Массив") Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ТипыКолонки.Количество() = 0 Тогда
		// Пустой ОписаниеТипов законен только у выражения НЕОПРЕДЕЛЕНО -
		// без литерала НЕОПРЕДЕЛЕНО в допуске это непроверенная колонка.
		Возврат ДопустимыеТипы["Неопределено"] = Истина;
	КонецЕсли;
	Для Каждого ИмяТипа Из ТипыКолонки Цикл
		Если ТипЗнч(ИмяТипа) <> Тип("Строка")
			Или ДопустимыеТипы[ИмяТипа] <> Истина Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

// Каждое значение безисточниковой колонки обязано иметь тип из доказанного
// набора: счётчик - только число, литерал - тип литерала, параметр - тип
// фактического значения, ЗНАЧЕНИЕ - ссылочный тип предопределённого.
Функция ЗначенияКолонкиСогласованы(Данные, ИмяКолонки, ДопустимыеТипы)

	Для Каждого СтрокаДанных Из Данные Цикл
		// Строка - Структура или Соответствие: итерация по парам покрывает оба
		// типа, а отсутствие ключа колонки - признак сломанного результата.
		КолонкаНайдена = Ложь;
		Для Каждого Пара Из СтрокаДанных Цикл
			Если Пара.Ключ <> ИмяКолонки Тогда
				Продолжить;
			КонецЕсли;
			КолонкаНайдена = Истина;
			Значение = Пара.Значение;
			Если Значение = Неопределено Тогда
				// Пустое значение не несёт содержимого полей.
				Продолжить;
			КонецЕсли;
			ТипЗначения = ТипЗнч(Значение);
			ИмяТипаЗначения = "";
			Если ТипЗначения = Тип("Число") Тогда
				ИмяТипаЗначения = "Число";
			ИначеЕсли ТипЗначения = Тип("Строка") Тогда
				ИмяТипаЗначения = "Строка";
			ИначеЕсли ТипЗначения = Тип("Дата") Тогда
				ИмяТипаЗначения = "Дата";
			ИначеЕсли ТипЗначения = Тип("Булево") Тогда
				ИмяТипаЗначения = "Булево";
			ИначеЕсли ТипЗначения = Тип("Null") Тогда
				ИмяТипаЗначения = "Null";
			ИначеЕсли ТипЗначения = Тип("Структура")
				Или ТипЗначения = Тип("Соответствие") Тогда
				// Непустая ссылка сериализуется объектом; сервис не принимает
				// объекты в ячейках безисточниковых колонок - отказ без утечки.
				Возврат Ложь;
			КонецЕсли;
			Если ПустаяСтрока(ИмяТипаЗначения)
				Или ДопустимыеТипы[ИмяТипаЗначения] <> Истина Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЦикла;
		Если Не КолонкаНайдена Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

// Строгий режим: сервис strict_mode (миграция 0012) принимает unverified +
// output_types и маскирует такие колонки целиком; пометка включена.
// Контракт - strict-mode.md раздел "Контракт полей".
Функция РежимПометкиUnverifiedВключён()
	// Сервис strict_mode задеплоен на DEV (t227, миграция 0012): пометка
	// unverified + output_types включена, контракт - в strict-mode.md.
	Возврат Истина;
КонецФункции

// Подготовленная пометка: колонки без источников и без доказанного безполевого
// выражения помечаются unverified; фактические типы выносятся в output_types.
// Возвращает Ложь на жёстких нарушениях (секрет в запросе, внешний менеджер
// ВТ, сломанный конверт результата) - они остаются отказом и в строгом режиме.
Функция ПометитьНепроверенныеКолонкиВСхеме(Схема, Результат, ТекстЗапроса, ПараметрыВызова)

	Колонки = Свойство(Схема, "columns", Неопределено);
	Если ТипЗнч(Колонки) <> Тип("Массив") Тогда
		Возврат Ложь;
	КонецЕсли;

	// Те же структурные инварианты, что в основной проверке: пометка не
	// легализует конверт с лишними полями или data не-массивом.
	Если ТипЗнч(Результат) <> Тип("Структура")
		Или Не Результат.Свойство("success")
		Или Не Результат.Свойство("data")
		Или Не Результат.Свойство("schema")
		Или Результат.Количество() <> 3 Тогда
		Возврат Ложь;
	КонецЕсли;
	Данные = Свойство(Результат, "data", Неопределено);
	Если ТипЗнч(Данные) <> Тип("Массив") Тогда
		Возврат Ложь;
	КонецЕсли;

	АнализЗапроса = АнализЗапросаГраницы(ТекстЗапроса, Колонки, ПараметрыВызова);
	Если Не АнализЗапроса.ИсточникиДопустимы
		Или АнализЗапроса.ЕстьУпоминаниеСекрета Тогда
		Возврат Ложь;
	КонецЕсли;
	Для ИндексКолонки = 0 По Колонки.Количество() - 1 Цикл
		Колонка = Колонки[ИндексКолонки];
		Колонка.Вставить("output_types",
			Свойство(Колонка, "types", Новый Массив));

		Источники = Свойство(Колонка, "sources", Неопределено);
		Если ТипЗнч(Источники) <> Тип("Массив") Или Источники.Количество() = 0 Тогда
			// Голое поле доказывается метаданными источников и в строгом
			// режиме: помечать доказуемую колонку unverified - ложный минус.
			Восстановленные = АнализЗапроса.ВосстановленныеИсточники[
				ИндексКолонки];
			Если Восстановленные <> Неопределено Тогда
				Колонка.Вставить("sources", Восстановленные);
				Источники = Восстановленные;
			КонецЕсли;
		КонецЕсли;

		Если ТипЗнч(Источники) <> Тип("Массив") Или Источники.Количество() = 0 Тогда
			// Whitelist-атом доказан только вместе с типами и значениями;
			// разобранный, но несогласованный допуск - та же неизвестность.
			Допуск = АнализЗапроса.ДопускиКолонок[ИндексКолонки];
			Если Допуск <> Неопределено
				И ТипыКолонкиСогласованы(
					Свойство(Колонка, "types", Неопределено), Допуск.ДопустимыеТипы)
				И ЗначенияКолонкиСогласованы(
					Данные, Свойство(Колонка, "name", ""), Допуск.ДопустимыеТипы) Тогда
				Колонка.Вставить("sources", Новый Массив);
				Колонка.Вставить("sourceless", Допуск.Вид);
			Иначе
				// Контракт strict_mode: sources - обязательный массив
				// и на unverified-колонке; неразрешимый путь остаётся
				// как есть, отсутствующий ключ заполняется пустым.
				Если ТипЗнч(Источники) <> Тип("Массив") Тогда
					Колонка.Вставить("sources", Новый Массив);
				КонецЕсли;
				Колонка.Вставить("unverified", Истина);
			КонецЕсли;
		Иначе
			// Источники есть, но недоказуемый путь - та же неизвестность.
			Для Каждого ПутьИсточника Из Источники Цикл
				Если ТипЗнч(ПутьИсточника) <> Тип("Строка")
					Или ПустаяСтрока(ПутьИсточника)
					Или НайтиЭлементМетаданныхПоПути(ПутьИсточника) = Неопределено Тогда
					Колонка.Вставить("unverified", Истина);
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;

	// Строки обязаны совпадать с именами колонок: лишний ключ - непроверенное
	// значение вне любой пометки, пометка его не легализует.
	ИменаКолонок = Новый Соответствие;
	Для Каждого Колонка Из Колонки Цикл
		ИменаКолонок.Вставить(Свойство(Колонка, "name", ""), Истина);
	КонецЦикла;
	Для Каждого СтрокаДанных Из Данные Цикл
		Если ТипЗнч(СтрокаДанных) <> Тип("Структура")
			И ТипЗнч(СтрокаДанных) <> Тип("Соответствие") Тогда
			Возврат Ложь;
		КонецЕсли;
		Для Каждого Пара Из СтрокаДанных Цикл
			Если ИменаКолонок[Пара.Ключ] <> Истина Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Истина;

КонецФункции

// Скан секретных реквизитов по СхемаЗапроса: разбираются выражения списка
// выборки, ГДЕ, СГРУППИРОВАТЬ, условия соединений, параметры виртуальных
// таблиц, УПОРЯДОЧИТЬ, ИТОГИ и индексы каждого запроса выбора пакета,
// включая вложенные запросы. Упоминание секрета в любом месте - отказ.
Функция ЗапросСодержитСекретныйРеквизит(ЗапросВыбора, ПараметрыЗапроса)

	ОбластиОператоров = Новый Массив;

	Для Каждого Оператор Из ЗапросВыбора.Операторы Цикл
		// Область разрешения имён оператора: псевдонимы источников с их
		// метаданными, сами метаданные таблиц для неквалифицированных полей и
		// выражения параметров виртуальных таблиц.
		Область = Новый Структура(
			"Алиасы, ТаблицыМетаданных, ЕстьСекрет, Выражения",
			Новый Соответствие, Новый Массив, Ложь, Новый Массив);
		Для Каждого Источник Из Оператор.Источники Цикл
			ДобавитьИсточникВОбласть(Область, Источник, ПараметрыЗапроса, 0);
		КонецЦикла;
		Если Область.ЕстьСекрет Тогда
			Возврат Истина;
		КонецЕсли;

		Выражения = Новый Массив;
		// Список выборки - особая зона: секрет, выводимый "как есть" колонкой
		// (голое поле, ВЫБРАТЬ *, псевдоним), вырезается маскировкой, а не
		// отказом; отказ - только когда секрет - операнд вычисления.
		ДобавитьВыраженияВыборки(Выражения, Оператор, Область, ПараметрыЗапроса);
		Если Область.ЕстьСекрет Тогда
			Возврат Истина;
		КонецЕсли;
		ДобавитьВыраженияКоллекции(Выражения, Оператор.Отбор);
		Попытка
			ДобавитьВыраженияКоллекции(Выражения,
				Оператор.ВыраженияОтбораКомпоновкиДанных);
		Исключение
		КонецПопытки;
		ДобавитьВыраженияКоллекции(Выражения, Оператор.Группировка);
		ДобавитьУсловияСоединений(Выражения, Оператор.Источники, 0);
		Для Каждого ВыражениеИсточника Из Область.Выражения Цикл
			Выражения.Добавить(ВыражениеИсточника);
		КонецЦикла;
		Для Каждого Выражение Из Выражения Цикл
			Если ВыражениеСсылаетсяНаСекрет(Выражение, Область, ПараметрыЗапроса) Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
		ОбластиОператоров.Добавить(Область);
	КонецЦикла;

	// Уровень запроса: УПОРЯДОЧИТЬ, ИНДЕКСИРОВАТЬ, ИТОГИ. Их выражения могут
	// ссылаться на источники любого оператора объединения.
	ВыраженияЗапроса = Новый Массив;
	ДобавитьВыраженияПорядкаИИтогов(ВыраженияЗапроса, ЗапросВыбора);
	Для Каждого Выражение Из ВыраженияЗапроса Цикл
		Для Каждого Область Из ОбластиОператоров Цикл
			Если ВыражениеСсылаетсяНаСекрет(Выражение, Область, ПараметрыЗапроса) Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Псевдоним и метаданные источника добавляются в область оператора; вложенный
// запрос проверяется рекурсивно; соединённые источники - тоже часть области.
Процедура ДобавитьИсточникВОбласть(Область, Источник, ПараметрыЗапроса, Глубина)

	Если Глубина > 8 Тогда
		Возврат;
	КонецЕсли;

	Таблица = Неопределено;
	Попытка
		Таблица = Источник.Источник;
	Исключение
		Возврат;
	КонецПопытки;
	Если Таблица = Неопределено Тогда
		Возврат;
	КонецЕсли;

	МетаданныеИсточника = Неопределено;
	ТипТаблицы = ТипЗнч(Таблица);
	Если ТипТаблицы = Тип("ТаблицаСхемыЗапроса") Тогда
		Части = СтрРазделить(Таблица.ИмяТаблицы, ".", Ложь);
		Если Части.Количество() >= 2 Тогда
			МетаданныеИсточника = Метаданные.НайтиПоПолномуИмени(
				Части[0] + "." + Части[1]);
		КонецЕсли;
		// Параметры виртуальной таблицы (Остатки(&П.Поле) и т.п.) - место
		// упоминания полей и разыменований вне ГДЕ.
		Попытка
			Для Каждого ПараметрТаблицы Из Таблица.Параметры Цикл
				Если ТипЗнч(ПараметрТаблицы.Выражение)
					= Тип("ВыражениеСхемыЗапроса") Тогда
					Область.Выражения.Добавить(ПараметрТаблицы.Выражение);
				КонецЕсли;
			КонецЦикла;
		Исключение
		КонецПопытки;
	ИначеЕсли ТипТаблицы = Тип("ВложенныйЗапросСхемыЗапроса") Тогда
		// Поля вложенного запроса по имени недоказуемы, но его собственные
		// ГДЕ, соединения и подзапросы обязаны пройти тот же скан.
		Если ЗапросСодержитСекретныйРеквизит(Таблица.Запрос, ПараметрыЗапроса) Тогда
			Область.ЕстьСекрет = Истина;
		КонецЕсли;
	КонецЕсли;
	// ОписаниеВременнойТаблицыСхемыЗапроса (ИЗ ВТ или ИЗ &ТЗ): метаданных нет,
	// поля через такой источник недоказуемы - их выдачу отсекает lineage.

	Псевдоним = "";
	Попытка
		Псевдоним = Таблица.Псевдоним;
	Исключение
	КонецПопытки;
	Если Не ПустаяСтрока(Псевдоним) Тогда
		Область.Алиасы.Вставить(ВРег(Псевдоним), МетаданныеИсточника);
	КонецЕсли;
	Если МетаданныеИсточника <> Неопределено Тогда
		Область.ТаблицыМетаданных.Добавить(МетаданныеИсточника);
	КонецЕсли;

	// Соединённый источник (ЛЕВОЕ СОЕДИНЕНИЕ Б ПО ...) входит в область имен.
	Попытка
		Соединения = Источник.Соединения;
	Исключение
		Возврат;
	КонецПопытки;
	Для Каждого Соединение Из Соединения Цикл
		ДобавитьИсточникВОбласть(Область, Соединение.Источник,
			ПараметрыЗапроса, Глубина + 1);
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьВыраженияКоллекции(Выражения, Коллекция)

	Попытка
		Для Каждого Элемент Из Коллекция Цикл
			ТипЭлемента = ТипЗнч(Элемент);
			Если ТипЭлемента = Тип("ВыражениеСхемыЗапроса")
				Или ТипЭлемента
					= Тип("ВыражениеОтбораКомпоновкиДанныхСхемыЗапроса") Тогда
				Выражения.Добавить(Элемент);
			КонецЕсли;
		КонецЦикла;
	Исключение
	КонецПопытки;

КонецПроцедуры

// В скан попадают только поля выборки, где поле-источник - операнд
// вычисления (функция, ВЫБОР, арифметика). Выражение, целиком сводящееся
// к пути поля ("apiKey", "Т.apiKey"), выводится как есть: секрет в такой
// колонке вырезается маскировкой [SECRET_REMOVED], отказ не нужен.
// Вложенная таблица в выборке - тот же полный скан рекурсивно.
Процедура ДобавитьВыраженияВыборки(Выражения, Оператор, Область, ПараметрыЗапроса)

	Попытка
		Для Каждого ПолеВыборки Из Оператор.ВыбираемыеПоля Цикл
			ТипПоля = ТипЗнч(ПолеВыборки);
			Если ТипПоля = Тип("ВложеннаяТаблицаСхемыЗапроса") Тогда
				Попытка
					Если ЗапросСодержитСекретныйРеквизит(
						ПолеВыборки.Запрос, ПараметрыЗапроса) Тогда
						Область.ЕстьСекрет = Истина;
					КонецЕсли;
				Исключение
					// Структура вложенного запроса не читается - недоказано.
					Область.ЕстьСекрет = Истина;
				КонецПопытки;
			ИначеЕсли ТипПоля = Тип("ВыражениеСхемыЗапроса")
				И Не ЭтоГолоеПоле(Строка(ПолеВыборки)) Тогда
				Выражения.Добавить(ПолеВыборки);
			КонецЕсли;
		КонецЦикла;
	Исключение
		// Коллекция полей не итерируется - состав выборки недоказан.
		Область.ЕстьСекрет = Истина;
	КонецПопытки;

КонецПроцедуры

// Истина, когда текст выражения - только путь поля: идентификаторы через
// точку, без операторов, вызовов функций и литералов.
Функция ЭтоГолоеПоле(Текст)

	ТекстПоля = СокрЛП(Текст);
	Если ПустаяСтрока(ТекстПоля) Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого Сегмент Из СтрРазделить(ТекстПоля, ".", Ложь) Цикл
		Если Не ЭтоИдентификаторПоля(Сегмент) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

Функция ЭтоИдентификаторПоля(Текст)

	Если ПустаяСтрока(Текст)
		Или Не ЭтоБукваИлиПодчерк(Лев(Текст, 1)) Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Позиция = 2 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если Не ЭтоБукваИлиПодчерк(Символ) И Не ЭтоЦифра(Символ) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

// Восстановление источников голых полей: нативный анализатор не разворачивает
// ВЫБРАТЬ * и удерживает sources у колонок с секретными именами, но голое поле
// по СхемаЗапроса доказуемо является реквизитом источника. Возвращает массив
// канонических путей Вид.Объект[.ТЧ].Реквизит (по одному на оператор
// объединения) или Неопределено, если происхождение не доказано.
// Восстановленный путь встаёт в sources колонки, поэтому дальше работают
// обычная проверка НайтиЭлементМетаданныхПоПути и маскировка секретов.
Функция ВосстановитьИсточникиГолыхПолей(ЗапросВыбора, ИндексКолонки)

	КолонкаЗапроса = ЗапросВыбора.Колонки[ИндексКолонки];
	ПоляКолонки = КолонкаЗапроса.Поля;
	Если ПоляКолонки.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Пути = Новый Массив;
	Для ИндексПоля = 0 По ПоляКолонки.Количество() - 1 Цикл
		ПолеКолонки = ПоляКолонки[ИндексПоля];
		Если ПолеКолонки = Неопределено Тогда
			// Часть объединения не поставляет значение - там NULL.
			Продолжить;
		КонецЕсли;
		Если ТипЗнч(ПолеКолонки) <> Тип("ВыражениеСхемыЗапроса") Тогда
			Возврат Неопределено;
		КонецЕсли;
		ТекстПоля = СокрЛП(Строка(ПолеКолонки));
		Если Не ЭтоГолоеПоле(ТекстПоля) Тогда
			Возврат Неопределено;
		КонецЕсли;
		Если ИндексПоля >= ЗапросВыбора.Операторы.Количество() Тогда
			Возврат Неопределено;
		КонецЕсли;
		Путь = РезолвироватьПолеИсточника(
			ЗапросВыбора.Операторы[ИндексПоля], ТекстПоля, 0);
		Если Путь = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		Пути.Добавить(Путь);
	КонецЦикла;

	Если Пути.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Пути;

КонецФункции

// Резолв пути поля (Источник.Поле[.Поле...] или неквалифицированное поле)
// в канонический путь метаданных. Разыменование разрешено только по полям
// с единственным ссылочным типом - иначе цель недоказуема.
Функция РезолвироватьПолеИсточника(ИсточникОператор, ТекстПоля, Глубина)

	Если Глубина > 8 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Сегменты = СтрРазделить(ТекстПоля, ".", Ложь);
	Кандидаты = КандидатыИсточниковОператора(ИсточникОператор);

	// Первый сегмент - квалификатор источника (псевдоним/имя объекта/ВТ/ТЧ)
	// либо само поле: без псевдонима схема не квалифицирует поле именем
	// таблицы, поэтому Контрагент.Наименование начинается сразу с поля.
	НайденныеПути = Новый Массив;
	ПервыйПройден = Ложь;
	Если Сегменты.Количество() > 1 Тогда
		ИмяИсточника = ВРег(Сегменты[0]);
		Для Каждого Кандидат Из Кандидаты Цикл
			Если Кандидат.Псевдоним = ИмяИсточника
				Или Кандидат.ИмяОбъекта = ИмяИсточника
				Или Кандидат.ИмяПодчинённого = ИмяИсточника Тогда
				ПервыйПройден = Истина;
				ДобавитьРезолвСегментов(НайденныеПути, Кандидат, Сегменты, 1);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	// Квалификатор не распознан ни одним источником - путь начинается с поля.
	Если Не ПервыйПройден Тогда
		Для Каждого Кандидат Из Кандидаты Цикл
			ДобавитьРезолвСегментов(НайденныеПути, Кандидат, Сегменты, 0);
		КонецЦикла;
	КонецЕсли;

	// Ноль или неоднозначность - происхождение не доказано.
	Если НайденныеПути.Количество() <> 1 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат НайденныеПути[0];

КонецФункции

// Обход сегментов поля от метаданных источника; промежуточные сегменты
// проходят разыменование только по единственному ссылочному типу.
Процедура ДобавитьРезолвСегментов(НайденныеПути, Кандидат, Сегменты, Начало)

	Контекст = Кандидат.Метаданные;
	Элемент = Неопределено;
	Для ИндексСегмента = Начало По Сегменты.Количество() - 1 Цикл
		Элемент = НайтиВКоллекцияхМетаданных(Контекст, Сегменты[ИндексСегмента]);
		Если Элемент = Неопределено Тогда
			// Системное поле объекта живёт вне коллекций метаданных; голое
			// поле исполненного запроса доказывает, что оно существует.
			Если ИндексСегмента = Сегменты.Количество() - 1
				И ЭтоСистемноеПолеОбъекта(Сегменты[ИндексСегмента]) Тогда
				НайденныеПути.Добавить(
					Контекст.ПолноеИмя() + "." + Сегменты[ИндексСегмента]);
			КонецЕсли;
			Возврат;
		КонецЕсли;
		Если ИндексСегмента < Сегменты.Количество() - 1 Тогда
			Контекст = МетаданныеСсылочногоТипаЭлемента(Элемент);
			Если Контекст = Неопределено Тогда
				Возврат;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	НайденныеПути.Добавить(Контекст.ПолноеИмя() + "." + Элемент.Имя);

КонецПроцедуры

// Поля, существующие у объектов, но не представленные в коллекциях
// метаданных (СтандартныеРеквизиты и др.). Значения этих полей не могут
// быть секретами по построению, поэтому whitelist безопасен.
Функция ЭтоСистемноеПолеОбъекта(ИмяПоля)
	Возврат Найти(
		"|ВЕРСИЯДАННЫХ|МОМЕНТВРЕМЕНИ|ПЕРИОД|РЕГИСТРАТОР|НОМЕРСТРОКИ|"
		+ "АКТИВНОСТЬ|ВИДДВИЖЕНИЯ|ЛИНИЯЖИЗНИ|СЧЁТЧИКСТРОК|"
		+ "ПОМЕТКАУДАЛЕНИЯ|ПРЕДОПРЕДЕЛЕННЫЙ|ИМЯПРЕДОПРЕДЕЛЕННЫХДАННЫХ|"
		+ "НОМЕР|ДАТА|ПРОВЕДЕН|ВЫПОЛНЕНА|СТАРТОВАН|ЗАВЕРШЕН|"
		+ "ЭТОГРУППА|РОДИТЕЛЬ|ВЛАДЕЛЕЦ|КОД|НАИМЕНОВАНИЕ|ССЫЛКА|",
		"|" + ВРег(Строка(ИмяПоля)) + "|") > 0;
КонецФункции

// Источники оператора (включая соединённые) как кандидаты резолва имени:
// метаданные объекта или табличной части; для виртуальной таблицы - сам
// объект-владелец, её поля совпадают с полями объекта.
Процедура ДобавитьКандидатаИсточника(Кандидаты, Источник)

	ТаблицаИсточника = Неопределено;
	Попытка
		ТаблицаИсточника = Источник.Источник;
	Исключение
		Возврат;
	КонецПопытки;
	Если ТипЗнч(ТаблицаИсточника) <> Тип("ТаблицаСхемыЗапроса") Тогда
		// ВТ, таблица-параметр, вложенный запрос - метаданных полей нет.
		Возврат;
	КонецЕсли;

	ИмяТаблицы = ТаблицаИсточника.ИмяТаблицы;
	Если Лев(ИмяТаблицы, 1) = "&" Тогда
		Возврат;
	КонецЕсли;
	Части = СтрРазделить(ИмяТаблицы, ".", Ложь);
	Если Части.Количество() < 2 Тогда
		Возврат;
	КонецЕсли;

	Контекст = Неопределено;
	Попытка
		Контекст = Метаданные.НайтиПоПолномуИмени(Части[0] + "." + Части[1]);
	Исключение
	КонецПопытки;
	Если Контекст = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// Третий сегмент - виртуальная таблица или табличная часть. ТЧ меняет
	// контекст полей, виртуальная таблица оставляет полями объекта.
	ИмяПодчинённого = "";
	Если Части.Количество() >= 3 Тогда
		Подчинённый = НайтиВКоллекцияхМетаданных(Контекст, Части[2]);
		Если Подчинённый <> Неопределено Тогда
			Контекст = Подчинённый;
		КонецЕсли;
		ИмяПодчинённого = ВРег(Части[2]);
	КонецЕсли;

	Псевдоним = "";
	Попытка
		Псевдоним = ТаблицаИсточника.Псевдоним;
	Исключение
	КонецПопытки;

	Кандидаты.Добавить(Новый Структура(
		"Псевдоним, ИмяОбъекта, ИмяПодчинённого, Метаданные",
		ВРег(Псевдоним), ВРег(Части[1]), ИмяПодчинённого, Контекст));

КонецПроцедуры

Процедура ДобавитьКандидатовРекурсивно(Кандидаты, Источник, Глубина)

	Если Глубина > 8 Тогда
		Возврат;
	КонецЕсли;
	ДобавитьКандидатаИсточника(Кандидаты, Источник);
	Попытка
		Соединения = Источник.Соединения;
	Исключение
		Возврат;
	КонецПопытки;
	Для Каждого Соединение Из Соединения Цикл
		ДобавитьКандидатовРекурсивно(Кандидаты, Соединение.Источник,
			Глубина + 1);
	КонецЦикла;

КонецПроцедуры

Функция КандидатыИсточниковОператора(Оператор)
	Кандидаты = Новый Массив;
	Для Каждого Источник Из Оператор.Источники Цикл
		ДобавитьКандидатовРекурсивно(Кандидаты, Источник, 0);
	КонецЦикла;
	Возврат Кандидаты;
КонецФункции

// Разыменование доказуемо только для единственного ссылочного типа элемента:
// составной или примитивный тип не даёт целевой объект метаданных.
Функция МетаданныеСсылочногоТипаЭлемента(ЭлементМетаданных)

	Попытка
		Типы = ЭлементМетаданных.Тип.Типы();
		Если Типы.Количество() <> 1 Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат Метаданные.НайтиПоТипу(Типы[0]);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Условия соединений собираются рекурсивно по цепочке соединённых источников.
Процедура ДобавитьУсловияСоединений(Выражения, Источники, Глубина)

	Если Глубина > 8 Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Источник Из Источники Цикл
		Соединения = Неопределено;
		Попытка
			Соединения = Источник.Соединения;
		Исключение
			Продолжить;
		КонецПопытки;
		Для Каждого Соединение Из Соединения Цикл
			Попытка
				Если ТипЗнч(Соединение.Условие) = Тип("ВыражениеСхемыЗапроса") Тогда
					Выражения.Добавить(Соединение.Условие);
				КонецЕсли;
			Исключение
			КонецПопытки;
			Попытка
				СвязанныеИсточники = Новый Массив;
				СвязанныеИсточники.Добавить(Соединение.Источник);
				ДобавитьУсловияСоединений(Выражения, СвязанныеИсточники, Глубина + 1);
			Исключение
			КонецПопытки;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Выражения уровня запроса: порядок, индексы временных таблиц, контрольные
// точки итогов и сами выражения итогов. Элемент может быть КолонкаСхемыЗапроса
// - тогда поля колонки вновь вводят выражение источника вне позиции выборки.
Процедура ДобавитьВыраженияПорядкаИИтогов(Выражения, ЗапросВыбора)

	Попытка
		Для Каждого ЭлементПорядка Из ЗапросВыбора.Порядок Цикл
			ДобавитьВыражениеЭлемента(Выражения, ЭлементПорядка.Элемент);
		КонецЦикла;
	Исключение
	КонецПопытки;
	Попытка
		Для Каждого ИндексТаблицы Из ЗапросВыбора.Индексы Цикл
			Для Каждого ВыражениеИндекса Из ИндексТаблицы.ВыраженияИндекса Цикл
				ДобавитьВыражениеЭлемента(Выражения, ВыражениеИндекса.Выражение);
			КонецЦикла;
		КонецЦикла;
	Исключение
	КонецПопытки;
	Попытка
		Для Каждого ТочкаИтогов Из ЗапросВыбора.КонтрольныеТочкиИтогов Цикл
			ДобавитьВыражениеЭлемента(Выражения, ТочкаИтогов.Выражение);
		КонецЦикла;
	Исключение
	КонецПопытки;
	Попытка
		Для Каждого ВыражениеИтога Из ЗапросВыбора.ВыраженияИтогов Цикл
			ДобавитьВыражениеЭлемента(Выражения, ВыражениеИтога.Выражение);
		КонецЦикла;
	Исключение
	КонецПопытки;

КонецПроцедуры

// Элемент порядка/индекса/итога - выражение или имя колонки результата; у
// колонки сканируются её выражения полей (упорядочивание по псевдониму
// секретного поля - тот же оракул, что и по самому полю).
Процедура ДобавитьВыражениеЭлемента(Выражения, Элемент)

	Если ТипЗнч(Элемент) = Тип("ВыражениеСхемыЗапроса") Тогда
		Выражения.Добавить(Элемент);
	ИначеЕсли ТипЗнч(Элемент) = Тип("КолонкаСхемыЗапроса") Тогда
		Попытка
			ДобавитьВыраженияКоллекции(Выражения, Элемент.Поля);
		Исключение
		КонецПопытки;
	КонецЕсли;

КонецПроцедуры

Функция ВыражениеСсылаетсяНаСекрет(Выражение, Область, ПараметрыЗапроса)

	Упоминания = ИзвлечьУпоминанияПолей(Строка(Выражение));
	Для Каждого ПутьПоля Из Упоминания.Пути Цикл
		// Имя-секрет у любого сегмента - отказ и без резолва по области:
		// область не покрывает псевдонимы подзапросов в выражениях (В (...)),
		// хвосты ВЫРАЗИТЬ(...).Поле и колонки временных таблиц пакета.
		Для Каждого Сегмент Из СтрРазделить(ПутьПоля, ".", Ложь) Цикл
			Если ЭтоИмяСекрета(Сегмент) Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
		Если ПутьВедётКСекретномуРеквизиту(Область, ПутьПоля) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Разыменование Из Упоминания.Разыменования Цикл
		Для Каждого Сегмент Из Разыменование.Сегменты Цикл
			Если ЭтоИмяСекрета(Сегмент) Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
		Если РазыменованиеПараметраВедётКСекрету(Разыменование, ПараметрыЗапроса) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Токенизирует текст выражения: возвращает пути полей (идентификаторы,
// включая неквалифицированные) и разыменования параметров вида &П.Поле.
// Содержимое ЗНАЧЕНИЕ(...) - путь метаданных, а не поле, и не сканируется.
Функция ИзвлечьУпоминанияПолей(Текст)

	Упоминания = Новый Структура(
		"Пути, Разыменования", Новый Массив, Новый Массив);

	Длина = СтрДлина(Текст);
	Позиция = 1;
	Пока Позиция <= Длина Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если ЭтоПробельныйСимвол(Символ) Тогда
			Позиция = Позиция + 1;
		ИначеЕсли Символ = """" Тогда
			Позиция = ПропуститьСтроковыйЛитерал(Текст, Позиция);
			Если Позиция = 0 Тогда
				Прервать;
			КонецЕсли;
		ИначеЕсли ЭтоЦифра(Символ) Тогда
			Пока Позиция <= Длина
				И (ЭтоЦифра(Сред(Текст, Позиция, 1))
					Или Сред(Текст, Позиция, 1) = ".") Цикл
				Позиция = Позиция + 1;
			КонецЦикла;
		ИначеЕсли Символ = "&" Тогда
			ИмяПараметра = "";
			Позиция = ПрочитатьИдентификаторПосле(Текст, Позиция + 1, ИмяПараметра);
			Если Найти(ИмяПараметра, ".") > 0 Тогда
				ЧастиПути = СтрРазделить(ИмяПараметра, ".", Ложь);
				ИмяПараметра = ЧастиПути[0];
				ЧастиПути.Удалить(0);
				Упоминания.Разыменования.Добавить(Новый Структура(
					"Имя, Сегменты", ИмяПараметра, ЧастиПути));
			КонецЕсли;
		ИначеЕсли ЭтоБукваИлиПодчерк(Символ) Тогда
			Идентификатор = "";
			Позиция = ПрочитатьИдентификаторПосле(Текст, Позиция, Идентификатор);
			Если ПустаяСтрока(Идентификатор) Тогда
				Продолжить;
			КонецЕсли;
			Если Найти(Идентификатор, ".") = 0
				И СледующийНепробельный(Текст, Позиция) = "(" Тогда
				// Вызов функции: имя пропускается, аргументы сканируются дальше.
				Если ВРег(Идентификатор) = "ЗНАЧЕНИЕ" Тогда
					ПозицияСкобки = ПозицияНепробельного(Текст, Позиция);
					КонецСкобки = ПарнаяСкобка(Текст, ПозицияСкобки);
					Если КонецСкобки > 0 Тогда
						Позиция = КонецСкобки + 1;
					КонецЕсли;
				КонецЕсли;
			ИначеЕсли Найти(Идентификатор, ".") > 0
				Или Не ЭтоКлючевоеСловоУпоминаний(ВРег(Идентификатор)) Тогда
				Упоминания.Пути.Добавить(Идентификатор);
			КонецЕсли;
		Иначе
			Позиция = Позиция + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Упоминания;

КонецФункции

// Идентификатор - служебное слово языка запросов, а не поле источника.
// Имена функций тоже перечислены: без скобок они полем быть не могут.
Функция ЭтоКлючевоеСловоУпоминаний(ИмяВрег)

	Возврат СтрНайти(
		",ВЫБРАТЬ,ИЗ,ГДЕ,КАК,ПО,В,НЕ,И,ИЛИ,МЕЖДУ,ПОДОБНО,ЕСТЬ,ССЫЛКА,ИЕРАРХИЯ,"
		+ "ИЕРАРХИИ,ТОЛЬКО,ВЫБОР,КОГДА,ТОГДА,ИНАЧЕ,КОНЕЦ,NULL,НЕОПРЕДЕЛЕНО,"
		+ "ИСТИНА,ЛОЖЬ,РАЗЛИЧНЫЕ,РАЗРЕШЕННЫЕ,ПЕРВЫЕ,ПОМЕСТИТЬ,ДОБАВИТЬ,"
		+ "УНИЧТОЖИТЬ,ОБЪЕДИНИТЬ,ВСЕ,ВНУТРЕННЕЕ,ЛЕВОЕ,ПРАВОЕ,ПОЛНОЕ,СОЕДИНЕНИЕ,"
		+ "УПОРЯДОЧИТЬ,СГРУППИРОВАТЬ,ИМЕЮЩИЕ,ИТОГИ,ОБЩИЕ,ПЕРИОДАМИ,"
		+ "ИНДЕКСИРОВАТЬ,АВТОУПОРЯДОЧИВАНИЕ,ИНДЕКС,НАБОРАМ,УБЫВ,ВОЗР,ДЛЯ,"
		+ "ИЗМЕНЕНИЯ,ОБЪЕКТОВ,ПУСТАЯТАБЛИЦА,КОЛИЧЕСТВО,СУММА,МИНИМУМ,МАКСИМУМ,"
		+ "СРЕДНЕЕ,ВЫРАЗИТЬ,ПОДСТРОКА,ТИПЗНАЧЕНИЯ,ПРЕДСТАВЛЕНИЕ,"
		+ "ПРЕДСТАВЛЕНИЕССЫЛКИ,ЕСТЬNULL,ДАТАВРЕМЯ,ГОД,КВАРТАЛ,МЕСЯЦ,НЕДЕЛЯ,ДЕНЬ,"
		+ "ДЕНЬГОДА,ДЕНЬНЕДЕЛИ,ЧАС,МИНУТА,СЕКУНДА,НАЧАЛОПЕРИОДА,КОНЕЦПЕРИОДА,"
		+ "ДОБАВИТЬКДАТЕ,РАЗНОСТЬДАТ,ЗНАЧЕНИЕ,ТИП,",
		"," + ИмяВрег + ",") > 0;

КонецФункции

// Путь поля ведёт к секрету, если резолвится в реквизит с режимом пароля или
// именем-секретом: квалифицированный - через псевдоним источника,
// неквалифицированный - по каждой реальной таблице области.
Функция ПутьВедётКСекретномуРеквизиту(Область, Путь)

	Сегменты = СтрРазделить(Путь, ".", Ложь);
	Если Сегменты.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Сегменты.Количество() >= 2 Тогда
		МетаданныеАлиаса = Область.Алиасы[ВРег(Сегменты[0])];
		Если МетаданныеАлиаса <> Неопределено Тогда
			ОстатокПути = Новый Массив;
			Для ИндексСегмента = 1 По Сегменты.Количество() - 1 Цикл
				ОстатокПути.Добавить(Сегменты[ИндексСегмента]);
			КонецЦикла;
			Возврат ПутьВедётКСекретуВМетаданных(МетаданныеАлиаса, ОстатокПути);
		КонецЕсли;
	КонецЕсли;

	Для Каждого МетаданныеТаблицы Из Область.ТаблицыМетаданных Цикл
		Если ПутьВедётКСекретуВМетаданных(МетаданныеТаблицы, Сегменты) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Цепочка сегментов резолвится по метаданным: промежуточные сегменты обязаны
// быть ссылками (составной тип разыменовывается по каждому типу), последний
// проверяется на режим пароля и имя-секрет.
Функция ПутьВедётКСекретуВМетаданных(МетаданныеОбъекта, Сегменты)

	ТекущиеОбъекты = Новый Массив;
	ТекущиеОбъекты.Добавить(МетаданныеОбъекта);
	ИндексПоследнего = Сегменты.Количество() - 1;

	Для ИндексСегмента = 0 По ИндексПоследнего Цикл
		ИмяСегмента = Сегменты[ИндексСегмента];
		ЭтоПоследний = ИндексСегмента = ИндексПоследнего;
		СледующиеОбъекты = Новый Массив;
		СекретНайден = Ложь;
		Для Каждого ОбъектМетаданных Из ТекущиеОбъекты Цикл
			Элемент = НайтиВКоллекцияхМетаданных(ОбъектМетаданных, ИмяСегмента);
			Если Элемент = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Если ЭтоПоследний Тогда
				Если РежимПароляЭлементаМетаданных(Элемент)
					Или ЭтоИмяСекрета(Элемент.Имя) Тогда
					СекретНайден = Истина;
				КонецЕсли;
			Иначе
				Для Каждого МетаданныеТипа Из СсылочныеМетаданныеЭлемента(Элемент) Цикл
					СледующиеОбъекты.Добавить(МетаданныеТипа);
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
		Если ЭтоПоследний Тогда
			Возврат СекретНайден;
		КонецЕсли;
		Если СледующиеОбъекты.Количество() = 0 Тогда
			// Путь по метаданным не разыменовывается - секрет недоказуем.
			Возврат Ложь;
		КонецЕсли;
		ТекущиеОбъекты = СледующиеОбъекты;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Метаданные ссылочных типов реквизита; нессылочные типы не возвращают
// метаданных и просто отбрасываются.
Функция СсылочныеМетаданныеЭлемента(Элемент)

	Результат = Новый Массив;
	Попытка
		Для Каждого ТипЭлемента Из Элемент.Тип.Типы() Цикл
			Попытка
				МетаданныеТипа = Метаданные.НайтиПоТипу(ТипЭлемента);
				Если МетаданныеТипа <> Неопределено Тогда
					Результат.Добавить(МетаданныеТипа);
				КонецЕсли;
			Исключение
			КонецПопытки;
		КонецЦикла;
	Исключение
	КонецПопытки;
	Возврат Результат;

КонецФункции

// &П.Поле - разыменование параметра-ссылки: тип фактического значения
// определяет метаданные, по которым резолвится остаток пути.
Функция РазыменованиеПараметраВедётКСекрету(Разыменование, ПараметрыЗапроса)

	Для Каждого ПараметрЗапроса Из ПараметрыЗапроса Цикл
		Если ВРег(ПараметрЗапроса.Ключ) <> ВРег(Разыменование.Имя) Тогда
			Продолжить;
		КонецЕсли;
		МетаданныеЗначения = Неопределено;
		Попытка
			МетаданныеЗначения = Метаданные.НайтиПоТипу(
				ТипЗнч(ПараметрЗапроса.Значение));
		Исключение
		КонецПопытки;
		Если МетаданныеЗначения = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
		Возврат ПутьВедётКСекретуВМетаданных(
			МетаданныеЗначения, Разыменование.Сегменты);
	КонецЦикла;
	Возврат Ложь;

КонецФункции
