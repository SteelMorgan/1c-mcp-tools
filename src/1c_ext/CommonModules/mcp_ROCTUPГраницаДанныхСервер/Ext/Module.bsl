//Функция ПроверитьLineageРезультатаЗапроса(Результат, Схема)
Функция ПроверитьLineageРезультатаЗапроса(Результат, Схема, КонтекстВызова = Неопределено)
//**agent TASK-225
	// Успешный адаптер execute_query выдаёт ровно success/data/schema.
	// Любое другое поле может быть запасной копией значений вне data.
	Если ТипЗнч(Результат) <> Тип("Структура")
		Или Не Результат.Свойство("success")
		Или Не Результат.Свойство("data")
		Или Не Результат.Свойство("schema")
		Или Результат.Количество() <> 3 Тогда
		Возврат Ложь;
	КонецЕсли;

	Данные = Свойство(Результат, "data", Неопределено);
	Если ТипЗнч(Данные) <> Тип("Массив") Тогда
		Возврат Ложь;
	КонецЕсли;
	Колонки = Свойство(Схема, "columns", Неопределено);
	Если ТипЗнч(Колонки) <> Тип("Массив") Или Колонки.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

//**agent TASK-225 [25.09.2026 13:30:00]
	// Инвариант временных таблиц: execute_query работает без внешнего
	// МенеджерВременныхТаблиц, поэтому источник-таблица без метаданных обязан
	// быть создан ПОМЕСТИТЬ в этом же пакете. Заодно разбираются безполевые
	// выражения колонок без источников (счётчики, литералы, параметры,
	// ЗНАЧЕНИЕ) - разбор только по объектам СхемаЗапроса и Запрос.Параметры.
	// Анализ идёт до сокращения пустого результата: упоминание секретного
	// реквизита - отказ даже при пустой выборке.
	АнализЗапроса = АнализЗапросаГраницы(
		ЗначениеКонтекста(КонтекстВызова, "query", ""),
		Колонки,
		ЗначениеКонтекста(КонтекстВызова, "params", Неопределено));
	Если Не АнализЗапроса.ИсточникиДопустимы
		Или АнализЗапроса.ЕстьУпоминаниеСекрета Тогда
		Возврат Ложь;
	КонецЕсли;
//**agent TASK-225

	Если Данные.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;

	ИменаКолонок = Новый Соответствие;
//**agent TASK-225 [25.09.2026 13:30:00]
//	Для Каждого Колонка Из Колонки Цикл
//		ИмяКолонки = Свойство(Колонка, "name", "");
//		Источники = Свойство(Колонка, "sources", Неопределено);
//		Если ТипЗнч(ИмяКолонки) <> Тип("Строка") Или ПустаяСтрока(ИмяКолонки)
//			Или ТипЗнч(Источники) <> Тип("Массив") Или Источники.Количество() = 0 Тогда
//			Возврат Ложь;
//		КонецЕсли;
	Для ИндексКолонки = 0 По Колонки.Количество() - 1 Цикл
		Колонка = Колонки[ИндексКолонки];
		ИмяКолонки = Свойство(Колонка, "name", "");
		Источники = Свойство(Колонка, "sources", Неопределено);
		Если ТипЗнч(ИмяКолонки) <> Тип("Строка") Или ПустаяСтрока(ИмяКолонки) Тогда
			Возврат Ложь;
		КонецЕсли;
		Если ТипЗнч(Источники) <> Тип("Массив") Или Источники.Количество() = 0 Тогда
			// Анализатор не разворачивает * и удерживает sources у колонок
			// с секретными именами: голое поле доказуемо через метаданные.
			Восстановленные = АнализЗапроса.ВосстановленныеИсточники[
				ИндексКолонки];
			Если Восстановленные <> Неопределено Тогда
				Колонка.Вставить("sources", Восстановленные);
				Источники = Восстановленные;
			КонецЕсли;
		КонецЕсли;
		Если ТипЗнч(Источники) <> Тип("Массив") Или Источники.Количество() = 0 Тогда
			// Колонка без sources допустима только при доказанном безполевом
			// выражении во всех операторах объединения; заявленный тип колонки и
			// фактические значения обязаны совпасть с типами из разбора.
			Допуск = АнализЗапроса.ДопускиКолонок[ИндексКолонки];
			Если Допуск = Неопределено
				Или Не ТипыКолонкиСогласованы(
					Свойство(Колонка, "types", Неопределено), Допуск.ДопустимыеТипы)
				Или Не ЗначенияКолонкиСогласованы(Данные, ИмяКолонки, Допуск.ДопустимыеТипы) Тогда
				Возврат Ложь;
			КонецЕсли;
			// Сквозной контракт безисточниковой колонки: сервис видит явный
			// вид допуска, sources остаётся пустым массивом.
			Колонка.Вставить("sources", Новый Массив);
			Колонка.Вставить("sourceless", Допуск.Вид);
		Иначе
//**agent TASK-225
		Для Каждого ПутьИсточника Из Источники Цикл
			Если ТипЗнч(ПутьИсточника) <> Тип("Строка")
				Или ПустаяСтрока(ПутьИсточника)
				Или НайтиЭлементМетаданныхПоПути(ПутьИсточника) = Неопределено Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЦикла;
//**agent TASK-225 [25.09.2026 13:30:00]
		КонецЕсли;
//**agent TASK-225
		ИменаКолонок.Вставить(ИмяКолонки, Истина);
	КонецЦикла;

	Для Каждого СтрокаДанных Из Данные Цикл
		Если ТипЗнч(СтрокаДанных) <> Тип("Структура")
			И ТипЗнч(СтрокаДанных) <> Тип("Соответствие") Тогда
			Возврат Ложь;
		КонецЕсли;
		Для Каждого Пара Из СтрокаДанных Цикл
			Если ИменаКолонок.Получить(Пара.Ключ) <> Истина Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Истина;
КонецФункции
