Функция СодержитСекретВТексте(Текст)
	НормализованныйТекст = НРег(Строка(Текст));
	// Маркеры присваиваний/значений консолидированы с сервисом (этап Y4):
	// secret_assignment/secret_value в domain/masking.rs - держать синхронно.
	Для Каждого Маркер Из СтрРазделить(
		"authorization:,bearer ,пароль=,password=,passwd=,passphrase=,секретнаяфраза=,secret=,token=,токен=,секрет=,ключ=,access_token,refresh_token,api_key,private_key,-----begin private key-----,private key-----,-----begin rsa private key-----", ",") Цикл
		Если Найти(НормализованныйТекст, Маркер) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
