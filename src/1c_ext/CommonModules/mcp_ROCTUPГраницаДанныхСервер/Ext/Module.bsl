Функция ПрочитатьЧисловойКурсор(Курсор, Префикс)
	Если Курсор = Неопределено Или ПустаяСтрока(Строка(Курсор)) Тогда
		Возврат 0;
	КонецЕсли;
	Если ТипЗнч(Курсор) <> Тип("Строка") Или Не СтрНачинаетсяС(Курсор, Префикс) Тогда
		Возврат -1;
	КонецЕсли;
	Попытка
		ЗначениеКурсора = Число(Сред(Курсор, СтрДлина(Префикс) + 1));
		Возврат ?(ЗначениеКурсора >= 0 И ЗначениеКурсора = Цел(ЗначениеКурсора), ЗначениеКурсора, -1);
	Исключение
		Возврат -1;
	КонецПопытки;
КонецФункции

Функция ПрочитатьСтроковыйКурсор(Курсор, Префикс)
	Если Курсор = Неопределено Или ПустаяСтрока(Строка(Курсор)) Тогда
		Возврат "";
	КонецЕсли;
	Если ТипЗнч(Курсор) <> Тип("Строка") Или Не СтрНачинаетсяС(Курсор, Префикс) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Сред(Курсор, СтрДлина(Префикс) + 1);
КонецФункции

