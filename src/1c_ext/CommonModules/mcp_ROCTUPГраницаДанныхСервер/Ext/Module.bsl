// Источники одной колонки: поля по операторам объединения позиционно
// (Поля[i] соответствует Операторы[i]); выражение - упоминания полей из
// ИзвлечьУпоминанияПолей; вложенная таблица - путь самой ТЧ плюс хвосты
// её внутренних выражений, разрешённые от метаданных ТЧ.
// Доказано = Ложь при любом нерезолвленном упоминании, разыменовании
// параметра, неизвестном типе поля или рассинхроне позиций - частичное
// происхождение не доказано.
//**agent TASK-225 [27.09.2026 16:01:00]
//	Пятый параметр - кэш вызова (этап Z): запись колонки считается один
//	раз на (запрос, индекс, глубина); одна и та же колонка ВТ/подзапроса
//	резолвится из многих внешних ссылок. Делится только внутри вызова.
//Функция LineageИсточникиКолонки(ЗапросВыбора, ИндексКолонки, КартаВТ, Глубина)
Функция LineageИсточникиКолонки(ЗапросВыбора, ИндексКолонки, КартаВТ, Глубина,
	КэшВызова = Неопределено)
//**agent TASK-225

//++agent TASK-225 [27.09.2026 16:01:00]
	Если КэшВызова = Неопределено Тогда
		КэшВызова = LineageНовыйКэшВызова();
	КонецЕсли;
	КлючКолонки = Строка(ИндексКолонки) + "/" + Строка(Глубина);
	КэшКолонок = КэшВызова.КолонкиЗапросов[ЗапросВыбора];
	Если КэшКолонок = Неопределено Тогда
		КэшКолонок = Новый Соответствие;
		КэшВызова.КолонкиЗапросов.Вставить(ЗапросВыбора, КэшКолонок);
	Иначе
		ЗаписьКэша = КэшКолонок[КлючКолонки];
		Если ЗаписьКэша <> Неопределено Тогда
			Возврат ЗаписьКэша;
		КонецЕсли;
	КонецЕсли;
//++agent TASK-225

	Запись = Новый Структура("Пути, Доказано", Новый Массив, Истина);
	Если Глубина > 8 Тогда
		Запись.Доказано = Ложь;
//++agent TASK-225 [27.09.2026 16:01:00]
