//**agent TASK-225 [27.09.2026 15:30:00]
// Экспорт для lineage_dump инструмента замеров: финальные пути колонок
// считаются тем же кодом, что применяет источники в боевой границе.
Функция LineageПрименитьИсточникиПлатформы(Схема, ИсточникиПлатформы) Экспорт
//**agent TASK-225

	Если ТипЗнч(ИсточникиПлатформы) <> Тип("Массив") Тогда
		// Текст не разобран платформой: схема остаётся как есть.
		Возврат Схема;
	КонецЕсли;
	Колонки = Свойство(Схема, "columns", Неопределено);
	Если ТипЗнч(Колонки) <> Тип("Массив") Тогда
		Возврат Схема;
	КонецЕсли;

	Для Индекс = 0 По Колонки.Количество() - 1 Цикл
		Колонка = Колонки[Индекс];
		ПутиНовые = Новый Массив;
		Если Индекс < ИсточникиПлатформы.Количество() Тогда
			ЗаписьКолонки = ИсточникиПлатформы[Индекс];
			// Псевдоним колонки запроса результата обязан совпасть с именем
			// в схеме: иначе соотнесение по индексу не доказано.
			Если ЗаписьКолонки.Доказано
				И ВРег(ЗаписьКолонки.Псевдоним)
					= ВРег(Свойство(Колонка, "name", "")) Тогда
				ПутиНовые = ЗаписьКолонки.Пути;
			КонецЕсли;
		КонецЕсли;

		Итог = LineageОбъединениеПутей(ПутиНовые);
		Если Итог.Количество() > 0 Тогда
			Колонка.Вставить("sources", Итог);
		КонецЕсли;
	КонецЦикла;
	Возврат Схема;

