Функция ВыполнитьБезопасныйЗапросСловаря(
	ОписаниеИсточника, ПоследнееЗначение, Лимит, ОтборСловаря)

	ТекстЗапроса =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ " + Формат(Лимит, "ЧГ=0") + Символы.ПС
		+ " Источник." + ОписаниеИсточника.ИмяПоля + " КАК Значение" + Символы.ПС
		+ "ИЗ " + ОписаниеИсточника.ТаблицаЗапроса + " КАК Источник" + Символы.ПС
		+ "ГДЕ Источник." + ОписаниеИсточника.ИмяПоля + " > &ПоследнееЗначение";
	Если Не ПустаяСтрока(ОтборСловаря.Текст) Тогда
		ТекстЗапроса = ТекстЗапроса + Символы.ПС + " И (" + ОтборСловаря.Текст + ")";
	КонецЕсли;
	ТекстЗапроса = ТекстЗапроса + Символы.ПС
		+ "УПОРЯДОЧИТЬ ПО Значение";
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ПоследнееЗначение", ПоследнееЗначение);
	Для Каждого ПараметрОтбора Из ОтборСловаря.Параметры Цикл
		Запрос.УстановитьПараметр(ПараметрОтбора.Ключ, ПараметрОтбора.Значение);
	КонецЦикла;
	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Выборка.Значение) Тогда
			Результат.Добавить(Строка(Выборка.Значение));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция НайтиВКоллекцияхМетаданных(ОбъектМетаданных, ИмяЭлемента)
	Если ИмяЭлемента = "Ссылка" Тогда
		// Системное поле принимается только через metadata объекта,
		// чтобы произвольный suffix ".Ссылка" не обходил fail-closed.
		Попытка
			СтандартнаяСсылка = ОбъектМетаданных.СтандартныеРеквизиты.Ссылка;
			Если СтандартнаяСсылка <> Неопределено
				И СтандартнаяСсылка.Имя = "Ссылка"
				И ТипыЭлементаМетаданных(СтандартнаяСсылка).Количество() > 0 Тогда
				Возврат СтандартнаяСсылка;
			КонецЕсли;
		Исключение
		КонецПопытки;
		Возврат Неопределено;
	КонецЕсли;
	Для Каждого ИмяКоллекции Из СтрРазделить(
		"Реквизиты,СтандартныеРеквизиты,ТабличныеЧасти,Измерения,Ресурсы,Поля,"
		+ "РеквизитыАдресации,СтандартныеТабличныеЧасти", ",") Цикл
		Коллекция = Неопределено;
		Попытка
			Коллекция = Вычислить("ОбъектМетаданных." + ИмяКоллекции);
		Исключение
			Продолжить;
		КонецПопытки;
		Попытка
			Найденный = Коллекция.Найти(ИмяЭлемента);
			Если Найденный <> Неопределено Тогда
				Возврат Найденный;
			КонецЕсли;
		Исключение
		КонецПопытки;
		// Стандартные реквизиты 1С доступны как именованные свойства коллекции,
		// но поиск через Найти может не вернуть их в конкретном server context.
		Если ИмяКоллекции = "СтандартныеРеквизиты" Тогда
			Если ИмяЭлемента = "Наименование" Тогда
				Попытка
					Возврат Коллекция.Наименование;
				Исключение
				КонецПопытки;
			КонецЕсли;
			Попытка
				Для Каждого СтандартныйРеквизит Из Коллекция Цикл
					Если СтандартныйРеквизит.Имя = ИмяЭлемента Тогда
						Возврат СтандартныйРеквизит;
					КонецЕсли;
				КонецЦикла;
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

