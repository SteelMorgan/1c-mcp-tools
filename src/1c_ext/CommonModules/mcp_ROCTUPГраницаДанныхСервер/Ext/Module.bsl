// сравнение полной длины - whitelist-фильтры JSON не должны течь через
// ранний выход по первому различию.
Функция ТочныеСтроки(Первая, Вторая)
	Если ТипЗнч(Первая) <> Тип("Строка") Или ТипЗнч(Вторая) <> Тип("Строка")
		Или СтрДлина(Первая) <> СтрДлина(Вторая) Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Индекс = 1 По СтрДлина(Первая) Цикл
		Если КодСимвола(Первая, Индекс) <> КодСимвола(Вторая, Индекс) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции
