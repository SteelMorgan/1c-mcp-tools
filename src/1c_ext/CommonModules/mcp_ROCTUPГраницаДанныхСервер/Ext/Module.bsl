Функция ЭтоИмяСекрета(ИмяПоля)
	// Нормализация убирает только "_" и "-": имена метаданных состоят из
	// букв/цифр/подчёркиваний, поэтому этой нормализации достаточно, и
	// список маркеров совпадает с сервисным compact_secret_name. В сервисе
	// нормализация шире (убираются все не-буквенно-цифровые символы):
	// она применяется и к JSON-именам вне метаданных.
	НормализованноеИмя = НРег(СтрЗаменить(СтрЗаменить(Строка(ИмяПоля), "_", ""), "-", ""));
	Для Каждого Маркер Из СтрРазделить(
		"пароль,password,passwd,passphrase,секретнаяфраза,token,токен,authorization,авторизац,apikey,ключapi,ключапи,secret,секрет,privatekey,приватныйключ,accesskey,refreshkey", ",") Цикл
		Если Найти(НормализованноеИмя, Маркер) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
