		"authorization:,bearer ,пароль=,password=,passwd=,passphrase=,access_token,refresh_token,api_key,private_key,-----begin private key-----,-----begin rsa private key-----", ",") Цикл
		Если Найти(НормализованныйТекст, Маркер) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
