// Происхождение колонок результата по СхемаЗапроса (этап Y2, единственный
// разбор с Y4): массив по индексу колонки запроса результата структур
// {Псевдоним, Пути, Доказано}. Пути - канонические
// Вид.Объект[.ТЧ].Реквизит, проверяемые дальше НайтиЭлементМетаданныхПоПути.
// Доказано = Ложь, когда часть выражения не резолвится - такие Пути
// частичные и в итог sources не идут. Неопределено - текст платформой не
// разобран или запроса результата нет: для границы это отсутствие
// доказанного происхождения (fail-closed сохраняется выше).
//**agent TASK-225 [27.09.2026 15:30:00]
// Экспорт для постоянного инструмента замеров mcp_diag_query_parse_bench
// (этап Z): этапы schema_lineage и lineage_dump читают разбор напрямую.
Функция LineageПоСхемеЗапроса(ТекстЗапроса) Экспорт
//**agent TASK-225

	Если ПустаяСтрока(ТекстЗапроса) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		СхемаЗапроса = Новый СхемаЗапроса;
		СхемаЗапроса.УстановитьТекстЗапроса(ТекстЗапроса);
	Исключение
		// Неразобранный текст - аномалия, происхождение не доказано.
		Возврат Неопределено;
	КонецПопытки;

	КартаВременныхТаблиц = LineageКартаВременныхТаблиц(СхемаЗапроса);

	// Результат пакета - последний запрос выбора без ПОМЕСТИТЬ/ДОБАВИТЬ:
	// так считает платформа (после него могут идти УНИЧТОЖИТЬ).
	ЗапросРезультата = Неопределено;
	Для СчётчикПакета = 1 По СхемаЗапроса.ПакетЗапросов.Количество() Цикл
		ЗапросПакета = СхемаЗапроса.ПакетЗапросов[
			СхемаЗапроса.ПакетЗапросов.Количество() - СчётчикПакета];
		Если ТипЗнч(ЗапросПакета) = Тип("ЗапросВыбораСхемыЗапроса")
			И ПустаяСтрока(ЗапросПакета.ТаблицаДляПомещения)
			И ПустаяСтрока(ЗапросПакета.ТаблицаДляДобавления) Тогда
			ЗапросРезультата = ЗапросПакета;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если ЗапросРезультата = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = Новый Массив;
//++agent TASK-225 [27.09.2026 16:01:00]
	// Кэш вызова (этап Z): кандидаты операторов, тексты выражений и записи
	// колонок подчинённых запросов делятся между колонками пакета.
	КэшВызова = LineageНовыйКэшВызова();
//++agent TASK-225
	Попытка
		Для ИндексКолонки = 0 По ЗапросРезультата.Колонки.Количество() - 1 Цикл
			ЗаписьКолонки = LineageИсточникиКолонки(
//**agent TASK-225 [27.09.2026 16:01:00]
//				ЗапросРезультата, ИндексКолонки, КартаВременныхТаблиц, 0);
				ЗапросРезультата, ИндексКолонки, КартаВременныхТаблиц, 0,
				КэшВызова);
//**agent TASK-225
			ЗаписьКолонки.Вставить("Псевдоним",
				ЗапросРезультата.Колонки[ИндексКолонки].Псевдоним);
			Результат.Добавить(ЗаписьКолонки);
		КонецЦикла;
	Исключение
		// Объекты схемы бросают исключения на нестандартных конструкциях:
		// частичный разбор недоказуем целиком.
		Возврат Неопределено;
	КонецПопытки;
	Возврат Результат;

КонецФункции
