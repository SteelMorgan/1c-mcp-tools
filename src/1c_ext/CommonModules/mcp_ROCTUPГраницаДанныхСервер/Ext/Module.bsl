// Пути без повторов по регистру: дубликат пути не добавляется.
Процедура LineageДобавитьУникальныеПути(Приёмник, ИсточникиПутей)

	УжеЕсть = Новый Соответствие;
	Для Каждого Путь Из Приёмник Цикл
		УжеЕсть.Вставить(ВРег(Строка(Путь)), Истина);
	КонецЦикла;
	Для Каждого Путь Из ИсточникиПутей Цикл
		Если УжеЕсть[ВРег(Строка(Путь))] = Истина Тогда
			Продолжить;
		КонецЕсли;
		УжеЕсть.Вставить(ВРег(Строка(Путь)), Истина);
		Приёмник.Добавить(Путь);
	КонецЦикла;

КонецПроцедуры

Функция LineageУникальныеПути(Пути)

	Результат = Новый Массив;
	LineageДобавитьУникальныеПути(Результат, Пути);
