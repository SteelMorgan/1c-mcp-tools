Функция ЭтоИмяСекрета(ИмяПоля)
	НормализованноеИмя = НРег(СтрЗаменить(СтрЗаменить(Строка(ИмяПоля), "_", ""), "-", ""));
	Для Каждого Маркер Из СтрРазделить(
		"пароль,password,passwd,passphrase,секретнаяфраза,token,токен,authorization,авторизац,apikey,ключapi,ключапи,secret,секрет,privatekey,accesskey,refreshkey", ",") Цикл
		Если Найти(НормализованноеИмя, Маркер) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
