// неквалифицированный - по каждой реальной таблице области.
Функция ПутьВедётКСекретномуРеквизиту(Область, Путь)

	Сегменты = СтрРазделить(Путь, ".", Ложь);
	Если Сегменты.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Сегменты.Количество() >= 2 Тогда
