Функция КолонкаСодержитСекрет(Колонка)
	Источники = Свойство(Колонка, "sources", Новый Массив);
	Если ТипЗнч(Источники) <> Тип("Массив") Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого ПутьИсточника Из Источники Цикл
		ЭлементМетаданных = НайтиЭлементМетаданныхПоПути(ПутьИсточника);
		Если ЭлементМетаданных <> Неопределено
			И (РежимПароляЭлементаМетаданных(ЭлементМетаданных)
				Или ЭтоИмяСекрета(ЭлементМетаданных.Имя)) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Процедура ДобавитьПоляКоллекцииМетаданных(Результат, КоллекцияОбъектов, СостояниеСбора)
	Если Не СостояниеСбора.Полно Тогда Возврат; КонецЕсли;
	Для Каждого ОбъектМетаданных Из КоллекцияОбъектов Цикл
		ПолноеИмяОбъекта = ОбъектМетаданных.ПолноеИмя();
		КонтрактКоллекций = КоллекцииКлассаМетаданныхFeed(ПолноеИмяОбъекта, Ложь);
		Если КонтрактКоллекций = Неопределено Тогда
			СостояниеСбора.Полно = Ложь;
			Возврат;
		КонецЕсли;
		ДобавитьПоляОбъектаМетаданных(Результат, ОбъектМетаданных, ПолноеИмяОбъекта, "", СостояниеСбора);
		Если Не СостояниеСбора.Полно Тогда Возврат; КонецЕсли;
		Если Не КонтрактКоллекций.ТабличныеЧасти Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			КоллекцииТЧ = Новый Массив;
			КоллекцииТЧ.Добавить("ТабличныеЧасти");
			Если КонтрактКоллекций.СтандартныеТабличныеЧасти Тогда
				КоллекцииТЧ.Добавить("СтандартныеТабличныеЧасти");
			КонецЕсли;
			Для Каждого ИмяКоллекцииТЧ Из КоллекцииТЧ Цикл
				ТабличныеЧасти = Вычислить("ОбъектМетаданных." + ИмяКоллекцииТЧ);
				Для Каждого ТабличнаяЧасть Из ТабличныеЧасти Цикл
					ДобавитьПоляОбъектаМетаданных(
						Результат, ТабличнаяЧасть, ПолноеИмяОбъекта, ТабличнаяЧасть.Имя + ".", СостояниеСбора,
						ИмяКоллекцииТЧ = "СтандартныеТабличныеЧасти");
					Если Не СостояниеСбора.Полно Тогда Возврат; КонецЕсли;
				КонецЦикла;
			КонецЦикла;
		Исключение
			// Исключение не доказывает, что у metadata class нет табличных частей.
			СостояниеСбора.Полно = Ложь;
			Возврат;
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры

Процедура ДобавитьПоляОбъектаМетаданных(Результат, ОбъектМетаданных, ПолноеИмяОбъекта,
	ПрефиксПоля, СостояниеСбора, ЭтоСтандартнаяТЧ = Ложь)
	КонтрактКоллекций = КоллекцииКлассаМетаданныхFeed(
		ПолноеИмяОбъекта, ПрефиксПоля <> "", ЭтоСтандартнаяТЧ);
	Если КонтрактКоллекций = Неопределено Тогда
		СостояниеСбора.Полно = Ложь;
		Возврат;
	КонецЕсли;
	Для Каждого ИмяКоллекции Из СтрРазделить(КонтрактКоллекций.Поля, ",") Цикл
		Попытка
			Коллекция = Вычислить("ОбъектМетаданных." + ИмяКоллекции);
			Для Каждого Поле Из Коллекция Цикл
				СостояниеРежимаПароля = СостояниеРежимаПароляМетаданных(Поле);
				Если СостояниеРежимаПароля <> "true" И СостояниеРежимаПароля <> "false" Тогда
					СостояниеСбора.Полно = Ложь;
					Возврат;
				КонецЕсли;
//**agent TASK-222
//				ОписаниеТипов = ТипыЭлементаМетаданныхSecretV2(Поле);
				ОписаниеТипов = ОписаниеТиповЭлементаМетаданных(Поле);
//**agent TASK-222
				Если Не ОписаниеТипов.Полные Тогда
					СостояниеСбора.Полно = Ложь;
					Возврат;
				КонецЕсли;
				Типы = ОписаниеТипов.Типы;
				ОписаниеПоля = Новый Структура;
				ОписаниеПоля.Вставить("source_path",
					ПолноеИмяОбъекта + "." + ПрефиксПоля + Поле.Имя);
				ОписаниеПоля.Вставить("field_name", Поле.Имя);
				ОписаниеПоля.Вставить("field_type", СтрСоединить(Типы, ","));
				ОписаниеПоля.Вставить("password_mode", СостояниеРежимаПароля = "true");
				Результат.Добавить(ОписаниеПоля);
			КонецЦикла;
		Исключение
			// Не выдавать накопленный до ошибки список как полный metadata snapshot.
			СостояниеСбора.Полно = Ложь;
			Возврат;
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры

// Классы берутся из ПолноеИмя() локального metadata object, не selector агента.
// Матрица соответствует отдельным веткам donor ПроверитьКоллекциюМетаданных/
// ПроверитьКоллекциюРегистров; поля задачи подтверждены платформенным контрактом.
// Отсутствующая неприменимая коллекция не опрашивается. Ошибка применимой - отказ.
Функция КоллекцииКлассаМетаданныхFeed(ПолноеИмяОбъекта, ЭтоТабличнаяЧасть, ЭтоСтандартнаяТЧ = Ложь)
	Части = СтрРазделить(ПолноеИмяОбъекта, ".");
	Если Части.Количество() <> 2 Тогда Возврат Неопределено; КонецЕсли;
	Класс = Части[0];
	СсылочныеКлассы = СтрРазделить(
		"Справочник,Документ,ПланСчетов,ПланВидовХарактеристик,ПланВидовРасчета,БизнесПроцесс,Задача", ",");
	Регистры = СтрРазделить(
		"РегистрСведений,РегистрНакопления,РегистрБухгалтерии,РегистрРасчета", ",");
	ЕстьСтандартныеТЧ = Класс = "ПланСчетов" Или Класс = "ПланВидовРасчета";
	Если ЭтоТабличнаяЧасть Тогда
		Если СсылочныеКлассы.Найти(Класс) = Неопределено Тогда Возврат Неопределено; КонецЕсли;
		Если ЭтоСтандартнаяТЧ Тогда
			Если Не ЕстьСтандартныеТЧ Тогда Возврат Неопределено; КонецЕсли;
			Возврат Новый Структура("Поля,ТабличныеЧасти,СтандартныеТабличныеЧасти",
				"СтандартныеРеквизиты", Ложь, Ложь);
		КонецЕсли;
		Возврат Новый Структура("Поля,ТабличныеЧасти,СтандартныеТабличныеЧасти",
			"Реквизиты,СтандартныеРеквизиты", Ложь, Ложь);
	КонецЕсли;
	Если СсылочныеКлассы.Найти(Класс) <> Неопределено Тогда
		Поля = "Реквизиты,СтандартныеРеквизиты";
		Если Класс = "Задача" Тогда Поля = Поля + ",РеквизитыАдресации"; КонецЕсли;
		Возврат Новый Структура("Поля,ТабличныеЧасти,СтандартныеТабличныеЧасти",
			Поля, Истина, ЕстьСтандартныеТЧ);
	ИначеЕсли Регистры.Найти(Класс) <> Неопределено Тогда
		Возврат Новый Структура("Поля,ТабличныеЧасти,СтандартныеТабличныеЧасти",
			"Реквизиты,СтандартныеРеквизиты,Измерения,Ресурсы", Ложь, Ложь);
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция НайтиЭлементМетаданныхПоПути(ПутьИсточника)
	Части = СтрРазделить(Строка(ПутьИсточника), ".", Ложь);
	Если Части.Количество() < 3 Тогда
		Возврат Неопределено;
	КонецЕсли;

	ОбъектМетаданных = Неопределено;
	Попытка
		ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(Части[0] + "." + Части[1]);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Если ОбъектМетаданных = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Для Индекс = 2 По Части.Количество() - 1 Цикл
		Следующий = НайтиВКоллекцияхМетаданных(ОбъектМетаданных, Части[Индекс]);
		Если Следующий = Неопределено Тогда
//**agent TASK-225 [25.09.2026 18:00:00]
			// Цепочки разыменования (Объект.СсылочныйРеквизит.Поле):
			// промежуточный сегмент проходит только через единственный
			// ссылочный тип - составной тип не даёт доказуемой цели.
			ЦельРазыменования = МетаданныеСсылочногоТипаЭлемента(ОбъектМетаданных);
			Если ЦельРазыменования <> Неопределено Тогда
				ОбъектМетаданных = ЦельРазыменования;
				Следующий = НайтиВКоллекцияхМетаданных(
					ОбъектМетаданных, Части[Индекс]);
			КонецЕсли;
		КонецЕсли;
		Если Следующий = Неопределено Тогда
			// Системные поля (ВерсияДанных, МоментВремени и пр.) живут вне
			// коллекций метаданных; элемент принадлежит объекту по построению.
			Если Индекс = Части.Количество() - 1
				И ЭтоСистемноеПолеОбъекта(Части[Индекс]) Тогда
				Возврат ОбъектМетаданных;
			КонецЕсли;
//**agent TASK-225
			Возврат Неопределено;
		КонецЕсли;
		ОбъектМетаданных = Следующий;
	КонецЦикла;
	Возврат ОбъектМетаданных;
КонецФункции

Функция ОписаниеБезопасногоИсточника(ПутьИсточника)
	НормализованныйПуть = НормализоватьПрефиксМетаданных(ПутьИсточника);
	Части = СтрРазделить(НормализованныйПуть, ".", Ложь);
	Если Части.Количество() <> 3 И Части.Количество() <> 4 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(Части[0] + "." + Части[1]);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Если ОбъектМетаданных = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Части.Количество() = 3 Тогда
		ЭлементМетаданных = НайтиВКоллекцияхМетаданных(ОбъектМетаданных, Части[2]);
		ТаблицаЗапроса = ОбъектМетаданных.ПолноеИмя();
		ИмяПоля = Части[2];
		ОбъектМетаданныхОтбора = ОбъектМетаданных;
	Иначе
		ТабличнаяЧасть = НайтиВКоллекцияхМетаданных(ОбъектМетаданных, Части[2]);
		Если ТабличнаяЧасть = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		ЭлементМетаданных = НайтиВКоллекцияхМетаданных(ТабличнаяЧасть, Части[3]);
		ТаблицаЗапроса = ОбъектМетаданных.ПолноеИмя() + "." + ТабличнаяЧасть.Имя;
		ИмяПоля = Части[3];
		ОбъектМетаданныхОтбора = ТабличнаяЧасть;
	КонецЕсли;
	Если ЭлементМетаданных = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый Структура(
		"КаноническийПуть, ТаблицаЗапроса, ИмяПоля, ЭлементМетаданных, ОбъектМетаданныхОтбора",
		ПутьИсточника, ТаблицаЗапроса, ИмяПоля, ЭлементМетаданных, ОбъектМетаданныхОтбора);
КонецФункции

// AST переводится только в имена полей, подтверждённые metadata API, и параметры
// запроса: это сохраняет Part-фильтр, не превращая service-owned JSON в текст запроса.
Функция ПодготовитьОтборСловаря(ФильтрAST, ОписаниеИсточника)
	Если ЭтоПустоеJSONЗначение(ФильтрAST) Тогда
		Возврат Новый Структура("Успех, КодОшибки, Текст, Параметры",
			Истина, "", "", Новый Структура);
	КонецЕсли;

	Состояние = Новый Структура(
		"Успех, КодОшибки, КоличествоУзлов, НомерПараметра, Параметры",
		Истина, "", 0, 0, Новый Структура);
	ТекстОтбора = ПостроитьУсловиеОтбора(ФильтрAST, ОписаниеИсточника, Состояние, 0);
	Если Не Состояние.Успех Тогда
		Возврат Новый Структура("Успех, КодОшибки, Текст, Параметры",
			Ложь, Состояние.КодОшибки, "", Новый Структура);
	КонецЕсли;
	Возврат Новый Структура("Успех, КодОшибки, Текст, Параметры",
		Истина, "", ТекстОтбора, Состояние.Параметры);
КонецФункции

Функция ПостроитьУсловиеОтбора(Узел, ОписаниеИсточника, Состояние, Глубина)
	Если Глубина > 16 Тогда
		УстановитьОшибкуОтбора(Состояние, "FILTER_AST_UNSUPPORTED");
		Возврат "";
	КонецЕсли;
	Состояние.КоличествоУзлов = Состояние.КоличествоУзлов + 1;
	Если Состояние.КоличествоУзлов > 1024
		Или Не ЭтоJSONОбъект(Узел) Тогда
		УстановитьОшибкуОтбора(Состояние, "FILTER_AST_UNSUPPORTED");
		Возврат "";
	КонецЕсли;

	Оператор = Неопределено;
	Если Не ПолучитьСвойствоJSON(Узел, "op", Оператор)
		Или ТипЗнч(Оператор) <> Тип("Строка") Тогда
		УстановитьОшибкуОтбора(Состояние, "FILTER_AST_UNSUPPORTED");
		Возврат "";
	КонецЕсли;

	Если Оператор = "and" Или Оператор = "or" Тогда
		Если Не ОбъектJSONСодержитТолько(Узел, "op,args", 2) Тогда
			УстановитьОшибкуОтбора(Состояние, "FILTER_AST_UNSUPPORTED");
			Возврат "";
		КонецЕсли;
		Аргументы = Неопределено;
		Если Не ПолучитьСвойствоJSON(Узел, "args", Аргументы)
			Или ТипЗнч(Аргументы) <> Тип("Массив")
			Или Аргументы.Количество() = 0
			Или Аргументы.Количество() > 32 Тогда
			УстановитьОшибкуОтбора(Состояние, "FILTER_AST_UNSUPPORTED");
			Возврат "";
		КонецЕсли;
		Условия = Новый Массив;
		Для Каждого Аргумент Из Аргументы Цикл
			Условие = ПостроитьУсловиеОтбора(Аргумент, ОписаниеИсточника, Состояние, Глубина + 1);
			Если Не Состояние.Успех Тогда Возврат ""; КонецЕсли;
			Условия.Добавить("(" + Условие + ")");
		КонецЦикла;
		Возврат СтрСоединить(Условия, ?(Оператор = "and", " И ", " ИЛИ "));
	КонецЕсли;

	Если Оператор = "not" Тогда
		Аргумент = Неопределено;
		Если Не ОбъектJSONСодержитТолько(Узел, "op,arg", 2)
			Или Не ПолучитьСвойствоJSON(Узел, "arg", Аргумент) Тогда
			УстановитьОшибкуОтбора(Состояние, "FILTER_AST_UNSUPPORTED");
			Возврат "";
		КонецЕсли;
		Условие = ПостроитьУсловиеОтбора(Аргумент, ОписаниеИсточника, Состояние, Глубина + 1);
		Если Не Состояние.Успех Тогда Возврат ""; КонецЕсли;
		Возврат "НЕ (" + Условие + ")";
	КонецЕсли;

	Если Оператор = "eq" Или Оператор = "ne" Тогда
		Если Не ОбъектJSONСодержитТолько(Узел, "op,field,value", 3) Тогда
			УстановитьОшибкуОтбора(Состояние, "FILTER_AST_UNSUPPORTED");
			Возврат "";
		КонецЕсли;
		Возврат ПостроитьСравнениеОтбора(
			Узел, Оператор, ОписаниеИсточника, Состояние);
	КонецЕсли;

	Если Оператор = "in" Тогда
		Если Не ОбъектJSONСодержитТолько(Узел, "op,field,values", 3) Тогда
			УстановитьОшибкуОтбора(Состояние, "FILTER_AST_UNSUPPORTED");
			Возврат "";
		КонецЕсли;
		Возврат ПостроитьВхождениеОтбора(Узел, ОписаниеИсточника, Состояние);
	КонецЕсли;

	УстановитьОшибкуОтбора(Состояние, "FILTER_AST_UNSUPPORTED");
	Возврат "";
КонецФункции

Функция ПостроитьСравнениеОтбора(Узел, Оператор, ОписаниеИсточника, Состояние)
	ИмяПоля = Неопределено;
	ЗначениеОтбора = Неопределено;
	Если Не ПолучитьСвойствоJSON(Узел, "field", ИмяПоля)
		Или Не ПолучитьСвойствоJSON(Узел, "value", ЗначениеОтбора) Тогда
		УстановитьОшибкуОтбора(Состояние, "FILTER_AST_UNSUPPORTED");
		Возврат "";
	КонецЕсли;
	ОписаниеПоля = ОписаниеПоляОтбора(ОписаниеИсточника, ИмяПоля, Состояние);
	Если Не Состояние.Успех Тогда Возврат ""; КонецЕсли;
	ПолеЗапроса = "Источник." + ОписаниеПоля.ИмяПоля;
	Если ЭтоПустоеJSONЗначение(ЗначениеОтбора) Тогда
		Возврат ?(Оператор = "eq", ПолеЗапроса + " ЕСТЬ NULL", "НЕ " + ПолеЗапроса + " ЕСТЬ NULL");
	КонецЕсли;
	Если Не ДопустимоеЗначениеОтбора(ЗначениеОтбора, ОписаниеПоля.ЭлементМетаданных) Тогда
		УстановитьОшибкуОтбора(Состояние, "FILTER_AST_UNSUPPORTED");
		Возврат "";
	КонецЕсли;
	ИмяПараметра = ДобавитьПараметрОтбора(Состояние, ЗначениеОтбора);
	Возврат ПолеЗапроса + ?(Оператор = "eq", " = &", " <> &") + ИмяПараметра;
КонецФункции

Функция ПостроитьВхождениеОтбора(Узел, ОписаниеИсточника, Состояние)
	ИмяПоля = Неопределено;
	ЗначенияОтбора = Неопределено;
	Если Не ПолучитьСвойствоJSON(Узел, "field", ИмяПоля)
		Или Не ПолучитьСвойствоJSON(Узел, "values", ЗначенияОтбора)
		Или ТипЗнч(ЗначенияОтбора) <> Тип("Массив")
		Или ЗначенияОтбора.Количество() > 100 Тогда
		УстановитьОшибкуОтбора(Состояние, "FILTER_AST_UNSUPPORTED");
		Возврат "";
	КонецЕсли;
	ОписаниеПоля = ОписаниеПоляОтбора(ОписаниеИсточника, ИмяПоля, Состояние);
	Если Не Состояние.Успех Тогда Возврат ""; КонецЕсли;

	ЕстьNULL = Ложь;
	ЗначенияПараметра = Новый Массив;
	Для Каждого ЗначениеОтбора Из ЗначенияОтбора Цикл
		Если ЭтоПустоеJSONЗначение(ЗначениеОтбора) Тогда
			ЕстьNULL = Истина;
		ИначеЕсли ДопустимоеЗначениеОтбора(ЗначениеОтбора, ОписаниеПоля.ЭлементМетаданных) Тогда
			ЗначенияПараметра.Добавить(ЗначениеОтбора);
		Иначе
			УстановитьОшибкуОтбора(Состояние, "FILTER_AST_UNSUPPORTED");
			Возврат "";
		КонецЕсли;
	КонецЦикла;

	ПолеЗапроса = "Источник." + ОписаниеПоля.ИмяПоля;
	Условия = Новый Массив;
	Если ЗначенияПараметра.Количество() > 0 Тогда
		ИмяПараметра = ДобавитьПараметрОтбора(Состояние, ЗначенияПараметра);
		Условия.Добавить(ПолеЗапроса + " В (&" + ИмяПараметра + ")");
	КонецЕсли;
	Если ЕстьNULL Тогда
		Условия.Добавить(ПолеЗапроса + " ЕСТЬ NULL");
	КонецЕсли;
	Если Условия.Количество() = 0 Тогда Возврат "ЛОЖЬ"; КонецЕсли;
	Возврат СтрСоединить(Условия, " ИЛИ ");
КонецФункции

Функция ОписаниеПоляОтбора(ОписаниеИсточника, ИмяПоля, Состояние)
	Если ТипЗнч(ИмяПоля) <> Тип("Строка")
		Или ПустаяСтрока(ИмяПоля)
		Или СтрДлина(ИмяПоля) > 256 Тогда
		УстановитьОшибкуОтбора(Состояние, "FILTER_AST_UNSUPPORTED");
		Возврат Неопределено;
	КонецЕсли;
	ЭлементМетаданных = НайтиВКоллекцияхМетаданных(
		ОписаниеИсточника.ОбъектМетаданныхОтбора, ИмяПоля);
	Если ЭлементМетаданных = Неопределено Тогда
		УстановитьОшибкуОтбора(Состояние, "FILTER_AST_UNSUPPORTED");
		Возврат Неопределено;
	КонецЕсли;
	СостояниеРежимаПароля = СостояниеРежимаПароляМетаданных(ЭлементМетаданных);
	Если СостояниеРежимаПароля = "true"
		Или ЭтоИмяСекрета(ЭлементМетаданных.Имя) Тогда
		УстановитьОшибкуОтбора(Состояние, "DICTIONARY_SECRET_SOURCE_DENIED");
		Возврат Неопределено;
	КонецЕсли;
	// Общий resolver вызывают eq/ne/in на любой глубине and/or/not до запроса.
	Если СостояниеРежимаПароля <> "false" Тогда
		УстановитьОшибкуОтбора(Состояние, "FEED_EVIDENCE_INCOMPLETE");
		Возврат Неопределено;
	КонецЕсли;
	Возврат Новый Структура("ИмяПоля, ЭлементМетаданных",
		ЭлементМетаданных.Имя, ЭлементМетаданных);
КонецФункции

Функция ДопустимоеЗначениеОтбора(Значение, ЭлементМетаданных)
	// Строковые представления ссылок и дат намеренно не преобразуются: неоднозначная
	// конвертация расширила бы доверенную границу и могла бы отобрать не те записи.
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Строка") Тогда
		Возврат СтрДлина(Значение) <= 1024
			И ЭлементМетаданныхПоддерживаетТип(ЭлементМетаданных, "строка,string");
	ИначеЕсли ТипЗначения = Тип("Булево") Тогда
		Возврат ЭлементМетаданныхПоддерживаетТип(ЭлементМетаданных, "булево,boolean");
	ИначеЕсли ТипЗначения = Тип("Число") Тогда
		Возврат ЭлементМетаданныхПоддерживаетТип(ЭлементМетаданных, "число,number");
	КонецЕсли;
	Возврат Ложь;
КонецФункции

Функция ЭлементМетаданныхПоддерживаетТип(ЭлементМетаданных, ДопустимыеТипы)
	Для Каждого ТипЗначения Из ТипыЭлементаМетаданных(ЭлементМетаданных) Цикл
