Функция ВыполнитьСкопированныйИнструмент(ИмяИнструмента, Аргументы)

	Если ИмяИнструмента = "execute_query" Тогда
		Возврат ВыполнитьЗапрос(
			ЗначениеАргумента(Аргументы, "query", ""),
			ЗначениеАргумента(Аргументы, "params", Неопределено),
			ЗначениеАргумента(Аргументы, "limit", 100),
			Истина);
	ИначеЕсли ИмяИнструмента = "get_metadata" Тогда
		Возврат ПолучитьМетаданные(
			ЗначениеАргумента(Аргументы, "filter", ""),
			ЗначениеАргумента(Аргументы, "meta_type", ""),
			ЗначениеАргумента(Аргументы, "name_mask", ""),
			ЗначениеАргумента(Аргументы, "limit", 100),
			ЗначениеАргумента(Аргументы, "offset", 0),
			ЗначениеАргумента(Аргументы, "sections", Неопределено),
			ЗначениеАргумента(Аргументы, "extension_name", Неопределено),
			Неопределено,
			ЗначениеАргумента(Аргументы, "attribute_mask", ""));
	ИначеЕсли ИмяИнструмента = "get_object_by_link" Тогда
		Возврат ПолучитьОбъектПоНавигационнойСсылке(ЗначениеАргумента(Аргументы, "link", ""));
	ИначеЕсли ИмяИнструмента = "get_link_of_object" Тогда
		Возврат ПолучитьНавигационнуюСсылкуПоОписанию(
			ЗначениеАргумента(Аргументы, "object_description", Неопределено));
	ИначеЕсли ИмяИнструмента = "find_references_to_object" Тогда
		Возврат НайтиСсылкиНаОбъект(
			ЗначениеАргумента(Аргументы, "target_object_description", Неопределено),
			ЗначениеАргумента(Аргументы, "search_scope", Неопределено),
			ЗначениеАргумента(Аргументы, "meta_filter", Неопределено),
			ЗначениеАргумента(Аргументы, "limit_hits", 200),
			ЗначениеАргумента(Аргументы, "limit_per_meta", 20),
			ЗначениеАргумента(Аргументы, "timeout_budget_sec", 30));
	ИначеЕсли ИмяИнструмента = "get_access_rights" Тогда
		Возврат ПолучитьПраваДоступа(
			ЗначениеАргумента(Аргументы, "metadata_object", ""),
			ЗначениеАргумента(Аргументы, "user_name", ""),
			ЗначениеАргумента(Аргументы, "rights_filter", Неопределено),
			ЗначениеАргумента(Аргументы, "roles_filter", Неопределено));
	КонецЕсли;

	ВызватьИсключение "UNKNOWN_TOOL";

КонецФункции

Процедура ДобавитьИнструментROCTUP(Инструменты, Имя, Описание, Схема, Видимость = "public")
	mcp_Метаданные.ДобавитьИнструмент(
		Инструменты,
		Имя,
		Описание,
		mcp_ОбщегоНазначения.СтруктураВJSON(Схема),
		Видимость);
КонецПроцедуры

Функция СхемаВнутреннегоFeed()
	Свойства = Новый Структура;
	Свойства.Вставить("selector", Новый Структура("type, description", "object",
		"Service-owned selector. Metadata: {mode:'all',page_size}. Dictionary: {selection_id,source_path,category,filter_ast,page_size}."));
	Свойства.Вставить("cursor", Новый Структура("type, description", "string",
		"Opaque cursor returned by the previous internal page; empty for the first page."));
	Требуемые = Новый Массив;
	Требуемые.Добавить("selector");
	Возврат Новый Структура("type, properties, required", "object", Свойства, Требуемые);
КонецФункции

Функция ЗначениеАргумента(Аргументы, Имя, ЗначениеПоУмолчанию)
	Значение = Неопределено;
	Если Аргументы <> Неопределено И Аргументы.Свойство(Имя, Значение) Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат ЗначениеПоУмолчанию;
КонецФункции

Функция JSONБезопаснойОшибки(Код, ИдентификаторОшибки)
	Результат = Новый Структура("success, error, correlation_id", Ложь, Код, ИдентификаторОшибки);
	Возврат mcp_ОбщегоНазначения.СтруктураВJSON(Результат);
КонецФункции

Функция БезопасныеМетаданныеФильтры(ИмяИнструмента, Аргументы)
	Если ИмяИнструмента <> "get_metadata" И ИмяИнструмента <> "find_references_to_object" Тогда Возврат Истина; КонецЕсли;
	Для Каждого ИмяПоля Из СтрРазделить("filter,meta_type,name_mask,meta_filter,attribute_mask", ",") Цикл
		Значение = ЗначениеАргумента(Аргументы, ИмяПоля, "");
		Если ТипЗнч(Значение) = Тип("Строка") Тогда
			Для Индекс = 1 По СтрДлина(Значение) Цикл
				Если Найти("()[]{};=&|<>", Сред(Значение, Индекс, 1)) > 0 Тогда Возврат Ложь; КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции
