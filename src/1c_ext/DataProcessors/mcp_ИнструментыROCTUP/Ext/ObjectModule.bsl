Функция НайтиRegexСовпадения(ПравилаJSON, ТекстыJSON)
	ИмяФайла = ПолучитьИмяВременногоФайла("so");
	Попытка
		ПолучитьМакет("RegexHelper").Записать(ИмяФайла);
		Если Не ПодключитьВнешнююКомпоненту(ИмяФайла, "RegexH", ТипВнешнейКомпоненты.Native) Тогда
			ВызватьИсключение "REGEX_NATIVE_UNAVAILABLE";
		КонецЕсли;
		Компонента = Новый("AddIn.RegexH.RegexHelper");
		Результат = Компонента.НайтиСовпаденияВТекстах(ПравилаJSON, ТекстыJSON);
		УдалитьФайлы(ИмяФайла);
		Возврат Результат;
	Исключение
		УдалитьФайлы(ИмяФайла);
		ВызватьИсключение "REGEX_NATIVE_UNAVAILABLE";
	КонецПопытки;
КонецФункции
