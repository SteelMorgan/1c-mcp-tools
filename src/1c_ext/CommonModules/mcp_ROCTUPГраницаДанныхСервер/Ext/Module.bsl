// mcp_ГраницаДанныхКэш и внутренних резолвов границы (этап Z): один
// проход НайтиЭлементМетаданныхПоПути даёт все факты, которые потребители
// раньше считали повторными обходами метаданных. Семантика резолва не
// меняется: СистемныйХвост - путь принят правилом системного поля
// объекта (резолвер вернул сам объект-контекст, а не поле); Канон -
// ПолноеИмя() элемента с вычисткой служебных сегментов коллекций по
// позиции (см. LineageКанонЭлемента), в исходном регистре записи, как у
// LineageКанонПути до ВРег - эмит путей пишется регистром метаданных.
// Результат неизменяем: дескрипторы разделяются сессионным кэшем.
Функция LineageОписаниеПути(ПутьИсточника) Экспорт

	Описание = Новый Структура(
		"Существует, Канон, Имя, Типы, Парольный, Секрет,"
		+ " ЕстьТип, ЦелиСсылок, ЦельЕдинственная, СистемныйХвост",
		Ложь, "", "", Неопределено, Ложь, Ложь, Ложь, Неопределено, "", Ложь);
	Элемент = НайтиЭлементМетаданныхПоПути(ПутьИсточника);
	Если Элемент = Неопределено Тогда
		Описание.Типы = Новый ФиксированныйМассив(Новый Массив);
		Описание.ЦелиСсылок = Новый ФиксированныйМассив(Новый Массив);
		Возврат Новый ФиксированнаяСтруктура(Описание);
	КонецЕсли;

	Описание.Существует = Истина;
	Описание.Канон = LineageКанонЭлемента(Элемент);
	Попытка
		Описание.Имя = Элемент.Имя;
	Исключение
	КонецПопытки;
	Попытка
		КонтрольТипа = Элемент.Тип;
		Описание.ЕстьТип = Истина;
	Исключение
	КонецПопытки;
	Описание.Парольный = РежимПароляЭлементаМетаданных(Элемент);
	Описание.Секрет = Описание.Парольный
		Или ЭтоИмяСекрета(Описание.Имя);
	Описание.Типы = Новый ФиксированныйМассив(
		ТипыЭлементаМетаданных(Элемент));
	ЦелиСсылок = Новый Массив;
	Для Каждого МетаданныеТипа Из СсылочныеМетаданныеЭлемента(Элемент) Цикл
		ЦелиСсылок.Добавить(МетаданныеТипа.ПолноеИмя());
	КонецЦикла;
	Описание.ЦелиСсылок = Новый ФиксированныйМассив(ЦелиСсылок);
	// Единственный ссылочный тип (семантика МетаданныеСсылочногоТипаЭлемента):
	// ровно один тип в описании И он резолвится в объект метаданных;
	// составной тип с одной ссылкой цели не даёт.
	Попытка
		ТипыЭлемента = Элемент.Тип.Типы();
		Если ТипыЭлемента.Количество() = 1 Тогда
			МетаданныеЕдинственного = Метаданные.НайтиПоТипу(ТипыЭлемента[0]);
			Если МетаданныеЕдинственного <> Неопределено Тогда
				Описание.ЦельЕдинственная = МетаданныеЕдинственного.ПолноеИмя();
			КонецЕсли;
		КонецЕсли;
	Исключение
	КонецПопытки;
	ЧастиПути = СтрРазделить(Строка(ПутьИсточника), ".", Ложь);
	Описание.СистемныйХвост = ЧастиПути.Количество() > 0
		И ВРег(ЧастиПути[ЧастиПути.Количество() - 1]) <> ВРег(Описание.Имя);
	Возврат Новый ФиксированнаяСтруктура(Описание);

