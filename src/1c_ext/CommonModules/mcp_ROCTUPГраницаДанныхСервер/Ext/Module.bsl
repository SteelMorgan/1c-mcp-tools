Процедура РедактироватьСекретыРекурсивно(Значение, ИмяПоля, Глубина)

	Если Глубина > 20 Тогда
		ВызватьИсключение "SECRET_SCAN_DEPTH_LIMIT";
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Структура")
		Или ТипЗнч(Значение) = Тип("Соответствие") Тогда
		Для Каждого Пара Из Значение Цикл
			Если ЭтоИмяСекрета(Пара.Ключ) Тогда
				Значение.Вставить(Пара.Ключ, "[SECRET_REMOVED]");
			ИначеЕсли ТипЗнч(Пара.Значение) = Тип("Строка") И СодержитСекретВТексте(Пара.Значение) Тогда
				Значение.Вставить(Пара.Ключ, "[SECRET_REMOVED]");
			Иначе
				РедактироватьСекретыРекурсивно(Пара.Значение, Пара.Ключ, Глубина + 1);
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Тогда
		Для Индекс = 0 По Значение.Количество() - 1 Цикл
			Элемент = Значение[Индекс];
			Если ТипЗнч(Элемент) = Тип("Строка") И СодержитСекретВТексте(Элемент) Тогда
				Значение[Индекс] = "[SECRET_REMOVED]";
			Иначе
				РедактироватьСекретыРекурсивно(Элемент, ИмяПоля, Глубина + 1);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

