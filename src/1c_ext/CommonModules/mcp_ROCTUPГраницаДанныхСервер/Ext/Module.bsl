// Объединение путей без повторов по канону резолвленного элемента:
// разные записи одного элемента схлопываются в канонический дубликат.
// Итог сортируется.
Функция LineageОбъединениеПутей(ПутиНовые)

	Каноны = Новый Соответствие;
	Итог = Новый Массив;
	Для Каждого Путь Из ПутиНовые Цикл
		Канон = LineageКанонПути(Путь);
		Если Каноны[Канон] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Каноны.Вставить(Канон, Итог.Количество());
		Итог.Добавить(Строка(Путь));
	КонецЦикла;
	Если Итог.Количество() > 1 Тогда
		СписокСортировки = Новый СписокЗначений;
		Для Каждого Путь Из Итог Цикл
			СписокСортировки.Добавить(Путь);
		КонецЦикла;
		СписокСортировки.СортироватьПоЗначению();
		Итог = СписокСортировки.ВыгрузитьЗначения();
	КонецЕсли;
	Возврат Итог;

