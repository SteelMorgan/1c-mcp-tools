	Части = СтрРазделить(ПолноеИмя, ".", Ложь);
	ВидовыеСегменты = ",РЕКВИЗИТ,СТАНДАРТНЫЙРЕКВИЗИТ,ИЗМЕРЕНИЕ,РЕСУРС,"
		+ "ТАБЛИЧНАЯЧАСТЬ,СТАНДАРТНАЯТАБЛИЧНАЯЧАСТЬ,РЕКВИЗИТАДРЕСАЦИИ,"
		+ "ПОЛЕ,ЗНАЧЕНИЕПЕРЕЧИСЛЕНИЯ,КОЛОНКА,";
	Итог = Новый Массив;
	Для Индекс = 0 По Части.Количество() - 1 Цикл
		Если Индекс >= 2 И Индекс % 2 = 0
			И Найти(ВидовыеСегменты, "," + ВРег(Части[Индекс]) + ",") > 0 Тогда
			Продолжить;
		КонецЕсли;
		Итог.Добавить(Части[Индекс]);
	КонецЦикла;
	Возврат СтрСоединить(Итог, ".");

КонецФункции

// Кэш одного вызова lineage-разбора: кандидаты операторов, токены
// выражений и записи колонок подчинённых запросов считаются один раз.
// Живёт в пределах вызова, наружу не выходит.
Функция LineageНовыйКэшВызова()

	Возврат Новый Структура(
		"Кандидаты, Упоминания, КолонкиЗапросов",
		Новый Соответствие, Новый Соответствие, Новый Соответствие);

КонецФункции

// Упоминания полей выражения с дедупликацией по тексту в рамках вызова.
Функция LineageУпоминанияВыражения(Текст, КэшВызова)

	Если КэшВызова = Неопределено Тогда
		Возврат ИзвлечьУпоминанияПолей(Текст);
	КонецЕсли;
	Упоминания = КэшВызова.Упоминания[Текст];
	Если Упоминания = Неопределено Тогда
		Упоминания = ИзвлечьУпоминанияПолей(Текст);
		КэшВызова.Упоминания.Вставить(Текст, Упоминания);
	КонецЕсли;
	Возврат Упоминания;

КонецФункции

// Кандидаты оператора с дедупликацией в рамках вызова: один оператор
// опрашивается всеми колонками объединения.
Функция LineageКандидатыОператораКэш(Оператор, КартаВТ, Глубина, КэшВызова)

	Если КэшВызова = Неопределено Тогда
		Возврат LineageКандидатыОператора(Оператор, КартаВТ, Глубина);
	КонецЕсли;
	КэшГлубин = КэшВызова.Кандидаты[Оператор];
	Если КэшГлубин <> Неопределено Тогда
		Готовые = КэшГлубин[Глубина];
		Если Готовые <> Неопределено Тогда
			Возврат Готовые;
		КонецЕсли;
	Иначе
		КэшГлубин = Новый Соответствие;
		КэшВызова.Кандидаты.Вставить(Оператор, КэшГлубин);
	КонецЕсли;
	Кандидаты = LineageКандидатыОператора(Оператор, КартаВТ, Глубина);
	КэшГлубин.Вставить(Глубина, Кандидаты);
	Возврат Кандидаты;

КонецФункции
