		ДобавитьИсточникВОбласть(Область, Соединение.Источник,
//**agent TASK-225 [27.09.2026 16:01:00]
//			ПараметрыЗапроса, Глубина + 1);
			ПараметрыЗапроса, Глубина + 1, КэшАнализа);
//**agent TASK-225
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьВыраженияКоллекции(Выражения, Коллекция)

	Попытка
		Для Каждого Элемент Из Коллекция Цикл
			ТипЭлемента = ТипЗнч(Элемент);
			Если ТипЭлемента = Тип("ВыражениеСхемыЗапроса")
				Или ТипЭлемента
					= Тип("ВыражениеОтбораКомпоновкиДанныхСхемыЗапроса") Тогда
				Выражения.Добавить(Элемент);
			КонецЕсли;
		КонецЦикла;
	Исключение
	КонецПопытки;

КонецПроцедуры

// В скан попадают только поля выборки, где поле-источник - операнд
// вычисления (функция, ВЫБОР, арифметика). Выражение, целиком сводящееся
// к пути поля ("apiKey", "Т.apiKey"), выводится как есть: секрет в такой
// колонке вырезается маскировкой [SECRET_REMOVED], отказ не нужен.
// Вложенная таблица в выборке - тот же полный скан рекурсивно.
//**agent TASK-225 [27.09.2026 16:01:00]
//	Пятый параметр - кэш анализа (этап Z).
//Процедура ДобавитьВыраженияВыборки(Выражения, Оператор, Область, ПараметрыЗапроса)
Процедура ДобавитьВыраженияВыборки(Выражения, Оператор, Область, ПараметрыЗапроса,
	КэшАнализа = Неопределено)
//**agent TASK-225

	Попытка
		Для Каждого ПолеВыборки Из Оператор.ВыбираемыеПоля Цикл
			ТипПоля = ТипЗнч(ПолеВыборки);
			Если ТипПоля = Тип("ВложеннаяТаблицаСхемыЗапроса") Тогда
				Попытка
					Если ЗапросСодержитСекретныйРеквизит(
//**agent TASK-225 [27.09.2026 16:01:00]
//						ПолеВыборки.Запрос, ПараметрыЗапроса) Тогда
						ПолеВыборки.Запрос, ПараметрыЗапроса, КэшАнализа) Тогда
//**agent TASK-225
						Область.ЕстьСекрет = Истина;
					КонецЕсли;
				Исключение
					// Структура вложенного запроса не читается - недоказано.
					Область.ЕстьСекрет = Истина;
				КонецПопытки;
			ИначеЕсли ТипПоля = Тип("ВыражениеСхемыЗапроса")
				И Не ЭтоГолоеПоле(Строка(ПолеВыборки)) Тогда
				Выражения.Добавить(ПолеВыборки);
			КонецЕсли;
		КонецЦикла;
	Исключение
		// Коллекция полей не итерируется - состав выборки недоказан.
		Область.ЕстьСекрет = Истина;
	КонецПопытки;

КонецПроцедуры

// Истина, когда текст выражения - только путь поля: идентификаторы через
// точку, без операторов, вызовов функций и литералов.
Функция ЭтоГолоеПоле(Текст)

	ТекстПоля = СокрЛП(Текст);
	Если ПустаяСтрока(ТекстПоля) Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого Сегмент Из СтрРазделить(ТекстПоля, ".", Ложь) Цикл
		Если Не ЭтоИдентификаторПоля(Сегмент) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

Функция ЭтоИдентификаторПоля(Текст)

	Если ПустаяСтрока(Текст)
		Или Не ЭтоБукваИлиПодчерк(Лев(Текст, 1)) Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Позиция = 2 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если Не ЭтоБукваИлиПодчерк(Символ) И Не ЭтоЦифра(Символ) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

//**agent TASK-225 [27.09.2026 21:00:00]
//// Восстановление источников голых полей: нативный анализатор не разворачивает
//// ВЫБРАТЬ * и удерживает sources у колонок с секретными именами, но голое поле
//// по СхемаЗапроса доказуемо является реквизитом источника. Возвращает массив
// Восстановление источников голых полей: у колонки может не быть sources
// (*, регистр псевдонима, недоказанный разбор), но голое поле по
// СхемаЗапроса доказуемо является реквизитом источника. Возвращает массив
//**agent TASK-225
// канонических путей Вид.Объект[.ТЧ].Реквизит (по одному на оператор
// объединения) или Неопределено, если происхождение не доказано.
// Восстановленный путь встаёт в sources колонки, поэтому дальше работают
// обычная проверка НайтиЭлементМетаданныхПоПути и маскировка секретов.
//**agent TASK-225 [27.09.2026 16:01:00]
//	Третий параметр - кэш анализа (этап Z).
//Функция ВосстановитьИсточникиГолыхПолей(ЗапросВыбора, ИндексКолонки)
Функция ВосстановитьИсточникиГолыхПолей(ЗапросВыбора, ИндексКолонки,
	КэшАнализа = Неопределено)
//**agent TASK-225

	КолонкаЗапроса = ЗапросВыбора.Колонки[ИндексКолонки];
	ПоляКолонки = КолонкаЗапроса.Поля;
	Если ПоляКолонки.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Пути = Новый Массив;
	Для ИндексПоля = 0 По ПоляКолонки.Количество() - 1 Цикл
		ПолеКолонки = ПоляКолонки[ИндексПоля];
		Если ПолеКолонки = Неопределено Тогда
			// Часть объединения не поставляет значение - там NULL.
			Продолжить;
		КонецЕсли;
		Если ТипЗнч(ПолеКолонки) <> Тип("ВыражениеСхемыЗапроса") Тогда
			Возврат Неопределено;
		КонецЕсли;
		ТекстПоля = СокрЛП(Строка(ПолеКолонки));
		Если Не ЭтоГолоеПоле(ТекстПоля) Тогда
			Возврат Неопределено;
		КонецЕсли;
		Если ИндексПоля >= ЗапросВыбора.Операторы.Количество() Тогда
			Возврат Неопределено;
		КонецЕсли;
		Путь = РезолвироватьПолеИсточника(
//**agent TASK-225 [27.09.2026 16:01:00]
//			ЗапросВыбора.Операторы[ИндексПоля], ТекстПоля, 0);
			ЗапросВыбора.Операторы[ИндексПоля], ТекстПоля, 0, КэшАнализа);
//**agent TASK-225
		Если Путь = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		Пути.Добавить(Путь);
	КонецЦикла;

	Если Пути.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Пути;

КонецФункции

// Резолв пути поля (Источник.Поле[.Поле...] или неквалифицированное поле)
// в канонический путь метаданных. Разыменование разрешено только по полям
// с единственным ссылочным типом - иначе цель недоказуема.
//**agent TASK-225 [27.09.2026 16:01:00]
//	Четвёртый параметр - кэш анализа (этап Z): кандидаты оператора делятся
//	между колонками одного вызова АнализЗапросаГраницы.
//Функция РезолвироватьПолеИсточника(ИсточникОператор, ТекстПоля, Глубина)
Функция РезолвироватьПолеИсточника(ИсточникОператор, ТекстПоля, Глубина,
	КэшАнализа = Неопределено)
//**agent TASK-225

	Если Глубина > 8 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Сегменты = СтрРазделить(ТекстПоля, ".", Ложь);
	Кандидаты = КандидатыИсточниковОператора(ИсточникОператор, КэшАнализа);

	// Первый сегмент - квалификатор источника (псевдоним/имя объекта/ВТ/ТЧ)
	// либо само поле: без псевдонима схема не квалифицирует поле именем
	// таблицы, поэтому Контрагент.Наименование начинается сразу с поля.
	НайденныеПути = Новый Массив;
	ПервыйПройден = Ложь;
	Если Сегменты.Количество() > 1 Тогда
		ИмяИсточника = ВРег(Сегменты[0]);
		Для Каждого Кандидат Из Кандидаты Цикл
			Если Кандидат.Псевдоним = ИмяИсточника
				Или Кандидат.ИмяОбъекта = ИмяИсточника
				Или Кандидат.ИмяПодчинённого = ИмяИсточника Тогда
				ПервыйПройден = Истина;
				ДобавитьРезолвСегментов(НайденныеПути, Кандидат, Сегменты, 1);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	// Квалификатор не распознан ни одним источником - путь начинается с поля.
	Если Не ПервыйПройден Тогда
		Для Каждого Кандидат Из Кандидаты Цикл
			ДобавитьРезолвСегментов(НайденныеПути, Кандидат, Сегменты, 0);
		КонецЦикла;
	КонецЕсли;

	// Ноль или неоднозначность - происхождение не доказано.
	Если НайденныеПути.Количество() <> 1 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат НайденныеПути[0];

КонецФункции

// Обход сегментов поля от метаданных источника; промежуточные сегменты
// проходят разыменование только по единственному ссылочному типу.
//++agent TASK-225 [27.09.2026 16:01:00]
// Контекст обходится каноническим путём, сегменты - дескрипторами
// сессионного кэша (этап Z): та же цепочка коллекций и разыменований
// без повторных вызовов metadata API. Дескриптор - это резолв
// НайтиЭлементМетаданныхПоПути целого пути: префикс-проверка канона
// отсекает его неявное разыменование, оставляя семантику
// НайтиВКоллекцияхМетаданных исходной версии; разыменование между
// сегментами - явно, только по единственному ссылочному типу.
Процедура ДобавитьРезолвСегментов(НайденныеПути, Кандидат, Сегменты, Начало)

	КонтекстПуть = Кандидат.ПутьКонтекста;
	ИндексПоследнего = Сегменты.Количество() - 1;
	Если Начало > ИндексПоследнего Или ПустаяСтрока(КонтекстПуть) Тогда
		Возврат;
	КонецЕсли;
	Описание = Неопределено;
	Для ИндексСегмента = Начало По ИндексПоследнего Цикл
		Описание = ОписаниеПутиКэш(
			КонтекстПуть + "." + Сегменты[ИндексСегмента]);
		Если Не Описание.Существует
			Или Описание.СистемныйХвост
			Или ВРег(Лев(Описание.Канон, СтрДлина(КонтекстПуть) + 1))
				<> ВРег(КонтекстПуть + ".") Тогда
			// Системное поле объекта живёт вне коллекций метаданных; голое
			// поле исполненного запроса доказывает, что оно существует.
			Если ИндексСегмента = ИндексПоследнего
				И ЭтоСистемноеПолеОбъекта(Сегменты[ИндексСегмента]) Тогда
				НайденныеПути.Добавить(
					КонтекстПуть + "." + Сегменты[ИндексСегмента]);
			КонецЕсли;
			Возврат;
		КонецЕсли;
		Если ИндексСегмента < ИндексПоследнего Тогда
			Если ПустаяСтрока(Описание.ЦельЕдинственная) Тогда
				Возврат;
			КонецЕсли;
			КонтекстПуть = Описание.ЦельЕдинственная;
		КонецЕсли;
	КонецЦикла;
	НайденныеПути.Добавить(КонтекстПуть + "." + Описание.Имя);
//++agent TASK-225
