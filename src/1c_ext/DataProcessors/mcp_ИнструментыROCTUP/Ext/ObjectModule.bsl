Функция ВычислитьРежимObjectRef(ТипОбъекта, ПравилаАнонимизации, АгрессивныйРежим)

	Если Найти(ТипОбъекта, "ПеречислениеСсылка.") = 1 Тогда Возврат "force_keep"; КонецЕсли;
	ПутьНаименования = ПолучитьПутьНаименованияПоТипуОбъекта(ТипОбъекта);
	Режим = "default";
	Если НЕ ПустаяСтрока(ПутьНаименования) Тогда
		Правило = ПравилаАнонимизации.Получить(ПутьНаименования);
		Если Правило <> Неопределено Тогда
			Режим = ?(Правило.action = "keep", "force_keep", "force_anonymize");
		КонецЕсли;
	КонецЕсли;
	// Планы счетов — force_keep если нет явного правила force_anonymize.
	// Проверка ДО агрессивного режима: aggressive mode не затрагивает планы счетов.
	Если Найти(ТипОбъекта, "ПланСчетовСсылка.") = 1 И Режим <> "force_anonymize" Тогда
		Возврат "force_keep";
	КонецЕсли;
	// Агрессивный режим: elevate default→force_anonymize для всех остальных типов
	Если Режим = "default" И АгрессивныйРежим Тогда
		Режим = "force_anonymize";
	КонецЕсли;
	Возврат Режим;

