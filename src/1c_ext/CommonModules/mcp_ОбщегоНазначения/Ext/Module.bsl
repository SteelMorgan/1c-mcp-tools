//++agent TASK-ADHOC-MCP-JSON-SAFE [28.06.2026 12:10:00]
Функция JSONБезопасноеЗначение(Значение)

	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ТипЗначения = ТипЗнч(Значение);
	//++agent TASK-201 [01.07.2026 00:00:00]
	// SQL NULL из результатов запроса должен уходить в JSON как null, а не как сырое 1С-значение.
	Если ТипЗначения = Тип("Null") Тогда
		Возврат Неопределено;
	КонецЕсли;
	//++agent TASK-201

	Если ТипЗначения = Тип("Строка")
		Или ТипЗначения = Тип("Число")
		Или ТипЗначения = Тип("Булево")
		Или ТипЗначения = Тип("Дата") Тогда
		Возврат Значение;
	КонецЕсли;

	Если ТипЗначения = Тип("Структура") Тогда
		Возврат JSONБезопаснаяСтруктура(Значение);
	КонецЕсли;

	Если ТипЗначения = Тип("Соответствие") Тогда
		Возврат JSONБезопасноеСоответствие(Значение);
	КонецЕсли;

	Если ТипЗначения = Тип("Массив") Тогда
		Возврат JSONБезопасныйМассив(Значение);
	КонецЕсли;

	ОписаниеСсылки = JSONОписаниеСсылки(Значение);
	Если ОписаниеСсылки <> Неопределено Тогда
		Возврат ОписаниеСсылки;
	КонецЕсли;

	Возврат JSONОписаниеПроизвольногоЗначения(Значение);

КонецФункции

Функция JSONБезопаснаяСтруктура(Значение)

	Результат = Новый Структура;
	Для Каждого Элемент Из Значение Цикл
		Результат.Вставить(НормализоватьКлюч(Строка(Элемент.Ключ)), JSONБезопасноеЗначение(Элемент.Значение));
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция JSONБезопасноеСоответствие(Значение)

	Результат = Новый Структура;
	Для Каждого Элемент Из Значение Цикл
		Результат.Вставить(НормализоватьКлюч(Строка(Элемент.Ключ)), JSONБезопасноеЗначение(Элемент.Значение));
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция JSONБезопасныйМассив(Значение)

	Результат = Новый Массив;
	Для Каждого Элемент Из Значение Цикл
		Результат.Добавить(JSONБезопасноеЗначение(Элемент));
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция JSONОписаниеСсылки(Значение)

	Попытка
		ТипОбъекта = JSONСтроковоеПредставлениеТипаСсылки(ТипЗнч(Значение));
		УникальныйИдентификатор = XMLСтрока(Значение);
		Представление = Строка(Значение);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Описание = Новый Структура;
	Описание.Вставить("_objectRef", Истина);
	Описание.Вставить("УникальныйИдентификатор", Строка(УникальныйИдентификатор));
	Описание.Вставить("ТипОбъекта", ТипОбъекта);
	Описание.Вставить("Представление", Представление);
	Возврат Описание;

КонецФункции

Функция JSONСтроковоеПредставлениеТипаСсылки(ТипЗначения)

	Если Не JSONЭтоСсылочныйТип(ТипЗначения) Тогда
		ВызватьИсключение НСтр("ru = 'Значение не является ссылкой информационной базы.'");
	КонецЕсли;

	ПолноеИмя = Метаданные.НайтиПоТипу(ТипЗначения).ПолноеИмя();
	ИмяОбъекта = СтрРазделить(ПолноеИмя, ".")[1];

	Если Справочники.ТипВсеСсылки().СодержитТип(ТипЗначения) Тогда
		Возврат "СправочникСсылка." + ИмяОбъекта;
	ИначеЕсли Документы.ТипВсеСсылки().СодержитТип(ТипЗначения) Тогда
		Возврат "ДокументСсылка." + ИмяОбъекта;
	ИначеЕсли БизнесПроцессы.ТипВсеСсылки().СодержитТип(ТипЗначения) Тогда
		Возврат "БизнесПроцессСсылка." + ИмяОбъекта;
	ИначеЕсли БизнесПроцессы.ТипВсеСсылкиТочекМаршрутаБизнесПроцессов().СодержитТип(ТипЗначения) Тогда
		Возврат "ТочкаМаршрутаБизнесПроцессаСсылка." + ИмяОбъекта;
	ИначеЕсли ПланыВидовХарактеристик.ТипВсеСсылки().СодержитТип(ТипЗначения) Тогда
		Возврат "ПланВидовХарактеристикСсылка." + ИмяОбъекта;
	ИначеЕсли ПланыСчетов.ТипВсеСсылки().СодержитТип(ТипЗначения) Тогда
		Возврат "ПланСчетовСсылка." + ИмяОбъекта;
	ИначеЕсли ПланыВидовРасчета.ТипВсеСсылки().СодержитТип(ТипЗначения) Тогда
		Возврат "ПланВидовРасчетаСсылка." + ИмяОбъекта;
	ИначеЕсли Задачи.ТипВсеСсылки().СодержитТип(ТипЗначения) Тогда
		Возврат "ЗадачаСсылка." + ИмяОбъекта;
	ИначеЕсли ПланыОбмена.ТипВсеСсылки().СодержитТип(ТипЗначения) Тогда
		Возврат "ПланОбменаСсылка." + ИмяОбъекта;
	ИначеЕсли Перечисления.ТипВсеСсылки().СодержитТип(ТипЗначения) Тогда
		Возврат "ПеречислениеСсылка." + ИмяОбъекта;
	КонецЕсли;

	ВызватьИсключение НСтр("ru = 'Не удалось определить вид ссылочного типа.'");

КонецФункции

Функция JSONЭтоСсылочныйТип(ТипЗначения)

	Возврат Справочники.ТипВсеСсылки().СодержитТип(ТипЗначения)
		Или Документы.ТипВсеСсылки().СодержитТип(ТипЗначения)
		Или БизнесПроцессы.ТипВсеСсылки().СодержитТип(ТипЗначения)
		Или БизнесПроцессы.ТипВсеСсылкиТочекМаршрутаБизнесПроцессов().СодержитТип(ТипЗначения)
		Или ПланыВидовХарактеристик.ТипВсеСсылки().СодержитТип(ТипЗначения)
		Или ПланыСчетов.ТипВсеСсылки().СодержитТип(ТипЗначения)
		Или ПланыВидовРасчета.ТипВсеСсылки().СодержитТип(ТипЗначения)
		Или Задачи.ТипВсеСсылки().СодержитТип(ТипЗначения)
		Или ПланыОбмена.ТипВсеСсылки().СодержитТип(ТипЗначения)
		Или Перечисления.ТипВсеСсылки().СодержитТип(ТипЗначения);

КонецФункции

