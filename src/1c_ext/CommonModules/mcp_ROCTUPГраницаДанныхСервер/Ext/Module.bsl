Функция ЗначениеКонтекста(Контекст, Имя, ПоУмолчанию)
	Возврат Свойство(Контекст, Имя, ПоУмолчанию);
КонецФункции

Функция Свойство(Значение, Имя, ПоУмолчанию)
	Если ТипЗнч(Значение) = Тип("Структура") Тогда
		Результат = Неопределено;
		Если Значение.Свойство(Имя, Результат) Тогда
			Возврат Результат;
		КонецЕсли;
	ИначеЕсли ТипЗнч(Значение) = Тип("Соответствие") Тогда
		Результат = Значение.Получить(Имя);
		Если Результат <> Неопределено Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	Возврат ПоУмолчанию;
КонецФункции

Функция ЗаписатьJSONСтрокой(Значение)
