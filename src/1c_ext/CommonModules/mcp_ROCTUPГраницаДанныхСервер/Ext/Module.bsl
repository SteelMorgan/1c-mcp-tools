				LineageРезолвВИсточнике(
//**agent TASK-225 [27.09.2026 16:01:00]
//					Найденные, Кандидат, Сегменты, 1, КартаВТ, Глубина);
					Найденные, Кандидат, Сегменты, 1, КартаВТ, Глубина,
					КэшВызова);
//**agent TASK-225
			КонецЕсли;
