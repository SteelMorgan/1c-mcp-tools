Функция НайтиПозициюПоследнейТочки(СтрокаПути)

	ПозицияТочки = 0;
	ПозицияПоиска = 1;
	Пока Истина Цикл
		СледующаяПозиция = Найти(Сред(СтрокаПути, ПозицияПоиска), ".");
		Если СледующаяПозиция = 0 Тогда
			Прервать;
		КонецЕсли;
		СледующаяПозиция = ПозицияПоиска + СледующаяПозиция - 1;
		ПозицияТочки = СледующаяПозиция;
		ПозицияПоиска = СледующаяПозиция + 1;
	КонецЦикла;

	Возврат ПозицияТочки;

КонецФункции

