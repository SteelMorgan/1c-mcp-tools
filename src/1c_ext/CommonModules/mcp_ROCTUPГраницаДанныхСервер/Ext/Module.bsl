Процедура ПрименитьСекретностьИсточникаКРезультатуЗапроса(Результат, Схема)

	Данные = Свойство(Результат, "data", Неопределено);
	Колонки = Свойство(Схема, "columns", Неопределено);
	Если ТипЗнч(Данные) <> Тип("Массив") Или ТипЗнч(Колонки) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Колонка Из Колонки Цикл
		Если Не КолонкаСодержитСекрет(Колонка) Тогда
			Продолжить;
		КонецЕсли;
		ИмяКолонки = Свойство(Колонка, "name", "");
		Если ПустаяСтрока(ИмяКолонки) Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого СтрокаДанных Из Данные Цикл
			Если ТипЗнч(СтрокаДанных) = Тип("Структура")
				Или ТипЗнч(СтрокаДанных) = Тип("Соответствие") Тогда
				ИсходноеЗначение = Неопределено;
				Если СтрокаДанных.Свойство(ИмяКолонки, ИсходноеЗначение) Тогда
					СтрокаДанных.Вставить(ИмяКолонки, "[SECRET_REMOVED]");
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Процедура ПрименитьРежимПароляКОбъекту(Результат)

	Данные = Свойство(Результат, "data", Неопределено);
	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;

	ПолноеИмяОбъекта = Свойство(Данные, "_type", "");
	Если ПустаяСтрока(ПолноеИмяОбъекта) Тогда
		Возврат;
	КонецЕсли;

	ОбъектМетаданных = Неопределено;
	Попытка
		ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ПолноеИмяОбъекта);
	Исключение
		Возврат;
	КонецПопытки;
	Если ОбъектМетаданных = Неопределено Тогда
		Возврат;
