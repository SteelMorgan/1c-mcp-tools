Функция JSONЗначениеВСтруктуру(Значение)
	Если ТипЗнч(Значение) = Тип("Соответствие") Тогда
		Результат = Новый Структура;
		Для Каждого Пара Из Значение Цикл
			Результат.Вставить(Пара.Ключ, JSONЗначениеВСтруктуру(Пара.Значение));
		КонецЦикла;
		Возврат Результат;
	ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Результат.Добавить(JSONЗначениеВСтруктуру(Элемент));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;
	Возврат Значение;
КонецФункции

Функция СодержитВнутреннееИмя(Значение, Глубина)
	Если Глубина > 10 Тогда Возврат Ложь; КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		СтрокаПоиска = НРег(Значение);
		Для Каждого Имя Из СтрРазделить(
			"биг_маппингимаскированияmcp,биг_очередьдеанонимизацииmcp,mcp_roctupмаскирование,биг_раскрытиемаскированияmcp", ",") Цикл
			Если Найти(СтрокаПоиска, Имя) > 0 Тогда Возврат Истина; КонецЕсли;
		КонецЦикла;
	ИначеЕсли ТипЗнч(Значение) = Тип("Структура")
		Или ТипЗнч(Значение) = Тип("Соответствие")
		Или ТипЗнч(Значение) = Тип("Массив") Тогда
		Для Каждого Элемент Из Значение Цикл
			Если ТипЗнч(Элемент) = Тип("КлючИЗначение") Тогда
				Если СодержитВнутреннееИмя(Элемент.Ключ, Глубина + 1)
					Или СодержитВнутреннееИмя(Элемент.Значение, Глубина + 1) Тогда Возврат Истина; КонецЕсли;
			ИначеЕсли СодержитВнутреннееИмя(Элемент, Глубина + 1) Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Ложь;
КонецФункции
